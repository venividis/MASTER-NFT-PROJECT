{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awe.local/schemas/cartridge-manifest-v1.json",
  "title": "AWE Cartridge Manifest v1",
  "description": "Runtime identity and requested capabilities. This document does not itself authorize calls or verify game results.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "version", "runtime", "entrypoint", "contentHash", "contentHashAlgorithm", "compatibleChains", "gameAdapter", "rulesVersion", "requestedCapabilities", "settlement", "itemSchemas"],
  "properties": {
    "schemaVersion": { "const": "awe.cartridge/1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "cartridge": { "$ref": "#/definitions/assetRef" },
    "runtime": { "enum": ["web", "wasm", "native-client"] },
    "entrypoint": {
      "type": "string", "minLength": 1, "maxLength": 2048,
      "description": "Relative package entry or absolute resource URI. Loader must resolve and enforce its own origin and content-integrity policy."
    },
    "contentHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "contentHashAlgorithm": { "const": "sha256" },
    "engine": { "type": "string", "maxLength": 128 },
    "compatibleChains": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/definitions/chain" } },
    "gameAdapter": { "type": "string", "minLength": 1, "maxLength": 256 },
    "rulesVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requestedCapabilities": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["method", "reason"],
        "properties": {
          "method": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{0,127}$" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
          "target": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "settlement": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {
        "mode": { "enum": ["local", "server-attested", "onchain-transitions", "proof-verified"] },
        "chain": { "$ref": "#/definitions/chain" },
        "authority": { "type": "string", "minLength": 1, "maxLength": 256 },
        "verifier": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "server-attested" } } }, "then": { "required": ["authority"] } },
        { "if": { "properties": { "mode": { "const": "onchain-transitions" } } }, "then": { "required": ["chain", "authority"] } },
        { "if": { "properties": { "mode": { "const": "proof-verified" } } }, "then": { "required": ["chain", "verifier"] } }
      ]
    },
    "itemSchemas": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
  },
  "definitions": {
    "chain": { "type": "string", "pattern": "^[a-z0-9-]+:[A-Za-z0-9_.-]+$", "maxLength": 128 },
    "assetRef": {
      "type": "object", "additionalProperties": false,
      "required": ["chain", "standard", "collection", "id"],
      "properties": {
        "chain": { "$ref": "#/definitions/chain" },
        "standard": { "enum": ["erc721", "erc1155", "metaplex-core", "bubblegum-v2", "sui-object", "starknet-erc721"] },
        "collection": { "type": "string", "minLength": 1, "maxLength": 256 },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
