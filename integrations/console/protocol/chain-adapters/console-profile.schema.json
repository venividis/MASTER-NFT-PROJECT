{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awe.local/schemas/console-profile-v1.json",
  "title": "AWE deployed Console v1 manifest profile",
  "description": "A supported subset of Console v1. Optional contentHash is checked more strictly than the current app validator. World connectivity requires validateConsoleWorld in addition to this schema.",
  "type": "object",
  "required": ["spec", "name", "version", "engine", "entry", "capabilities", "settlement"],
  "properties": {
    "spec": { "const": "awe.cartridge/1" },
    "name": { "type": "string", "maxLength": 80, "pattern": "\\S" },
    "version": { "type": "string", "maxLength": 32 },
    "engine": { "type": "string", "maxLength": 40 },
    "entry": { "type": "string", "maxLength": 2048, "pattern": "^(awe:prism-relay$|/api/console/files/[a-f0-9-]{36}$|/api/console/content/[a-f0-9]{64}$|https://)" },
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "capabilities": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 60 } },
    "settlement": { "enum": ["server", "onchain", "local"] },
    "world": {
      "type": "object", "required": ["name", "terrain"],
      "properties": {
        "name": { "type": "string", "maxLength": 80, "pattern": "\\S" },
        "terrain": { "type": "array", "minItems": 81, "maxItems": 81, "items": { "enum": ["plain", "wall", "prism"] } }
      }
    }
  }
}
