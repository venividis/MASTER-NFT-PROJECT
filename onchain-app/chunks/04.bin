const INTENT_FIELDS=['target','value','dataHash','nonce','validAfter','validUntil','priorStateRoot','nextStateRoot','nextMemoryRoot','policyHash','evidenceHash','verifierId'];
const intentValues=i=>INTENT_FIELDS.map(k=>i[k]);
const VERIFIED_SIG='executeVerified((address,uint256,bytes32,uint256,uint48,uint48,bytes32,bytes32,bytes32,bytes32,bytes32,uint32),bytes,bytes)';
function encodeVerified(intent,data,proof){if(keccak256(bytesOf(data))!==intent.dataHash.toLowerCase())throw Error('Intent does not bind this calldata.');return callData(VERIFIED_SIG,[INTENT_TYPES,'bytes','bytes'],[intentValues(intent),data,proof]);}
class TestnetClient {
 constructor(provider,onChange=()=>{}){if(!provider?.request)throw Error('No injected Ethereum wallet found. Open in a wallet-enabled browser.');this.provider=provider;this.onChange=onChange;this.revision=0;this.pending=false;this.connected=false;this.handle=()=>{this.revision++;this.connected=false;this.onChange('Wallet account or network changed. Reconnect before continuing.');};provider.on?.('accountsChanged',this.handle);provider.on?.('chainChanged',this.handle);provider.on?.('disconnect',this.handle);}
 async connect(collection,requestAccounts=true){this.collection=address(collection);const rev=this.revision;this.chainId=Number(BigInt(await this.provider.request({method:'eth_chainId'})));if(!TEST_CHAINS.has(this.chainId))throw Error('Mainnet and unknown chains are blocked. Select Sepolia, Base Sepolia, or local chain 31337.');const accounts=await this.provider.request({method:requestAccounts?'eth_requestAccounts':'eth_accounts'});if(!accounts?.length)throw Error('Wallet did not provide an account.');this.owner=address(accounts[0]);const code=await this.provider.request({method:'eth_getCode',params:[this.collection,'latest']});if(!code||code==='0x')throw Error('No collection contract exists at that address on this chain.');if(rev!==this.revision)throw Error('Wallet changed while connecting.');this.connected=true;return this;}
 async assertContext(){if(!this.connected)throw Error('Reconnect the wallet.');const [chain,accounts]=await Promise.all([this.provider.request({method:'eth_chainId'}),this.provider.request({method:'eth_accounts'})]);if(Number(BigInt(chain))!==this.chainId||!accounts?.length||address(accounts[0])!==this.owner){this.handle();throw Error('Wallet context ch