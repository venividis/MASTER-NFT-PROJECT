","referenceHTML":"\u003c!doctype html>\n\u003chtml lang=\"en\">\n\u003chead>\n  \u003cmeta charset=\"utf-8\" />\n  \u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\" />\n  \u003cmeta name=\"theme-color\" content=\"#05050a\" />\n  \u003cmeta name=\"description\" content=\"i dont fucking believe it! — a proof-carrying autonomous NFT organism.\" />\n  \u003ctitle>i dont fucking believe it!\u003c/title>\n  \u003cstyle>\n:root {\n  color-scheme: dark;\n  --bg: #05050a;\n  --ink: #f4f4ff;\n  --muted: rgba(235, 235, 255, .54);\n  --line: rgba(226, 226, 255, .14);\n  --glass: rgba(8, 8, 16, .54);\n  --hot: #d6ff52;\n  --violet: #a88bff;\n  --cyan: #72f7ff;\n  --danger: #ff547d;\n  --safe-bottom: env(safe-area-inset-bottom, 0px);\n}\n\n* { box-sizing: border-box; }\nhtml, body { width: 100%; min-height: 100%; margin: 0; background: var(--bg); color: var(--ink); }\nbody { overflow: hidden; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; letter-spacing: .02em; }\nbutton { color: inherit; font: inherit; }\nbutton:focus-visible { outline: 2px solid var(--hot); outline-offset: 3px; }\n\n#organism { position: fixed; inset: 0; width: 100%; height: 100%; display: block; background: radial-gradient(circle, #111129, #05050a 56%); }\n.grain, .scanline { position: fixed; inset: 0; pointer-events: none; z-index: 1; }\n.grain { opacity: .18; background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.28'/%3E%3C/svg%3E\"); mix-blend-mode: soft-light; }\n.scanline { opacity: .09; background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(255,255,255,.13) 4px); }\n.glass { background: var(--glass); border: 1px solid var(--line); backdrop-filter: blur(18px) saturate(125%); box-shadow: 0 20px 70px rgba(0,0,0,.24); }\n\n.topbar { position: fixed; z-index: 10; top: 18px; left: 18px; right: 18px; min-height: 72px; padding: 12px 15px; display: flex; align-items: center; justify-content: space-between; border-radius: 16px; }\n.brand { display: flex; align-items: center; gap: 13px; min-width: 0; }\n.sigil { width: 44px; height: 44px; display: grid; place-items: center; flex: 0 0 auto; border: 1px solid rgba(255,255,255,.3); border-radius: 50%; font: 700 25px/1 ui-monospace, monospace; box-shadow: inset 0 0 20px rgba(168,139,255,.2), 0 0 28px rgba(114,247,255,.12); }\nh1 { margin: 0; font-size: clamp(15px, 1.45vw, 23px); line-height: 1.1; font-weight: 720; letter-spacing: -.02em; }\n.brand p { margin: 6px 0 0; color: var(--muted); font: 10px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .15em; }\n.top-actions { display: flex; align-items: center; gap: 13px; }\n.status { display: flex; align-items: center; gap: 8px; color: rgba(242,242,255,.72); font: 10px ui-monospace, monospace; letter-spacing: .12em; }\n.pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--hot); box-shadow: 0 0 14px var(--hot); animation: pulse 1.7s ease-in-out infinite; }\n.quiet, .micro { border: 1px solid var(--line); background: rgba(255,255,255,.035); border-radius: 9px; padding: 10px 13px; cursor: pointer; font: 10px ui-monospace, monospace; letter-spacing: .08em; }\n.quiet:hover, .micro:hover { background: rgba(255,255,255,.09); border-color: rgba(255,255,255,.28); }\n\nmain { position: fixed; z-index: 5; inset: 106px 18px 116px; pointer-events: none; }\n.panel { position: absolute; top: 0; width: min(318px, 24vw); max-height: calc(100vh - 240px); overflow: auto; border-radius: 15px; padding: 15px; pointer-events: auto; scrollbar-width: thin; }\n.identity { left: 0; }\n.proof { right: 0; }\n.panel-title { display: flex; align-items: center; gap: 9px; padding-bottom: 12px; border-bottom: 1px solid var(--line); font: 10px ui-monospace, monospace; letter-spacing: .16em; color: rgba(255,255,255,.84); }\n.panel-title span { color: var(--hot); }\n.mode-row { display: flex; align-items: center; justify-content: space-between; margin: 13px 0; color: var(--muted); font: 9px ui-monospace, monospace; letter-spacing: .12em; }\n.mode-row strong { padding: 5px 8px; color: var(--hot); border: 1px solid rgba(214,255,82,.26); border-radius: 999px; background: rgba(214,255,82,.07); font-size: 9px; }\n.mode-row strong[data-mode=\"sovereign\"] { color: var(--danger); border-color: rgba(255,84,125,.4); background: rgba(255,84,125,.08); }\n.telemetry { margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }\n.telemetry div { padding: 10px; background: rgba(255,255,255,.025); }\n.telemetry div:first-child { grid-column: span 2; }\ndt { color: var(--muted); font: 8px ui-monospace, monospace; letter-spacing: .12em; }\ndd { margin: 5px 0 0; font: 16px ui-monospace, monospace; }\n.root-list { display: grid; gap: 6px; margin: 12px 0; }\n.root { width: 100%; display: grid; grid-template-columns: 88px 1fr; gap: 6px; text-align: left; border: 0; border-bottom: 1px solid rgba(255,255,255,.08); background: transparent; padding: 7px 2px; cursor: copy; }\n.root span, .account-block span { color: var(--muted); font: 8px ui-monospace, monospace; letter-spacing: .1em; }\n.root code, .account-block code { min-width: 0; overflow: hidden; text-overflow: ellipsis; color: rgba(255,255,255,.84); font: 9px ui-monospace, monospace; white-space: nowrap; }\n.account-block { padding: 11px; display: grid; gap: 7px; border-radius: 9px; background: rgba(168,139,255,.07); border: 1px solid rgba(168,139,255,.18); }\n\n.core-label { position: absolute; left: 50%; top: 50%; width: min(510px, 42vw); aspect-ratio: 1; transform: translate(-50%,-50%); border: 1px solid rgba(255,255,255,.07); border-radius: 50%; pointer-events: none; }\n.core-label::before, .core-label::after { content: \"\"; position: absolute; inset: 10%; border: 1px dashed rgba(255,255,255,.08); border-radius: 50%; animation: orbit 38s linear infinite; }\n.core-label::after { inset: 22%; animation-direction: reverse; animation-duration: 24s; }\n.coordinate { position: absolute; top: -29px; left: 50%; transform: translateX(-50%); white-space: nowrap; color: var(--muted); font: 8px ui-monospace, monospace; letter-spacing: .12em; }\n.designation { position: absolute; bottom: -33px; left: 50%; transform: translateX(-50%); white-space: nowrap; color: rgba(255,255,255,.68); font: 9px ui-monospace, monospace; letter-spacing: .13em; }\n.orbit-label { position: absolute; color: rgba(255,255,255,.36); font: 7px ui-monospace, monospace; letter-spacing: .12em; }\n.orbit-a { left: -23px; top: 27%; transform: rotate(-72deg); }\n.orbit-b { right: -38px; top: 34%; transform: rotate(70deg); }\n.orbit-c { left: 50%; bottom: 7%; transform: translateX(-50%); }\n\n.proof-rail { display: grid; gap: 4px; margin: 13px 0 16px; }\n.proof-node { display: grid; grid-template-columns: 18px 1fr auto; align-items: center; gap: 8px; padding: 8px 7px; border: 1px solid rgba(255,255,255,.07); border-radius: 8px; }\n.proof-node i { width: 8px; height: 8px; justify-self: center; border-radius: 50%; border: 1px solid rgba(255,255,255,.28); }\n.proof-node.active i { background: var(--hot); border-color: var(--hot); box-shadow: 0 0 12px rgba(214,255,82,.65); }\n.proof-node strong, .proof-node small { display: block; font-family: ui-monospace, monospace; }\n.proof-node strong { font-size: 8px; letter-spacing: .08em; }\n.proof-node small { margin-top: 3px; color: var(--muted); font-size: 7px; }\n.proof-node b { color: var(--muted); font: 8px ui-monospace, monospace; }\n.section-label { margin-bottom: 7px; color: var(--muted); font: 7px ui-monospace, monospace; letter-spacing: .1em; }\n.law { display: grid; grid-template-columns: 21px 1fr auto; align-items: center; gap: 6px; padding: 8px 0; border-top: 1px solid rgba(255,255,255,.07); }\n.law span { color: var(--violet); font: 8px ui-monospace, monospace; }\n.law p { margin: 0; font: 8px ui-monospace, monospace; }\n.law em { color: var(--hot); font: normal 7px ui-monospace, monospace; }\n.agent-state { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 8px; margin-top: 13px; padding-top: 13px; border-top: 1px solid var(--line); }\n.agent-state > span { color: var(--muted); font: 8px ui-monospace, monospace; }\n.agent-state output { grid-column: span 2; color: rgba(255,255,255,.62); font: 8px ui-monospace, monospace; }\n.micro { padding: 7px 8px; font-size: 8px; }\n\n.event-console { position: absolute; left: 50%; bottom: 0; width: min(580px, 46vw); height: 112px; transform: translateX(-50%); border-radius: 12px; padding: 10px 12px; pointer-events: auto; overflow: hidden; }\n.console-head { display: flex; justify-content: space-between; padding-bottom: 7px; border-bottom: 1px solid var(--line); color: var(--muted); font: 7px ui-monospace, monospace; letter-spacing: .12em; }\n.console-head button { border: 0; color: var(--muted); background: transparent; cursor: pointer; font: inherit; }\n.events { height: 78px; padding-top: 5px; overflow: auto; scrollbar-width: none; }\n.event { display: grid; grid-template-columns: 54px 73px 1fr; gap: 6px; padding: 3px 0; font: 8px ui-monospace, monospace; }\n.event time { color: var(--muted); }\n.event b { color: var(--hot); font-weight: 500; }\n.event span { color: rgba(255,255,255,.68); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.event.proof b { color: var(--cyan); }\n.event.warning b { color: var(--danger); }\n\n.command { position: fixed; z-index: 10; left: 18px; right: 18px; bottom: calc(18px + var(--safe-bottom)); min-height: 80px; display: grid; grid-template-columns: 82px repeat(4, 1fr); gap: 8px; padding: 9px; border-radius: 16px; }\n.command-meta { display: grid; place-content: center; text-align: center; border-right: 1px solid var(--line); }\n.command-meta span { color: var(--muted); font: 7px ui-monospace, monospace; letter-spacing: .1em; }\n.command-meta strong { margin-top: 4px; font: 23px ui-monospace, monospace; }\n.command-button { position: relative; overflow: hidden; display: grid; place-content: center; gap: 4px; min-height: 60px; border: 1px solid var(--line); border-radius: 11px; background: rgba(255,255,255,.035); cursor: pointer; transition: transform .16s, border-color .16s, background .16s; }\n.command-button::before { content: \"\"; position: absolute; inset: 0; opacity: 0; background: radial-gradient(circle at var(--x,50%) var(--y,50%), rgba(255,255,255,.17), transparent 45%); transition: opacity .2s; }\n.command-button:hover { transform: translateY(-2px); border-color: rgba(255,255,255,.3); background: rgba(255,255,255,.07); }\n.command-button:hover::before { opacity: 1; }\n.command-button span { z-index: 1; font: 10px ui-monospace, monospace; letter-spacing: .09em; }\n.command-button small { z-index: 1; color: var(--muted); font: 7px ui-monospace, monospace; letter-spacing: .05em; }\n.command-button.primary { border-color: rgba(114,247,255,.3); background: rgba(114,247,255,.07); }\n.command-button.danger { border-color: rgba(255,84,125,.31); background: rgba(255,84,125,.06); }\n.command-button:disabled { cursor: not-allowed; opacity: .33; transform: none; }\n.command-button.busy { animation: busy 1.1s ease-in-out infinite; }\n\n#ascension-dialog { width: min(560px, calc(100vw - 32px)); padding: 0; border: 0; background: transparent; color: inherit; }\n#ascension-dialog::backdrop { background: rgba(0,0,0,.78); backdrop-filter: blur(11px); }\n.dialog-body { padding: 28px; border-radius: 18px; text-align: center; }\n.dialog-sigil { width: 72px; height: 72px; margin: 0 auto 17px; display: grid; place-items: center; border: 1px solid rgba(255,84,125,.5); border-radius: 50%; color: var(--danger); font-size: 35px; box-shadow: 0 0 42px rgba(255,84,125,.15); }\n.dialog-body h2 { margin: 0; font-size: 28px; letter-spacing: -.03em; }\n.dialog-body p { max-width: 430px; margin: 13px auto 20px; color: var(--muted); font-size: 13px; line-height: 1.7; }\n.dialog-hash { display: grid; gap: 7px; padding: 13px; text-align: left; border: 1px solid var(--line); border-radius: 10px; }\n.dialog-hash span { color: var(--muted); font: 8px ui-monospace, monospace; }\n.dialog-hash code { overflow: hidden; text-overflow: ellipsis; font: 9px ui-monospace, monospace; }\n.dialog-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }\n.danger-solid { border: 1px solid var(--danger); border-radius: 9px; background: var(--danger); color: #13050a; cursor: pointer; font: 10px ui-monospace, monospace; letter-spacing: .07em; }\n#toast { position: fixed; z-index: 30; left: 50%; top: 105px; transform: translate(-50%,-20px); padding: 10px 15px; border: 1px solid var(--line); border-radius: 999px; background: rgba(5,5,10,.9); opacity: 0; pointer-events: none; transition: .25s; font: 9px ui-monospace, monospace; }\n#toast.show { transform: translate(-50%,0); opacity: 1; }\n\nbody.sovereign { --hot: #ff668c; }\nbody.sovereign .sigil { border-color: rgba(255,84,125,.46); box-shadow: inset 0 0 28px rgba(255,84,125,.23), 0 0 35px rgba(255,84,125,.14); }\n\n@