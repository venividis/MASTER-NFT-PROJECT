in procedural audio; no microphone, recordings, or remote media. */
class OrganismAudio {
  constructor(){this.enabled=false;this.volume=.035;this.nodes=[];this.context=null;}
  async enable(state){
    const Audio=globalThis.AudioContext||globalThis.webkitAudioContext;
    if(!Audio)throw new Error('Web Audio is unavailable in this browser.');
    if(!this.context){
      this.context=new Audio();const c=this.context;
      this.master=c.createGain();this.master.gain.value=0;
      this.limiter=c.createDynamicsCompressor();this.limiter.threshold.value=-18;this.limiter.ratio.value=12;
      this.master.connect(this.limiter);this.limiter.connect(c.destination);
      [1,1.5,2].forEach((ratio,i)=>{
        const osc=c.createOscillator(),gain=c.createGain(),pan=c.createStereoPanner();
        osc.type=i===1?'triangle':'sine';gain.gain.value=[.45,.12,.13][i];pan.pan.value=[-.35,.4,0][i];
        osc.connect(gain);gain.connect(pan);pan.connect(this.master);osc.start();this.nodes.push({osc,gain,ratio});
      });
    }
    await this.context.resume();this.enabled=true;this.tune(state);this.master.gain.setTargetAtTime(this.volume,this.context.currentTime,.35);
  }
  async disable(){if(!this.context)return;this.enabled=false;this.master.gain.setTargetAtTime(0,this.context.currentTime,.06);}
  setVolume(value){this.volume=Math.max(0,Math.min(.09,value));if(this.enabled)this.master.gain.setTargetAtTime(this.volume,this.context.currentTime,.05);}
  tune(state){if(!this.context)return;const {pitch}=phenotype(state),c=this.context;this.nodes.forEach((n,i)=>{n.osc.frequency.setTargetAtTime(pitch*n.ratio*(state.sovereign?.5:1),c.currentTime,.8);n.osc.detune.setTargetAtTime(i===1?4:0,c.currentTime,.5);});}
  note(state,kind='SELECT'){
    if(!this.enabled||this.context.state!=='running')return;
    const c=this.context,pitch=phenotype(state).pitch;
    const intervals={EVOLVE:[0,7,12,15],SPAWN:[0,12,19],SEAL_MEMORY:[12,7,3],ASCEND:[0,3,7,-12],ENTROPY:[0,5],SELECT:[12]};
    (intervals[kind]||intervals.SELECT).forEach((step,i)=>{
      const o=c.createOscillator(),g=c.createGain(),pan=c.createStereoPanner(),t=c.currentTime+i*.15;
      o.type='sine';o.frequency.value=pitch*2**(step/12);g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(.5,t+.015);g.gain.exponentialRampToValueAtTime(.0001,t+1.45);
      pan.pan.value=(i%2?1:-1)*.4;o.connect(g);g.connect(pan);pan.connect(this.master);o.start(t);o.stop(t+1.5);
      o.onended=()=>{o.disconnect();g.disconnect();pan.disconnect();};
    });
  }
  async visibility(hidden){if(!this.context||!this.enabled)return;if(hidden)await this.context.suspend();else await this.context.resume();}
}






const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const STORE='idfbi.optical.1.2',audio=new OrganismAudio();
const eventNumber={EVOLVE:1,SEAL_MEMORY:2,SPAWN:3,ASCEND:4,ENTROPY:5};
let world,renderer,selected=0,childView=null,busy=false,client=null,chainState=null,review=null,importCandidate=null,proofRequest=null,canPersist=true,persistedAudit=null,events=[];
let mintSecret=null;
const displayState=()=>chainState||childView||world.snapshots[selected];
const present=()=>!!chainState||(!childView&&selected===world.snapshots.length-1);
function toast(message){$('#toast').textContent=message;$('#toast').classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>$('#toast').classList.remove('show'),5500);}
function log(kind,message){const entry={time:new Date().toLocaleTimeString('en-GB'),kind,message};events.push(entry);events=events.slice(-100);const e=document.createElement('div');e.className='event '+(kind==='REJECTED'?'warning':'');const t=document.createElement('time'),b=document.createElement('b'),s=document.createElement('span');t.textContent=entry.time;b.textContent=kind;s.textContent=message;e.append(t,b,s);$('#events').prepend(e);while($('#events').children.length>16)$('#events').lastElementChild.remove();}
function detail(kicker,title){$('#detail-kicker').textContent=kicker;$('#detail-title').textContent=title;const c=$('#detail-content');c.replaceChildren();if(!$('#detail-dialog').open)$('#detail-dialog').showModal();return c;}
function paragraph(c,text){const p=document.createElement('p');p.textContent=text;c.append(p);return p;}
function codeBlock(c,text){const p=document.createElement('pre');p.textContent=typeof text==='string'?text:JSON.stringify(text,null,2);c.append(p);return p;}
function item(c,k,v){const p=document.createElement('div');p.className='detail-row';const a=document.createElement('span'),b=document.createElement('b');a.textContent=k;b.textContent=v;p.append(a,b);c.append(p);}
function button(c,label,fn,cls='quiet'){const b=document.createElement('button');b.textContent=label;b.className=cls;b.addEventListener('click',()=>Promise.resolve().then(fn).catch(reportError));c.append(b);return b;}
function reportError(e){toast(e?.message||String(e));log('REJECTED',e?.message||String(e));}
function download(data,name,type='application/json'){const blob=data instanceof Blob?data:new Blob([typeof data==='string'?data:JSON.stringify(data,null,2)],{type});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),30000);}
function stored(){try{return localStorage.getItem(STORE);}catch{canPersist=false;return null;}}
function persist(){if(!canPersist)return;try{const b=makeBundle(world.snapshots[0],world.receipts,world.state);localStorage.setItem(STORE,JSON.stringify(b));persistedAudit=b.expectedAudit;}catch{canPersist=false;toast('Browser storage unavailable. Export a receipt book to keep this identity.');}}
function checkSavedHead(){if(!canPersist||!persistedAudit)return;const raw=stored();if(!raw)throw Error('The saved identity changed in another tab. Export your open history before reloading.');let saved;try{saved=JSON.parse(raw);}catch{throw Error('Saved history is corrupt; it has not been overwritten.');}if(saved.expectedAudit!==persistedAudit)throw Error('Another tab changed this identity. Reload before editing.');}
function lock(fn){return navigator.locks?.request?navigator.locks.request(STORE,fn):fn();}
function paint(changeBody=false,kind=0){const s=displayState(),historical=!present(),onChain=!!chainState;document.body.classList.toggle('sovereign',s.sovereign);document.body.classList.toggle('busy',busy);$('#mode').textContent=s.sovereign?'SOVEREIGN':'BOUND';$('#token-label').textContent=onChain?'#'+s.tokenId.padStart(4,'0'):childView?'CHILD '+childView.visualIndex:'#0001';$('#chain-tag').textContent=onChain?TEST_CHAINS.get(s.chainId):'LOCAL OBJECT';$('#evolutions').textContent=s.evolutions;$('#descendants').textContent=onChain?'—':s.children.length;$('#generation').textContent=s.generation;$('#nonce').textContent=s.nonce;$('#next-nonce').textContent=s.nonce;
 for(const[k,id]of [['genome','genome'],['root','root'],['memory','memory-root'],['audit','audit']])$('#'+id).textContent=shortHash(s[k],10,6);
 $('#account').textContent=onChain?s.account:'NOT DEPLOYED · PREVIEW';$('#saved').textContent=onChain?'BLOCK '+s.blockNumber:canPersist?'SAVED TO THIS BROWSER':'SESSION ONLY';$('#coordinate').textContent=(onChain?'CHAIN '+s.chainId+' / ':'STATE / ')+shortHash(s.root,12,7);$('#designation').textContent=childView?'DESCENDANT / GENERATION '+s.generation:historical?'HISTORICAL FORM / READ ONLY':s.sovereign?'SOVEREIGN — EVERY ACTION HAS A CONDITION':'GENESIS — ONE CONTINUOUS IDENTITY';$('#policy-preview').textContent=s.policy;
 $('#read-only').hidden=!historical;$('#timeline').max=world.snapshots.length-1;$('#timeline').value=selected;$('#timeline-label').textContent='STATE '+selected+' / '+(selected===0?'GENESIS':world.receipts[selected-1]?.kind)+' · READ-ONLY HISTORY';
 for(const id of ['evolve','memory','spawn','ascend','entropy'])$('#'+id).disabled=busy||historical||(!onChain&&world.state.nonce>=MAX_RECEIPTS)||(id==='ascend'&&s.sovereign)||(id==='entropy'&&(s.sovereign||onChain))||(id==='spawn'&&!onChain&&s.children.length>=MAX_CHILDREN);
 $('#history').disabled=onChain;$('#identity-source').textContent=onChain?'RPC SNAPSHOT / BLOCK '+s.blockNumber:'LOCAL SHA-256 STATE';$('#identity-mark').textContent=onChain?'CHAIN':'LOCAL';$('#chain-status').textContent=onChain?'RECEIPT-GATED TESTNET WRITES':'CONNECT A TESTNET DEPLOYMENT';$('#chain-mark').textContent=onChain?'READY':'OFF';$('#scope-label').textContent=onChain?'TESTNET / RECEIPTS ARE NOT FINALITY':'PREVIEW / NO TRANSACTIONS';$('#environment span').textContent=onChain?TEST_CHAINS.get(s.chainId):'LOCAL PREVIEW';$('#connect').textContent=onChain?shortHash(client.owner,6,4):'CONNECT';$('#disconnect').hidden=!onChain;
 if(changeBody){renderer?.setState(s,kind);audio.tune(s);if(kind)audio.note(s,Object.keys(eventNumber).find(k=>eventNumber[k]===kind));}
 const holder=$('#satellites');if(holder.children.length!==(s.children||[]).slice(0,12).length){holder.replaceChildren();s.children.slice(0,12).forEach((ch,i)=>{const b=document.createElement('button');b.className='satellite';b.setAttribute('aria-label','Enter descendant '+(i+1));b.title='ENTER DESCENDANT '+(i+1);b.textContent='+';b.addEventListener('click',()=>enterChild(ch,i).catch(reportError));holder.append(b);});}
 $('#sr-state').textContent=(onChain?'Testnet token ':'Local preview ')+(s.sovereign?'Sovereign':'Bound')+', evolution '+s.evolutions+', nonce '+s.nonce;
}
function refreshLens(n){renderer.lens=n;renderer.dirty=true;$$('[data-lens]').forEach(b=>{const active=Number(b.dataset.lens)===n;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active));});const c=$('#lens-detail');c.replaceChildren();if(n===2){paragraph(c,'Memory changes the wavelength of the field. The commitment is visible; the discarded thought is not recoverable.');button(c,'INSPECT MEMORY ↗',()=>{const d=detail('MEMORY / COMMITMENT','A trace, not the thought.');codeBlock(d,displayState().memory);paragraph(d,'Only the digest is represented. This is not encrypted recoverable storage.');});}else if(n===4){const children=displayState().children;if(!children.length)paragraph(c,chainState?'Descendant indexing is not loaded in this client. Mint receipts identify each child token.':'Spawn a descendant. Its amber light can be entered; the parent remains intact.');children.forEach((ch,i)=>button(c,'DESCENDANT '+(i+1)+' ↗',()=>enterChild(ch,i)));}else{const l=document.createElement('div');l.className='section-label';l.textContent='CONSTITUTION';c.append(l);['Every action binds its prior state.','The past remains read-only.','Ascension cannot be undone.'].forEach((text,i)=>{const d=document.createElement('div');d.className='law';const n=document.createElement('span'),p=document.createElement('p');n.textContent='0'+(i+1);p.textContent=text;d.append(n,p);c.append(d);});}}
async function enterChild(ch,i){if(busy||chainState)return;childView={...await genesis(ch.id,ch.bornAt),genome:ch.genome,lineage:ch.lineage,generation:ch.generation,visualIndex:i+1};renderer.event(3);paint(true,3);refreshLens(0);log('LINEAGE','Entered descendant '+(i+1)+'. This is a read-only view, not a transfer.');}
function returnPresent(){if(busy)return;childView=null;selected=world.snapshots.length-1;paint(true);refreshLens(0);log('PRESENT','Returned to the current state. No history was rewritten.');}
async function localAction(kind,payload){if(busy||!present())return;if(chainState)throw Error('A connected token must use a reviewed transaction, not local simulation.');busy=true;paint();try{await lock(async()=>{checkSavedHead();const out=await transition(world.state,kind,payload,Math.max(Date.now(),world.state.updatedAt),world.state.nonce);checkSavedHead();world={state:out.state,receipts:[...world.receipts,out.receipt],snapshots:[...world.snapshots,out.state]};selected=world.snapshots.length-1;persist();});paint(true,eventNumber[kind]);log(kind,{EVOLVE:'Genome and state advanced together. Local receipt '+world.state.nonce+'.',SEAL_MEMORY:'Salted digest retained. Thought and salt discarded.',SPAWN:'Descendant '+world.state.children.length+' formed. Enter its amber light.',ASCEND:'Sovereign preview policy active. Direct entropy disabled.',ENTROPY:'Bound-mode genome perturbation committed locally.'}[kind]);refreshLens(kind==='SEAL_MEMORY'?2:0);}finally{busy=false;paint();}}
function showReceipts(){const c=detail(chainState?'CHAIN SNAPSHOT':'LOCAL RECEIPTS / UNSIGNED',chainState?'Observed, not assumed.':'Inspect the history.');if(chainState){paragraph(c,'This snapshot was read from the connected wallet’s RPC at one block number. It is not a locally verified storage proof, and one inclusion does not establish finality.');codeBlock(c,chainState);return;}paragraph(c,'These receipts detect inconsistent edits against the stored history. They do not authenticate an owner, produce ZK/TEE proofs, or establish blockchain execution.');button(c,'RECOMPUTE ALL RECEIPTS',async()=>{await verifyBundle(makeBundle(world.snapshots[0],world.receipts,world.state));toast(world.receipts.length+' local receipts recomputed successfully.');});button(c,'EXPORT RECEIPT BOOK',exportStudy);world.receipts.slice().reverse().forEach((r,i)=>button(c,String(r.index).padStart(3,'0')+' / '+r.kind,()=>{const d=detail('UNSIGNED LOCAL RECEIPT',r.kind);codeBlock(d,r);button(d,'VIEW THIS FORM',()=>{$('#detail-dialog').close();childView=null;selected=r.index;paint(true);$('#history-strip').hidden=false;});}));}
function exportStudy(){if(chainState){download({schema:'idfbi/observed-chain-snapshot/1',snapshot:chainState},'idfbi-chain-snapshot.json');return;}download(makeBundle(world.snapshots[0],world.receipts,world.state),'idfbi-history-'+world.state.nonce+'.json');}
function showBoundary(){const c=detail('EXECUTION BOUNDARY','What this screen actually does.');paragraph(c,'The optical field is running code, not a video or generated background. Its seed, genome and state feed its light structure. Camera and fourth-axis controls change the view, not ownership.');item(c,'Renderer',renderer.backend);item(c,'Current execution',chainState?'Connected testnet / explicit wallet approval':'Local deterministic preview');item(c,'ZK / TEE proofs',chainState?'External proofs required for sovereign evolution':'Not generated or verified');item(c,'Memory','Salted commitment, not a notebook');item(c,'Protocol audit','No independent audit');paragraph(c,'WebGL uses a procedural fragment shader. When unavailable, a WebAssembly worker evaluates the same field source at lower resolution; it may be slower. Screenshots and portraits show the running renderer. The included contract changes still require full-toolchain testing and security review before use with value.');button(c,'VIEW SOURCE-LEVEL STATE',()=>{const d=detail('STATE','The current identity.');codeBlock(d,displayState());});}
function showMenu(){const c=detail('TOOLS','Keep the identity.');button(c,'EXPORT HISTORY',exportStudy);button(c,'IMPORT HISTORY',()=>{$('#file-input').dataset.purpose='study';$('#file-input').click();});button(c,'SAVE PORTRAIT',savePortrait);button(c,'START A SEPARATE PREVIEW',()=>{const d=detail('NEW IDENTITY','Keep this one first.');paragraph(d,'A new preview has a different genesis. It does not undo Ascension. Export your existing history before replacing the active local preview.');button(d,'EXPORT CURRENT HISTORY',exportStudy);button(d,'CREATE NEW PREVIEW',async()=>{if(busy||chainState)throw Error('Disconnect the chain before creating a local identity.');const s=await genesis(randomHex(),Date.now());world={state:s,snapshots:[s],receipts:[]};selected=0;childView=null;canPersist=true;persist();paint(true,1);refreshLens(0);$('#detail-dialog').close();log('AWAKEN','A separate local genesis was created.');});});button(c,'EXECUTION BOUNDARY',showBoundary);if(proofRequest)button(c,'IMPORT PROOF FOR PREPARED EVOLUTION',()=>{$('#file-input').dataset.purpose='proof';$('#file-input').click();});if(mintSecret)button(c,'RESUME AWAKENING / EXPORT SECRET',showMint);button(c,'IMPORT AWAKENING SECRET',()=>{$('#file-input').dataset.purpose='awakening';$('#file-input').click();});}
async function savePortrait(){download(await renderer.portrait(),'idfbi-'+(displayState().sovereign?'sovereign':'bound')+'-'+displayState().nonce+'.png','image/png');toast('Portrait rendered from the current field.');}
function showOriginal(){const d=document.createElement('dialog');d.className='reference-dialog';const close=document.createElement('button');close.className='reference-back quiet';close.textContent='ARCHIVED SIMULATION / RETURN TO 1.2 ↗';close.addEventListener('click',()=>d.close());const frame=document.createElement('iframe');frame.title='Unmodified original v1.0 interactive preview';frame.setAttribute('sandbox','allow-scripts allow-downloads');frame.srcdoc=ASSETS.referenceHTML;d.append(frame,close);document.body.append(d);d.addEventListener('close',()=>d.remove());d.showModal();}
async function chainLoad(){if(busy)return;$('#connection-status').textContent='Requesting the selected wallet account…';try{client?.close();client=new TestnetClient(window.ethereum,message=>{review=null;chainState=null;paint(true);toast(message);$('#connection-status').textContent=message;});await client.connect($('#collection-input').value.trim());chainState=await client.snapshot($('#token-input').value.trim());$('#connection-status').textContent='Read token '+chainState.tokenId+' at block '+chainState.blockNumber+'. No transaction sent.';$('#chain-dialog').close();paint(true);log('CHAIN','Snapshot loaded from '+TEST_CHAINS.get(client.chainId)+'. Preview state is preserved separately.');}catch(e){$('#connection-status').textContent=e.message;throw e;}}
function disconnect(){if(busy||client?.pending)throw Error('Wait for the pending transaction result before disconnecting.');client?.close();client=null;chainState=null;review=null;proofRequest=null;paint(true);log('PREVIEW','Returned to local preview. No chain state was changed.');}
function showReview(plan){$('#detail-dialog').close();review=plan;$('#transaction-title').textContent=plan.label;const c=$('#transaction-review');c.replaceChildren();item(c,'Network',TEST_CHAINS.get(plan.chainId)+' / '+plan.chainId);item(c,'From',plan.tx.from);item(c,'Target',plan.tx.to);item(c,'Native token value','0');item(c,'Estimated gas',plan.estimatedGas);item(c,'Gas-price estimate / wei',plan.maxEstimatedFeeWei);paragraph(c,plan.note);codeBlock(c,plan.tx.data);paragraph(c,'The RPC simulation succeeded. It is not an audit or a guarantee of transaction success. Your wallet will show current gas fees.');$('#send-transaction').disabled=false;$('#transaction-dialog').showModal();}
async function runChain(kind,payload){if(busy)return;busy=true;paint();try{let plan;if(kind==='EVOLVE'){plan=await client.evolution(randomHex());if(plan.proofRequired){proofRequest=plan;const c=detail('SOVEREIGN / PROOF REQUIRED','No owner bypass.');paragraph(c,'The deployed account supplied the statement for this exact evolution. Export it to your configured verifier, then import a JSON object containing a hexadecimal proof. The client accepts only a proof for this retained request and simulates it against the deployed account before asking for a wallet transaction.');codeBlock(c,plan);button(c,'EXPORT PROOF REQUEST',()=>download(plan,'idfbi-sovereign-evolution-request.json'));button(c,'IMPORT PROOF',()=>{$('#file-input').dataset.purpose='proof';$('#file-input').click();});return;}}else if(kind==='SPAWN')plan=await client.spawn(randomHex());else if(kind==='SEAL_MEMORY')plan=await client.seal(payload.commitment);else if(kind==='ASCEND')plan=await client.ascend(payload.policy);else throw Error('Unsupported chain action.');showReview(plan);}finally{busy=false;paint();}}
async function sendReviewed(){const plan=review;if(!plan||busy) return;busy=true;$('#send-transaction').disabled=true;$('#transaction-dialog').close();$('#transaction-flow').hidden=false;$('#transaction-caption').textContent='Awaiting wallet approval';paint();try{const receipt=await client.send(plan,(stage,hash)=>{$('#transaction-caption').textContent=stage+' / '+shortHash(hash);log(stage,hash);});if(plan.label==='COMMIT AWAKENING'){mintSecret.block=BigInt(receipt.blockNumber).toString();try{sessionStorage.setItem('idfbi.awakening',JSON.stringify(mintSecret));}catch{}showMint();}else if(plan.label==='REVEAL AWAKENING'){const transfer=receipt.logs.find(l=>l.address.toLowerCase()===client.collection&&l.topics[0]===keccak256('Transfer(address,address,uint256)')&&BigInt(l.topics[1])===0n);if(!transfer)throw Error('No mint event found. Inspect the included transaction.');$('#token-input').value=BigInt(transfer.topics[3]).toString();mintSecret=null;try{sessionStorage.removeItem('idfbi.awakening');}catch{}chainState=await client.snapshot($('#token-input').value);paint(true,1);}else if(client.tokenId){chainState=await client.snapshot(client.tokenId);paint(true,plan.label.includes('EVOLUTION')||plan.label==='EVOLVE'?1:plan.label.includes('ASCENSION')?4:plan.label.includes('SPAWN')?3:2);if(plan.label==='SPAWN DESCENDANT'){const transfer=receipt.logs.find(l=>l.address.toLowerCase()===client.collection&&l.topics[0]===keccak256('Transfer(address,address,uint256)')&&BigInt(l.topics[1])===0n);if(transfer)log('DESCENDANT','Minted child token #'+BigInt(transfer.topics[3])+'. Load that ID to enter its chain state.');}}toast('Transaction included successfully. Not a claim of finality.');review=null;}catch(e){reportError(e);}finally{busy=false;$('#transaction-flow').hidden=true;paint();}}
async function mintMenu(){if(busy)return;if(!client?.connected){client?.close();client=new TestnetClient(window.ethereum,m=>{chainState=null;review=null;paint(true);toast(m);});await client.connect($('#collection-input').value.trim());}if(!mintSecret){mintSecret={schema:'idfbi/awakening-secret/1',collection:client.collection,chainId:client.chainId,owner:client.owner,secret:randomHex(),block:null};try{sessionStorage.setItem('idfbi.awakening',JSON.stringify(mintSecret));}catch{}}$('#chain-dialog').close();showMint();}
function showMint(){const c=detail('MINT / TWO TRANSACTIONS','Commit, then awaken.');paragraph(c,'Minting uses a zero-endowment commitment followed by a reveal at least two blocks later. Save the recovery JSON before the first transaction. It contains the reveal secret, not a wallet private key. Losing it can prevent completing this mint.');if(!client?.connected){paragraph(c,'Reconnect the wallet and collection matching this recovery file before continuing.');return;}if(mintSecret.owner!==client.owner||mintSecret.collection!==client.collection||mintSecret.chainId!==client.chainId)throw Error('Awakening secret belongs to a different wallet or chain.');item(c,'Collection',client.collection);item(c,'Recipient',client.owner);item(c,'Commit block',mintSecret.block||'NOT YET INCLUDED');button(c,'EXPORT RECOVERY JSON',()=>download(mintSecret,'idfbi-awakening-recovery.json'));button(c,'REVIEW COMMIT',async()=>{cons