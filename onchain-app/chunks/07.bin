t commitment=keccak256(bytesOf(abiEncode(['address','bytes32','address'],[client.owner,mintSecret.secret,client.owner])));showReview(await client.prepare('COMMIT AWAKENING',client.collection,callData('commitAwakening(bytes32)',['bytes32'],[commitment]),{note:'First of two mint transactions. Endowment is zero. Save the reveal secret before signing.'}));});button(c,'REVIEW REVEAL',async()=>{showReview(await client.prepare('REVEAL AWAKENING',client.collection,callData('revealAwakening(bytes32,address)',['bytes32','address'],[mintSecret.secret,client.owner]),{note:'Reveal after the minimum two-block delay and before the contract’s expiry. The contract rejects early, expired, or incorrect secrets.'}));});paragraph(c,'An already active commitment makes a second commit revert. The reveal simulation checks timing and the secret. A local chain may need two manually mined blocks.');}
async function boot(){const raw=stored();if(raw){try{world=await verifyBundle(JSON.parse(raw));persistedAudit=world.state.audit;}catch{canPersist=false;toast('Saved history failed verification. It has not been overwritten; export or inspect it before resetting.');}}
 if(!world){const seed=keccak256('i dont fucking believe it! / optical genesis / 1.2');const s=await genesis(seed,1788566400000);world={state:s,snapshots:[s],receipts:[]};persist();}selected=world.snapshots.length-1;
 renderer=new OpticalField($('#organism'),$('#atmosphere'),world.state,s=>{$('#render-status').textContent=s;});renderer.onStats=s=>{$('#render-status').textContent=s.backend.toUpperCase()+(s.cpuMs?' / '+Math.round(s.cpuMs)+' MS PER FIELD':' / '+s.fps+' PRESENT FPS');};renderer.onChildren=positions=>positions.forEach(({x,y,i})=>{const b=$('#satellites').children[i];if(b){b.style.left=x+'px';b.style.top=y+'px';}});
 paint(true);log('AWAKEN','Optical field bound to local genome and state. No wallet or network request.');log('RENDER','Procedural field / original fractal folds retained in the optical microstructure.');try{const m=sessionStorage.getItem('idfbi.awakening');if(m)mintSecret=JSON.parse(m);}catch{}
 for(const b of $$('[data-close]'))b.addEventListener('click',()=>$('#'+b.dataset.close).close());for(const d of $$('dialog'))d.addEventListener('click',e=>{if(e.target===d){const r=d.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)d.close();}});
 const handle=(id,fn)=>$('#'+id).addEventListener('click',()=>Promise.resolve().then(fn).catch(reportError));
 handle('evolve',()=>chainState?runChain('EVOLVE'):localAction('EVOLVE',{salt:randomHex()}));handle('entropy',()=>localAction('ENTROPY',{salt:randomHex()}));handle('spawn',()=>chainState?runChain('SPAWN'):localAction('SPAWN',{salt:randomHex()}));
 handle('memory',()=>{if(busy||!present())return;$('#memory-text').value='';$('#seal').disabled=true;$('#memory-dialog').showModal();});$('#memory-text').addEventListener('input',()=>$('#seal').disabled=!$('#memory-text').value.trim());$('#memory-dialog').addEventListener('close',()=>{$('#memory-text').value='';$('#seal').disabled=true;});
 handle('seal',async()=>{if(busy||!$('#memory-text').value.trim())return;const thought=$('#memory-text').value,salt=randomHex();$('#memory-text').value='';$('#memory-dialog').close();const commitment=chainState?keccak256(bytesOf(abiEncode(['string','bytes32'],[thought,salt]))):await digest('private-thought',{thought,salt});if(chainState)await runChain('SEAL_MEMORY',{commitment});else await localAction('SEAL_MEMORY',{commitment});});
 handle('ascend',()=>{if(busy||!present())return;$('#ascend-consent').checked=false;$('#ascend-confirm').disabled=true;$('#ascend-description').textContent=chainState?'This is a REAL TESTNET authority change. Owner execution and transfer are permanently removed. Without configured proof infrastructure the NFT can become unusable. The client never fabricates proofs.':'Direct entropy edits stop. Later preview actions follow the local policy. This cannot be undone within this identity; no chain transaction is involved.';$('#policy-preview').textContent=chainState?keccak256('idfbi/testnet/constitution/v1.2/zero-native-value'):world.state.policy;$('#ascend-dialog').showModal();});$('#ascend-consent').addEventListener('change',()=>$('#ascend-confirm').disabled=!$('#ascend-consent').checked);handle('ascend-confirm',async()=>{if(!$('#ascend-consent').checked)return;$('#ascend-dialog').close();if(chainState)await runChain('ASCEND',{policy:$('#policy-preview').textContent});else await localAction('ASCEND',{policy:world.state.policy});});
 handle('sound',async()=>{if(audio.enabled)await audio.disable();else await audio.enable(displayState());$('#sound b').textContent=audio.enabled?'ON':'OFF';$('#sound').setAttribute('aria-pressed',String(audio.enabled));});document.addEventListener('visibilitychange',()=>audio.visibility(document.hidden).catch(reportError));
 handle('motion',()=>{renderer.motion=!renderer.motion;renderer.dirty=true;$('#motion').textContent=renderer.motion?'Ⅱ MOTION':'▶ MOTION';$('#motion').setAttribute('aria-pressed',String(renderer.motion));});
 handle('fold',()=>{renderer.foldTarget=renderer.foldTarget>.1?0:1;renderer.dirty=true;$('#depth').value=Math.round(renderer.foldTarget*100);$('#fold').setAttribute('aria-pressed',String(renderer.foldTarget>.1));});$('#depth').addEventListener('input',()=>{renderer.foldTarget=Number($('#depth').value)/100;renderer.dirty=true;});handle('reset',()=>{renderer.reset();$('#depth').value=0;$('#fold').setAttribute('aria-pressed','false');});
 handle('immerse',()=>{const immersed=document.body.classList.toggle('immersed');$('#immerse').setAttribute('aria-pressed',String(immersed));$('#restore-ui').hidden=!immersed;});handle('restore-ui',()=>{document.body.classList.remove('immersed','panels-hidden');$('#restore-ui').hidden=true;$('#immerse').setAttribute('aria-pressed','false');});handle('hide-panels',()=>{document.body.classList.add('panels-hidden');$('#restore-ui').hidden=false;});handle('mobile-panel',()=>document.body.classList.toggle('mobile-inspect'));
 $$('[data-lens]').forEach(b=>b.addEventListener('click',()=>refreshLens(Number(b.dataset.lens))));handle('history',()=>{if(chainState)return;$('#history-strip').hidden=!$('#history-strip').hidden;});handle('close-history',()=>$('#history-strip').hidden=true);$('#timeline').addEventListener('input',()=>{if(busy||chainState)return;childView=null;selected=Number($('#timeline').value);paint(true);});handle('return-live',returnPresent);handle('return-head',returnPresent);
 handle('inspect',showReceipts);handle('all-events',()=>{const c=detail('EVENT HORIZON','Observed actions.');events.slice().reverse().forEach(e=>paragraph(c,e.time+' / '+e.kind+' / '+e.message));});handle('environment',showBoundary);handle('details',()=>{const c=detail('IDENTITY','The current state.');codeBlock(c,displayState());});$$('[data-root]').forEach(b=>b.addEventListener('click',()=>{const c=detail(b.dataset.root.toUpperCase(),'Inspect the full commitment.');codeBlock(c,displayState()[b.dataset.root]);button(c,'COPY',async()=>{if(!navigator.clipboard?.writeText)throw Error('Clipboard unavailable; select the displayed digest to copy it.');await navigator.clipboard.writeText(displayState()[b.dataset.root]);toast('Copied.');});}));handle('export',exportStudy);handle('portrait',savePortrait);handle('more',showMenu);handle('reference',showOriginal);$('#reference').textContent='ORIGINAL V1.0 ↗';
 handle('quality',()=>{renderer.quality=renderer.quality==='auto'?'detail':renderer.quality==='detail'?'economy':'auto';renderer.dirty=true;$('#quality').textContent='QUALITY: '+renderer.quality.toUpperCase();});
 handle('help',()=>{const c=detail('CONTROLS','Enter, rather than inspect.');paragraph(c,'Move the pointer to affect the field. Drag to orbit; scroll to approach. Fold space sweeps a fourth-coordinate slice without editing the genome. Evolve changes the identity’s state and its light structure.');paragraph(c,'Memory changes its spectral layer. Spawn creates an amber descendant you can enter. History returns to previous forms without rolling back the present. Immerse hides the instrument panels. Sound is optional.');item(c,'Keyboard','Arrows / + / − over the scene. Escape closes dialogs.');item(c,'Presentation','The exact original v1.0 preview remains under ORIGINAL V1.0.');button(c,'EXECUTION BOUNDARY',showBoundary);});
 handle('connect',()=>$('#chain-dialog').showModal());handle('load-token',chainLoad);handle('disconnect',disconnect);handle('send-transaction',sendReviewed);handle('mint-menu',mintMenu);
 $('#file-input').addEventListener('change',async()=>{try{const file=$('#file-input').files[0];if(!file)return;if(file.size>2000000)throw Error('File exceeds the 2 MB import limit.');const parsed=JSON.parse(await file.text());const purpose=$('#file-input').dataset.purpose;
 if(purpose==='proof'){if(!proofRequest||!client?.connected)throw Error('Prepare a sovereign evolution first.');if(typeof parsed.proof!=='string')throw Error('Expected JSON with a hexadecimal proof field.');if(parsed.statement&&parsed.statement!==proofRequest.statement)throw Error('Proof statement mismatch.');showReview(await client.verifiedEvolution(proofRequest,parsed.proof));return;}
 if(purpose==='awakening'){if(parsed.schema!=='idfbi/awakening-secret/1'||!/^0x[0-9a-f]{64}$/.test(parsed.secret)||!TEST_CHAINS.has(parsed.chainId))throw Error('Invalid awakening recovery file.');mintSecret=parsed;showMint();return;}
 if(busy||chainState)throw Error('Return to the local preview before importing history.');importCandidate=await verifyBundle(parsed);$('#import-description').textContent='Verified '+importCandidate.receipts.length+' unsigned local receipts. Importing replaces the active browser preview, not the chain. Export the current identity first to retain it.';$('#import-dialog').showModal();}catch(e){reportError(e);}finally{$('#file-input').value='';}});
 handle('confirm-import',()=>{if(!importCandidate||busy||chainState)return;world=importCandidate;importCandidate=null;selected=world.snapshots.length-1;childView=null;canPersist=true;persist();$('#import-dialog').close();$('#detail-dialog').close();paint(true,1);refreshLens(0);log('IMPORT','Verified history imported; original identity reconstructed.');});
 window.__idfbi={version:'1.2.0',state:()=>structuredClone(displayState()),bundle:()=>makeBundle(world.snapshots[0],world.receipts,world.state),renderer,world:()=>world,chain:()=>chainState};document.body.dataset.ready='true';
}
boot().catch(e=>{document.body.dataset.error=e.message;$('#render-status').textContent='INITIALIZATION FAILED';reportError(e);});

})();</script>
<style id="instrument-styles">/* Additive controls only. The approved organism's shaders, geometry and layout remain the baseline. */
#instrument-open{border-color:#8af1ff44;color:#c9f4fa}
.ix-dialog{width:min(900px,calc(100vw - 28px));max-width:900px;max-height:calc(100svh - 36px);padding:0;background:#080b12f7;border:1px solid #b7cee52d;border-radius:15px;box-shadow:0 26px 100px #0009;color:#e9eff5;scrollbar-width:thin}
.ix-dialog::backdrop{background:#03060b88;backdrop-filter:blur(5px)}
.ix-header{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:25px 28px 16px}.ix-eyebrow{font:9px var(--mono);letter-spacing:1.6px;color:#879db2}.ix-header h2{font:400 24px/1.3 var(--sans);letter-spacing:-.6px;margin:8px 0 0}.ix-close{background:none;border:1px solid #b7cee527;width:33px;height:33px;border-radius:50%;font:23px var(--sans);color:#bdc9d7}
.ix-context{display:flex;gap:20px;align-items:center;flex-wrap:wrap;padding:0 28px 16px;font:10px var(--mono);color:#8c9bad}.ix-status{font-size:8px;letter-spacing:.9px;color:#aee9bf;border:1px solid #aee9bf30;padding:5px 7px;border-radius:4px}.ix-context label{display:flex;align-items:center;gap:7px}.ix-context select{padding:3px 5px;font:10px var(--mono);background:#101620;color:#d2dce7;border:0;max-width:180px;border-radius:3px}
.ix-tabs{display:flex;padding:0 28px;border-block:1px solid #b7cee519;gap:25px;overflow:auto;scrollbar-width:none}.ix-tabs button{padding:15px 0;border:0;border-bottom:2px solid transparent;background:none;font:11px var(--sans);color:#8c9bad;white-space:nowrap}.ix-tabs button[aria-selected=true]{color:#c9f4fa;border-bottom-color:#8af1ff}.ix-tabs button:hover{color:#f2faff}
.ix-content{padding:24px 28px;min-height:325px}.ix-content h3{font:400 22px/1.35 var(--sans);letter-spacing:-.4px;margin:0 0 8px}.ix-content h4{font:500 13px/1.5 var(--sans);margin:0 0 9px}.ix-content p{font:12px/1.75 var(--sans);color:#8f9fb1;margin:0 0 18px}.ix-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(205px,.66fr);gap:25px}.ix-main{min-width:0}.ix-side{border-left:1px solid #b7cee51a;padding-left:23px;min-width:0}.ix-small{font:10px/1.7 var(--mono)!important;color:#8496aa!important}.ix-content label{display:block;font:10px var(--sans);letter-spacing:.2px;color:#aab7c7;margin:0 0 7px}.ix-content input:not([type=range]):not([type=checkbox]),.ix-content select,.ix-content textarea{width:100%;border:1px solid #b7cee529;border-radius:7px;background:#0d131e;padding:11px 12px;color:#e9f0f8;font:13px/1.4 var(--sans);margin:0;min-width:0}.ix-content textarea{resize:vertical}.ix-content input[type=range]{padding:0;margin:8px 0;accent-color:#8af1ff;width:100%}.ix-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}.ix-field{margin-bottom:15px}.ix-asset{display:grid;grid-template-columns:minmax(0,1fr) 104px;border:1px solid #b7cee52a;border-radius:9px;padding:8px;margin-bottom:18px;background:#0d131e}.ix-asset input{font-size:29px!important;border:0!important;background:none!important;padding:8px!important}.ix-asset select{border:0!important;background:#141e2b!important;align-self:center}.ix-estimate{border-left:2px solid #8af1ff6b;padding:7px 14px;margin:17px 0 20px;font:18px var(--mono);color:#d2f5ff}.ix-estimate small{display:block;margin-top:7px;font:9px/1.6 var(--mono);color:#8394a8}.ix-button{padding:11px 14px;border:1px solid #a6c6d238;border-radius:7px;background:#101b28;font:11px var(--sans);color:#d0e0ee;min-height:37px}.ix-button:hover:not(:disabled){background:#162939;border-color:#83c2d466}.ix-button.primary{background:#14323a;border-color:#8af1ff55;color:#d3f8ff;width:100%;margin-top:7px}.ix-button.danger{background:#29141d;border-color:#c879963e;color:#eab2c8}.ix-button:disabled{opacity:.35}.ix-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px}.ix-actions .primary{width:auto}.ix-check{display:flex!important;gap:8px;align-items:center;margin:8px 0 13px!important}.ix-check input{accent-color:#8af1ff}
.ix-fact{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;padding:10px 0;border-bottom:1px solid #b7cee517;font:11px/1.55 var(--sans)}.ix-fact span{color:#8598ab}.ix-fact strong{font-weight:400;color:#d4e2ee;text-align:right;overflow-wrap:anywhere;max-width:65%}.ix-flow{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.ix-flow span{padding:6px 10px;border:1px solid #8af1ff28;border-radius:4px;color:#afcbd8;font:9px var(--mono)}.ix-flow b{font:12px var(--sans);color:#7e9aab;align-self:center}.ix-content details{margin:18px 0;border-top:1px solid #b7cee51a;padding-top:12px}.ix-content summary{cursor:pointer;font:11px var(--sans);color:#b0bfcd}.ix-content details p{margin-top:12px}.ix-code{font:9px/1.6 var(--mono);overflow-wrap:anywhere;color:#8da5bd;display:block;margin:12px 0}.ix-content pre{max-height:240px;overflow:auto;white-space:pre-wrap;word-break:break-all;font:10px/1.6 var(--mono);padding:14px;background:#03060b;border:1px solid #b7cee51a;border-radius:7px}.ix-cards{display:grid;gap:12px;grid-template-columns:repeat(2,minmax(0,1fr))}.ix-card{border:1px solid #b7cee526;border-radius:9px;padding:17px;background:#0b1019}.ix-card h4{display:flex;justify-content:space-between;gap:15px}.ix-card p{font-size:11px;margin:8px 0 0}.ix-tag{font:8px var(--mono);letter-spacing:.5px;color:#99bacd;border:1px solid #99bacd30;padding:4px 6px;border-radius:4px;white-space:nowrap}.ix-divider{border:0;border-top:1px solid #b7cee51a;margin:24px 0}.ix-progress{height:3px;background:#b7cee516;border-radius:3px;overflow:hidden;margin:13px 0}.ix-progress span{display:block;height:100%;background:#89bfcf}.ix-stack{display:grid;gap:11px}.ix-inline{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin:14px 0}.ix-feed{max-height:330px;overflow:auto;scrollbar-width:thin;display:grid;gap:8px;margin:16px 0}.ix-post{padding:12px 14px;border-left:1px solid #b7cee536;background:#0b111a;overflow-wrap:anywhere}.ix-post header{display:flex;justify-content:space-between;font:9px var(--mono);color:#8fa8bc;gap:12px}.ix-post p{margin:7px 0 0;color:#c3d0df;font-size:12px}.ix-post.activity{border-left-color:#8af1ff66;background:#09171d}.ix-post button{background:none;border:0;padding:5px 0 0;font:9px var(--sans);color:#9dd3df}.ix-post small{font:9px/1.6 var(--mono);color:#748b9e}.ix-composer{display:grid;grid-template-columns:1fr auto;gap:8px}.ix-composer button{align-self:end}.ix-person{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px;font-size:11px}.ix-person button{font-size:10px;padding:5px 8px}.ix-timeline{border-left:1px solid #8af1ff4f;padding-left:19px;margin:15px 0}.ix-timeline article{position:relative;padding:0 0 23px}.ix-timeline article::before{content:'';position:absolute;left:-23px;top:5px;width:6px;height:6px;border-radius:50%;background:#9bc8d5}.ix-timeline h4{font:11px var(--mono);color:#b7e3ed}.ix-timeline p{margin:7px 0;font-size:11px}.ix-footer{padding:15px 28px;border-top:1px solid #b7cee51a;display:flex;gap:15px;justify-content:space-between;align-items:center;color:#6e8094;font:9px var(--sans);flex-wrap:wrap}.ix-footer div{display:flex;gap:13px;flex-wrap:wrap}.ix-footer button{border:0;background:none;color:#96a9bb;font:10px var(--sans);padding:3px 0}#ix-notice:empty{display:none}#ix-notice{margin:0 28px 18px;padding:11px 13px;border:1px solid #8af1ff30;background:#102331;color:#c8e9f6;border-radius:7px;font:11px/1.6 var(--sans)}#ix-notice[data-error=true]{border-color:#d886aa55;color:#ebc4d4;background:#23111b}
@media(max-width:650px){.ix-dialog{width:calc(100vw - 16px);max-height:calc(100svh - 16px);border-radius:12px}.ix-header{padding:18px 17px 14px}.ix-header h2{font-size:20px}.ix-eyebrow{font-size:8px}.ix-context{padding:0 17px 14px;gap:10px;justify-content:space-between}.ix-context label{font-size:9px}.ix-context label:last-child{width:100%}.ix-context select{max-width:205px}.ix-tabs{padding:0 17px;gap:22px}.ix-tabs button{font-size:11px;padding:13px 0}.ix-content{padding:20px 17px;min-height:250px}.ix-content h3{font-size:21px}.ix-grid{grid-template-columns:1fr;gap:22px}.ix-side{border-left:0;border-top:1px solid #b7cee51a;padding:18px 0 0}.ix-cards{grid-template-columns:1fr}.ix-footer{padding:14px 17px}.ix-footer div{gap:14px}#ix-notice{margin:0 17px 15px}.ix-asset{grid-template-columns:minmax(0,1fr) 90px}.ix-asset input{font-size:26px!important}.ix-dialog label{font-size:11px}.ix-feed{max-height:300px}.ix-composer{grid-template-columns:1fr}.ix-row{gap:9px}.ix-content .ix-small{font-size:9px!important}.ix-fact{font-size:11px}#instrument-open{padding:8px 7px;font-size:6px}.scene-toolbar{gap:4px}}

/* Narrowly scoped overrides of inherited dialog labels; the original stays untouched. */
.ix-dialog .ix-context label{margin:0;font:10px/1.4 var(--mono);letter-spacing:.3px}
.ix-dialog .ix-content label:not(.ix-check){margin:14px 0 7px;font:11px/1.6 var(--sans);letter-spacing:0}
.ix-dialog .ix-content .ix-check{margin:16px 0;display:flex;align-items:center;font:12px/1.7 var(--sans);letter-spacing:0}
.ix-dialog .ix-header{position:sticky;top:-25px;z-index:3;background:#090d15;padding-top:12px;padding-bottom:12px}
@media(max-width:650px){.ix-dialog .ix-header{top:-18px}.ix-dialog .ix-context label{font-size:9px}}
/* 1.6: quiet operating views, not a replacement body. */
.op-heading{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:15px}.op-heading h3{margin:9px 0 0}.op-heading .ix-button{flex-shrink:0}.op-edition{margin:14px 0}.op-edition header,.ix-card>header{display:flex;align-items:center;justify-content:space-between;gap:12px}.op-edition header small,.ix-card>header small{font-size:10px;color:#99a8ba}.op-empty{padding:30px 22px;border:1px dashed #b6d3dc30;border-radius:12px;margin:18px 0;background:#a0d9e903}.op-empty>span{font:36px var(--mono);color:#b6dbe452}.op-empty h4{font-size:19px!important;margin:12px 0}.op-count{font:32px var(--mono);color:#b1d9df}.op-lab-tabs{display:flex;gap:6px;overflow-x:auto;margin:20px 0;padding:4px 0 12px}.op-lab-tabs .ix-button{white-space:nowrap;flex-shrink:0}.op-experimental{color:#e4c497!important}.ix-card pre{max-height:240px;font-size:10px}.ix-tabs{scrollbar-width:thin}.ix-side h4{margin-top:10px}@media(max-width:650px){.op-heading{display:block}.op-heading>.ix-button{margin-top:14px}.op-empty{padding:20px 15px}.op-edition header{align-items:flex-start;flex-direction:column}.op-heading h3{font-size:23px}.ix-tabs button{padding:12px 14px}}
.op-heading>.ix-button{width:auto!important;max-width:100%;margin:0}.ix-grid>section>.op-heading{display:block}.ix-grid>section>.op-heading>.ix-button{margin-top:14px}.ix-grid>aside>.ix-button{margin:6px 6px 0 0}.op-heading>div{min-width:0}.op-edition .ix-flow{flex-wrap:wrap}
/* An active laboratory tab is a tab, not a full-width submit action. */
.op-lab-tabs{flex-wrap:wrap;overflow:visible;gap:6px}
.op-lab-tabs .ix-button{width:auto!important;flex:1 1 135px;min-width:0;white-space:nowrap;margin:0;padding:11px 10px}
/* Additive journal. The successful optical presentation remains the body. */
.mem-trade{margin:20px 0;padding:14px 16px;border:1px solid #8af1ff35;border-radius:12px;background:#8af1ff05}.mem-trade summary{color:#b8eef1;cursor:pointer;font-size:13px}.mem-editor{padding-top:16px}.mem-editor textarea{width:100%;min-height:70px;font:14px/1.65 var(--sans);background:#060b14;border:1px solid #abc5de35;border-radius:8px;padding:12px;resize:vertical}.mem-editor details{padding:14px 0}.mem-editor .ix-row{align-items:start}.mem-editor input[type=password],#mem-unlock-pass{width:100%;background:#060b14;border:1px solid #abc5de35;padding:12px;border-radius:8px;font:14px var(--sans)}.mem-heading{max-width:700px}.mem-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 22px;margin:14px 0 22px}.mem-stats .ix-fact{gap:12px}.mem-note{border-left:2px solid #a5dbe7}.mem-excerpt{white-space:pre-wrap;overflow-wrap:anywhere}.mem-body{display:grid;gap:18px;padding:20px 0}.mem-body section{padding-left:16px;border-left:1px solid #93cadd45}.mem-body p{white-space:pre-wrap;overflow-wrap:anywhere}.mem-body h4{font-size:12px;letter-spacing:.3px;color:#a4c6d1;margin-bottom:7px}.mem-timeline{display:grid;gap:7px;margin-top:22px;max-height:280px;overflow:auto}.mem-timeline .ix-button{text-align:lef