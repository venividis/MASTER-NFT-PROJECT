</div>`;}
function memTradeEditor(){return `<details class="mem-trade"><summary>Remember why · optional trading journal</summary>${memEditor(true)}</details>`;}
function memBinding(n){return ixEngine.mem.bindings.find(b=>b.entry===n.header.id);}
function memBodyFor(n){return n.payload.mode==='public'?n.payload.body:memUnlocked.get(n.digest);}
function memNoteCard(n){const h=n.header,b=memBodyFor(n),binding=memBinding(n),refs=ixEngine.mem.entries.filter(x=>x.header.parent===h.id);return `<article class="ix-card mem-note"><div class="ix-inline"><h4>${esc(b?.title|| (h.phase==='before'?'Decision before a swap':h.phase==='reflection'?'A later reflection':'A memory'))}</h4><span class="ix-tag">${n.payload.mode==='public'?'PUBLIC':b?'DECRYPTED HERE':'ENCRYPTED'}</span></div><p class="ix-small">${esc(personLabel(h.author))} · artifact #${h.identity} · custody ${h.epoch} · ${when(h.time)} · ${h.phase}</p><p class="mem-excerpt">${b?esc((b.thesis||b.lesson).slice(0,200)):'Only the body is locked. Its context and commitment are inspectable.'}</p>${binding?`<p class="ix-small">Linked successful local swap #${binding.receipt} · ${money(binding.result.received,binding.result.asset)}</p>`:''}<div class="ix-actions">${B('mem-open','Read & compare →',h.id)}${refs.length?`<span class="ix-small">${refs.length} later reflection${refs.length>1?'s':''}</span>`:''}</div></article>`;}
function memPage(){memCheckSession();if(memOpen)return memReadPage();const w=W(),own=ixEngine.mem.entries.filter(n=>n.header.author===w.s.actor),trades=w.s.events.filter(e=>e.kind==='SWAPPED'&&e.actor===w.s.actor),before=own.filter(n=>n.header.phase==='before'),reviewed=before.filter(n=>own.some(r=>r.header.parent===n.header.id));const notes=own.filter(n=>{const b=memBodyFor(n);return(memMode==='all'||memMode==='review'?memMode!=='review'||n.header.phase==='before'&&!own.some(r=>r.header.parent===n.header.id):n.header.phase===memMode)&&(!memQuery||b&&stable(b).toLowerCase().includes(memQuery.toLowerCase()));});
 const invalidations=before.map(memBodyFor).filter(Boolean).filter(b=>b.invalidation).length,readable=before.filter(n=>memBodyFor(n)).length;
 return `<div class="mem-heading"><span class="ix-kicker">MEMORY / DECISIONS, NOT JUST TRANSACTIONS</span><h3>Remember what you knew then.</h3><p>Keep the reason before an action and the reflection after it. Neither overwrites the other.</p></div><div class="mem-stats">${fact('Recorded swaps',trades.length)}${fact('With a before-note',before.length)}${fact('Reviewed decisions',reviewed.length+' / '+before.length)}${fact('Invalidation recorded',invalidations+' / '+readable+' readable notes')}</div>
 <div class="ix-actions">${B('mem-new','Write any memory →')}${B('mem-form','Explore lived form →')}${B('mem-lock','Lock private bodies')}${B('mem-export-fills','Export execution CSV')}</div><p class="ix-small">Process statistics, not a profitability score. No current prices, tax basis, gas valuation, portfolio P&L, or guaranteed improvement are inferred.</p>
 <div class="ix-row"><div class="ix-field"><label for="mem-search">Search readable bodies</label><input id="mem-search" value="${esc(memQuery)}" placeholder="Thesis, tags, lesson…"></div><div class="ix-field"><label for="mem-filter">View</label><select id="mem-filter">${[['all','All my memories'],['before','Before a swap'],['memory','General memories'],['reflection','Reflections'],['review','Awaiting reflection']].map(([v,n])=>`<option value="${v}" ${memMode===v?'selected':''}>${n}</option>`).join('')}</select></div></div>
 <p class="ix-small">Private search works only on bodies explicitly decrypted in this session. You are viewing ${esc(personLabel(w.s.actor))}'s journal; changing the demo persona is not authentication.</p><div class="ix-stack">${notes.length?notes.slice().reverse().map(memNoteCard).join(''):'<div class="ix-card"><h4>A record begins with one honest sentence.</h4><p>Use “Remember why” inside Trade, or write a memory here without moving any money.</p></div>'}</div>`;}
function memReadPage(){const n=ixEngine.entry(memOpen),h=n.header,b=memBodyFor(n),bind=memBinding(n),r=bind?W().s.events.find(e=>e.seq===bind.receipt):null;return `${B('mem-back','← My journal')}<h3>${esc(b?.title||'A preserved moment.')}</h3>${fact('Authored by',esc(personLabel(h.author)))}${fact('Artifact / custody at inscription','#'+h.identity+' / '+h.epoch)}${fact('Recorded local time',when(h.time))}${fact('Phase',h.phase)}<span class="ix-code">${esc(n.digest)}</span>
 ${!b?`<form id="mem-unlock-form"><label for="mem-unlock-pass">Memory passphrase</label><input id="mem-unlock-pass" type="password" autocomplete="current-password"><button class="ix-button primary" type="submit">Decrypt on this device →</button></form><p class="ix-small">No server receives this passphrase. A compromised browser can still read an unlocked memory. Lost passphrases cannot be reset.</p>`:`<div class="mem-body">${Object.entries(b).filter(([,v])=>v).map(([k,v])=>`<section><h4>${esc({thesis:'What I thought',exitPlan:'Exit / review plan',invalidation:'What would invalidate this',risk:'Planned risk',feeling:'Self-described feeling',lesson:'Lesson'}[k]||k)}</h4><p>${esc(v)}</p></section>`).join('')}</div>`}
 ${r?`<hr class="ix-divider"><h4>What actually happened in the rehearsal</h4>${fact('Provided',money(r.data.amount,r.data.input))}${fact('Received',money(r.data.received,r.data.output))}${fact('Linked receipt','#'+r.seq)}${fact('Output lock',r.data.lock?'#'+r.data.lock:'None')}<span class="ix-code">${esc(r.digest)}</span><p class="ix-small">The note was appended before execution within one atomic local operation. It is not an earlier blockchain timestamp or evidence that a decision was good.</p>`:''}
 <div class="ix-actions">${h.author===W().s.actor?B('mem-reflect','Add a reflection →',h.id):''}${B('trace','Inspect inscription receipt',n.event)}${B('mem-form-at','View this activity layer',n.event)}</div><p class="ix-small">Reflections append. They cannot silently edit this moment. Personal plaintext and decryption keys are never automatically transferred with the artifact.</p><div class="ix-stack">${ixEngine.mem.entries.filter(x=>x.header.parent===h.id).map(memNoteCard).join('')}</div>`;}
function memWritePage(){return `${B('mem-back','← My journal')}<h3>${memParent?'A reflection, not a rewrite.':'Keep a moment.'}</h3><p>${memParent?'The original entry stays untouched. This note is authored now, under your original authorship.':'An idea, a lesson, a milestone, or a personal memory. No trade is necessary.'}</p><form id="mem-write-form">${memEditor()}<button class="ix-button primary" type="submit">Review the inscription →</button></form>`;}
function memFormPage(){const live=ixEngine.form(),at=memFormThrough===null?live:ixEngine.form(undefined,memFormThrough);return `<span class="ix-kicker">LIVED FORM / DETERMINISTIC LOCAL HISTORY</span><h3>The same organism. A life of its own.</h3><p>Its density domain, axis proportions, angular folds and twist now develop from typed activity. This is geometry and light structure—not a new mascot or just a hue change.</p><div class="ix-actions">${B('mem-toggle-form',memFormOriginal?'Return to lived form':'Compare original form')}${B('mem-present','Return to present')}${B('mem-watch','Close panel & watch')}</div>${fact('View',memFormOriginal?'Original optical field':memFormThrough===null?'Current lived form':'Historical activity layer · current base genome')}${fact('Contributing records',at.count)}<div class="mem-stats">${FORM_CHANNELS.map((k,i)=>fact(k,at.counts[i])).join('')}</div><span class="ix-code">History root ${esc(at.root)}</span><p class="ix-small">Amount and profit are not growth scores. Each category has diminishing influence; all deformation is bounded. Private text is never read to shape the body. A visual projection is not guaranteed unique and has no rarity or return promise.</p>
 <div class="mem-timeline">${B('mem-form-at','Before this chapter',ixEngine.mem.start)}${live.marks.slice(-100).reverse().map(m=>B('mem-form-at','#'+m.seq+' · '+esc(m.kind)+' · '+when(m.time),m.seq)).join('')}</div><p class="ix-small">This chapter begins when v1.7 opens or an older archive is explicitly imported. It does not secretly reinterpret earlier activity. This timeline replays the activity layer on the current base genome; manual Evolve snapshots remain in the original History. The original audit remains separate. Viewing an older form does not roll back any asset or permission.</p>`;}
async function memSealDraft(phase,plan=null){const sessionEpoch=memSessionEpoch;const body=memGetBody(),mode=memVal('privacy'),pass=memVal('pass')||memSessionPass;if(!['encrypted','public'].includes(mode))throw Error('Select a visibility mode.');memDraft=structuredClone(body);const header=ixEngine.memoryHeader({phase,parent:phase==='reflection'?memParent:0,plan:plan?.digest||MEM_ZERO,form:!!ix$('#mem-imprint')?.checked});const payload=mode==='public'?{mode:'public',body}:await encryptMemory(header,body,pass);if(memSessionEpoch!==sessionEpoch||document.hidden||W().s.actor!==header.author||W().s.selected!==header.identity||W().s.now!==header.time)throw Error('The journal context changed while preparing encryption. Review again.');if(mode==='encrypted')memSession(pass);return memorySeal(header,payload);}
async function memPrepareTrade(plan){if(!memVal('thesis').trim())return planReview(plan);if(memWorking)return;memWorking=true;try{const n=await memSealDraft('before',plan);planReview(plan);ixReview.note=n;ixReview.memoryPrivate=n.payload.mode==='encrypted';ixReview.html+=`<hr class="ix-divider"><h4>Reason preserved with this trade</h4>${fact('Visibility',n.payload.mode==='encrypted'?'Encrypted body · key stays with you':'Public body · readable by everyone with the archive')}${fact('Form contribution',n.header.form?'Opaque commitment only':'None')}<p>${esc(memDraft.thesis)}</p><span class="ix-code">${esc(n.digest)}</span>`;draw();}finally{memWorking=false;}}
async function memSubmit(form){if(memWorking)return;memWorking=true;try{
 if(form==='mem-unlock-form'){const n=ixEngine.entry(memOpen),pass=memVal('unlock-pass'),sessionEpoch=memSessionEpoch,actor=W().s.actor;const body=await decryptMemory(n.header,n.payload,pass);if(memSessionEpoch!==sessionEpoch||document.hidden||W().s.actor!==actor||memOpen!==n.header.id)throw Error('The private session changed while decrypting. No body was opened.');memUnlocked.set(n.digest,body);memSession(pass);draw();notice('Decrypted locally. Lock private bodies to clear this session.');return;}
 if(form==='mem-write-form'){sourceCheck();const n=await memSealDraft(memParent?'reflection':'memory');simpleReview('Inscribe this moment.',n.payload.mode==='encrypted'?'Only encrypted body bytes enter the archive. The passphrase is not saved.':'This body is public in the local archive. Future public-chain storage would be permanently readable.',`<p>${esc(memDraft.thesis)}</p>${fact('Authored by',personLabel(n.header.author))}${fact('Phase',n.header.phase)}<span class="ix-code">${n.digest}</span>`,()=>{ixEngine.appendMemory(n);memOpen=n.header.id;memDraft=null;memParent=0;ixView='journal';});ixReview.memoryPrivate=n.payload.mode==='encrypted';return;}
 }finally{memWorking=false;}}
function memExportFills(){const rows=[['provenance','sequence','local_unix_seconds','artifact','author','input','input_raw','output','output_raw','receipt_digest','before_entry']];for(const e of W().s.events.filter(x=>x.kind==='SWAPPED'&&x.actor===W().s.actor)){const n=ixEngine.mem.bindings.find(x=>x.receipt===e.seq);rows.push(['UNSIGNED LOCAL REHEARSAL',e.seq,e.time,e.identity,e.actor,e.data.input,e.data.amount,e.data.output,e.data.received,e.digest,n?.entry||'']);}const csv=rows.map(r=>r.map(x=>'"'+String(x).replaceAll('"','""')+'"').join(',')).join('\r\n');const url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download='idfbi-local-executions.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),10000);}
async function memAction(act,id){if(act==='mem-new'){memParent=0;memDraft=null;memOpen=0;return nav('memory-write');}if(act==='mem-back'){memOpen=0;memParent=0;memDraft=null;return nav('journal');}if(act==='mem-open'){memOpen=Number(id);return nav('journal');}if(act==='mem-reflect'){const n=ixEngine.entry(id);if(n.header.author!==W().s.actor)throw Error('Only the original author can reflect.');W().select(n.header.identity);memParent=n.header.id;memDraft=null;return nav('memory-write');}if(act==='mem-lock'){memLock();draw();return notice('Private bodies and the session passphrase were cleared. Encrypted exports are unchanged.');}if(act==='mem-export-fills')return memExportFills();if(act==='mem-form')return nav('form');if(act==='mem-form-at'){memFormThrough=Number(id);memFormOriginal=false;nav('form');return;}if(act==='mem-present'){memFormThrough=null;memFormOriginal=false;return draw();}if(act==='mem-toggle-form'){memFormOriginal=!memFormOriginal;return draw();}if(act==='mem-watch'){ix$('#instrument-dialog').close();return;}throw Error('Unknown memory action.');}
function memAfterDraw(){memCheckSession();const q=ix$('#mem-search');if(q)q.addEventListener('change',()=>{memQuery=q.value;draw();});const f=ix$('#mem-filter');if(f)f.addEventListener('change',()=>{memMode=f.value;draw();});if(ixView==='trade'&&!ixReview){ix$('#ix-trade-form .primary').insertAdjacentHTML('beforebegin',memTradeEditor());}memorySyncField();}

/* Versioned visual projection, NOT an account state transition. */
let lifeReady=false,lifeInstalling=false,lifeLast='',lifeTarget=Array(8).fill(0),lifeCurrent=Array(8).fill(0),lifeStamp=0,lifeDescriptor=null,lifeProjectionKey='';
const lifeWorker=`let e;onmessage=async({data:d})=>{try{if(d.init){e=(await WebAssembly.instantiate(d.wasm,{math:{sin:Math.sin,cos:Math.cos,exp:Math.exp,pow:Math.pow,atan2:Math.atan2}})).instance.exports;postMessage({ready:true});return;}const start=performance.now();d.params.forEach((v,i)=>e.set_param(i,v));if(!e.render_region(d.w,d.h,d.center,d.y0,d.y1))throw Error('Invalid framebuffer region');const rgba=new Uint8ClampedArray(e.memory.buffer,e.buffer_ptr(),d.w*(d.y1-d.y0)*4).slice();postMessage({rgba,w:d.w,h:d.h,y0:d.y0,y1:d.y1,ms:performance.now()-start,seq:d.seq},[rgba.buffer]);}catch(e){postMessage({error:e.message});}};`;
async function memoryInstallField(){
 const r=window.__idfbi?.renderer;if(lifeInstalling||lifeReady||!r||(!r.gl&&!r.cpuReady))return;lifeInstalling=true;
 try{
  const oldUniforms=r.uniforms.bind(r);r.uniforms=function(){const p=oldUniforms(),now=performance.now(),dt=Math.min(.10,(now-(lifeStamp||now))/1000);lifeStamp=now;let moving=false;lifeCurrent=lifeCurrent.map((x,i)=>{const y=this.motion?x+(lifeTarget[i]-x)*(1-Math.exp(-dt*1.5)):lifeTarget[i];if(Math.abs(y-lifeTarget[i])>.00001)moving=true;return y;});for(let i=0;i<8;i++)p[23+i]=lifeCurrent[i];if(moving)this.dirty=true;return p;};
  if(r.gl){const oldProgram=r.program;r.program=r.makeProgram(LIVED_ASSETS.shader);r._approvedProgram=oldProgram;const oldDraw=r.drawGL.bind(r);r.drawGL=function(){if(!this.original){const gl=this.gl,pr=this.program;gl.useProgram(pr.pr);gl.uniform4fv(gl.getUniformLocation(pr.pr,'life0'),this.params.slice(23,27));gl.uniform4fv(gl.getUniformLocation(pr.pr,'life1'),this.params.slice(27,31));}oldDraw();};r.backend='WebGL 2 · lived field';}
  else{
   r.workers?.forEach(w=>w.terminate());r.workers=[];r.cpu=null;r.cpuBusy=false;r.cpuReady=false;r.cpuJob=null;r.sequence++;r.acceptedSequence=r.sequence;
   const bytes=Uint8Array.from(atob(LIVED_ASSETS.wasm),c=>c.charCodeAt(0));
   try{const count=Math.min(4,Math.max(1,(navigator.hardwareConcurrency||2)-1)),url=URL.createObjectURL(new Blob([lifeWorker],{type:'text/javascript'}));let ready=0;
    for(let i=0;i<count;i++){const w=new Worker(url);r.workers.push(w);w.onerror=e=>{r.cpuReady=false;r.cpuBusy=false;r.notify('Lived field worker unavailable: '+e.message);};w.onmessage=({data:d})=>{if(d.ready){if(++ready===count)r.cpuReady=true;return;}if(d.error){r.cpuBusy=false;r.notify(d.error);return;}const j=r.cpuJob;if(!j||d.seq!==j.seq)return;j.rgba.set(d.rgba,d.y0*d.w*4);j.done++;if(j.done===count){r.cpuBusy=false;r.cpuMs=performance.now()-j.start;r.acceptCPU({...j,ms:r.cpuMs});}};const copy=bytes.slice();w.postMessage({init:true,wasm:copy.buffer},[copy.buffer]);}URL.revokeObjectURL(url);r.backend='WASM lived optical field';
   }catch{r.workers?.forEach(w=>w.terminate());r.workers=null;r.cpu=(await WebAssembly.instantiate(bytes,{math:{sin:Math.sin,cos:Math.cos,exp:Math.exp,pow:Math.pow,atan2:Math.atan2}})).instance.exports;r.cpuReady=true;r.backend='WASM main-thread lived field';}
  }
  const oldInit=r.init.bind(r);r.init=function(){oldInit();if(this.gl){this.program=this.makeProgram(LIVED_ASSETS.shader);this.backend='WebGL 2 · lived field';}else{lifeReady=false;}};
  lifeReady=true;r.dirty=true;r.lastJob=0;r.notify(r.backend);
 }catch(e){console.error(e);r.notify('Lived form unavailable: '+e.message);}finally{lifeInstalling=false;}
}
function memorySyncField(){if(!window.__idfbi||!ixEngine?.mem)return;const original=window.__idfbi,blocked=original.chain()||original.state().root!==original.world().state.root;const projectionKey=[ixEngine.mem.origin,ixEngine.mem.start,W().s.selected,W().s.head,memFormThrough].join('|');if(projectionKey!==lifeProjectionKey){lifeDescriptor=ixEngine.form(undefined,memFormThrough===null?W().s.seq:memFormThrough);lifeProjectionKey=projectionKey;}const descriptor=lifeDescriptor;
 const key=[descriptor.root,memFormOriginal,!!blocked].join('|');if(key!==lifeLast){lifeLast=key;lifeTarget=memFormOriginal||blocked?Array(8).fill(0):descriptor.traits.slice();const r=original.renderer;r.dirty=true;r.lastJob=0;}
 let badge=ix$('#life-badge');if(!badge){badge=document.createElement('button');badge.id='life-badge';badge.type='button';badge.addEventListener('click',()=>{nav('form');ix$('#instrument-dialog').showModal();});document.body.append(badge);}
 badge.textContent=blocked?'ORIGINAL HISTORY / LOCAL LIFE NOT APPLIED':memFormOriginal?'ORIGINAL FORM · COMPARE':(memFormThrough===null?'LIVED FORM':'PAST LIVED FORM')+' / '+descriptor.count+' TRACES';
 badge.title='Inspect activity, compare the original, and revisit earlier forms';badge.hidden=!!original.chain();
 memoryInstallField();
}
setInterval(()=>{if(window.__instruments){memorySyncField();if(memCheckSession())draw();}},400);

document.addEventListener('visibilitychange',()=>{if(document.hidden&&window.__instruments){memLock();if(['journal','memory-write','trade'].includes(ixView))draw();}});

})();</script>
</body></html>
