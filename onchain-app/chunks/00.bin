ottom:0}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
.reference-dialog{width:100vw;max-width:100vw;height:100svh;max-height:100svh;padding:0;border:0;border-radius:0;background:#05050a;overflow:hidden}.reference-dialog iframe{width:100%;height:100%;border:0}.reference-back{position:absolute;left:50%;top:100px;transform:translateX(-50%);z-index:20;background:#111321f0!important;border-color:#9ef9ff88!important;color:#e0ffff!important;font-size:11px!important;padding:13px 18px!important}.reference-dialog::backdrop{background:#05050a}.detail-row{display:flex;gap:16px;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line);font-size:11px;overflow-wrap:anywhere}.detail-row span{color:var(--muted)}.detail-row b{font-weight:400;max-width:68%;text-align:right}.detail-row+button,#detail-content button{margin:8px 8px 0 0}#detail-content pre{max-height:310px;overflow:auto;white-space:pre-wrap;word-break:break-all;font:10px/1.7 ui-monospace,monospace;color:#b8e0ee;background:#070a10;padding:14px;border:1px solid var(--line);border-radius:9px}.satellite{background:transparent;position:fixed;width:42px;height:42px;transform:translate(-50%,-50%);border:1px solid transparent;border-radius:50%;color:transparent;pointer-events:auto;cursor:pointer;z-index:5}.satellite:hover,.satellite:focus-visible{border-color:#ffc69088;color:#ffedc4;background:#20152377}.busy .command-button{opacity:.5}
</style></head>
