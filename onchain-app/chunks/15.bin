nchor))}</span><p class="ix-small">This review is for a local rehearsal. It is not a signature, a verified proof, a live quote, or a transaction submitted to a blockchain.</p><div class="ix-actions">${B('confirm','Apply in rehearsal →','','primary')}${B('cancel-review','Keep editing')}</div>`;}
function simpleReview(title,description,html,fn){sourceCheck();ixReview={title,description,html,fn,anchor:anchor(),state:ixEngine.export().checksum};draw();}
function planReview(p){ixReview={title:p.intent.kind==='GIFT'?'Review a gift with consent.':p.intent.kind==='LOCK'?'Review this time commitment.':'Review the exact outcome.',description:'Nothing changes until you apply this review.',anchor:p.anchor,plan:p,html:`<div class="ix-flow">${p.preview.steps.map((s,i)=>(i?'<b>→</b>':'')+'<span>'+s+'</span>').join('')}</div>${fact('Provide',money(p.intent.amount,p.intent.input))}${fact('Model result',money(p.preview.received,p.preview.asset))}${fact('Minimum received',money(p.intent.minOut,p.intent.output))}${p.preview.recipient?fact('Recipient',p.preview.recipient.kind==='person'?personLabel(p.preview.recipient.id)+' · personal wallet':'Artifact #'+p.preview.recipient.id+' account'):''}${p.preview.acceptBy?fact('Acceptance deadline',when(p.preview.acceptBy)):''}${p.preview.releaseAt?fact('Fixed release date',when(p.preview.releaseAt)):''}${fact('Review expires',when(p.deadline))}<span class="ix-code">Plan ${esc(p.digest)}</span>`};draw();}
function modalForm(title,html,id){ix$('#ix-content').innerHTML=`<h3>${title}</h3><form id="${id}" style="margin-top:20px">${html}<button type="submit" class="ix-button primary">Review →</button></form>`;}
async function action(act,id){const w=W();if(act.startsWith('mem-'))return memAction(act,id);if(act.startsWith('op-'))return opAction(act,id);
 if(act==='tab')return nav(id);
 if(act==='cancel-review'){ixReview=null;return draw();}
 if(act==='confirm'){const r=ixReview;if(!r)return;return perform(()=>{if(r.plan){if(r.note)ixEngine.executeNoted(r.plan,anchor(),r.note);else ixEngine.execute(r.plan,anchor());memDraft=null;}else{if(anchor()!==r.anchor||ixEngine.export().checksum!==r.state)throw Error('The reviewed state changed. Open a new review.');r.fn();}},'Applied locally. Open Receipts to inspect the recorded outcome.',!!r.replaceCorrupt);}
 if(['capabilities','clock','receipts'].includes(act))return nav(act);
 if(act==='export'){saveFile({schema:'idfbi/instrument-file/1.7',originSeed:ixSeed,originAudit:anchor(),engine:ixEngine.export()},'idfbi-instruments-rehearsal.json');return;}
 if(act==='import'){ix$('#ix-import').click();return;}
 if(act==='trace'){ixView='receipts';ixInspect=Number(id);ixReview=null;draw();return;}
 if(act==='discuss'){ixReceipt=Number(id);ixReply=0;ixView='world';ixRoom=1;draw();ix$('#ix-message').focus();return;}
 if(act==='clear-reply'){ixReceipt=0;ixReply=0;draw();return;}
 if(act==='reply'){ixReply=Number(id);ixReceipt=0;draw();ix$('#ix-message').focus();return;}
 if(act==='react')return perform(()=>w.react(Number(id),'♡'),'Reaction updated locally.');
 if(act==='open-room'){ixRoom=Number(id);return nav('world');}
 if(act==='inspect-estate'){ixInspect=Number(id);ixView='market';ixReview=null;draw();return;}
 if(act==='cancel-listing')return simpleReview('Cancel this listing.','Control returns to the recorded seller. No sale occurs.',fact('Listing',esc(id)),()=>w.cancel(Number(id)));
 if(act==='market-back'){ixInspect=0;draw();return;}
 if(act==='advance')return simpleReview('Advance only the rehearsal clock.', 'This is a model mutation, not a projection.',fact('Move forward',Number(id)/DAY+' days')+fact('New time',when(w.s.now+Number(id))),()=>w.advance(Number(id)));
 if(act==='accept-gift'){const g=ixEngine.gift(id);return simpleReview('Accept this gift.','Acceptance makes the gift non-recallable and fixes the release date.',fact('Amount',money(g.amount,g.asset))+fact('Release',when(g.releaseAt))+fact('Recipient',esc(recipient(g))),()=>ixEngine.accept(id));}
 if(act==='return-gift')return simpleReview('Return the pending offer.','The assets return only to the donor artifact account.',fact('Gift',esc(id)),()=>ixEngine.cancel(id));
 if(act==='release-gift')return simpleReview('Release to the beneficiary.','The caller cannot redirect this payment.',fact('Recipient',esc(recipient(ixEngine.gift(id)))),()=>ixEngine.releaseGift(id));
 if(act==='release-lock')return simpleReview('Release the available amount.','The fixed beneficiary receives it. The original schedule does not change.',fact('Lock',esc(id)),()=>w.release(Number(id)));
 if(act==='contribute'||act==='withdraw-contribution'){ixInspect=Number(id);modalForm(act==='contribute'?'Contribute to '+esc(w.sale(id).symbol):'Withdraw before closing.',field('ETH amount','contribution','1'),act==='contribute'?'ix-contribute-form':'ix-withdraw-form');return;}
 if(act==='close-sale-clock'){const s=w.sale(id);return simpleReview('Advance to the sale close.','Only the local test clock changes. No settlement occurs automatically.',fact('Close',when(s.closes)),()=>w.advance(s.closes-w.s.now));}
 if(act==='settle')return simpleReview('Settle against the committed terms.','A successful sale creates its market and locks; a failed sale enables refunds.',fact('Launch',esc(w.sale(id).symbol)),()=>w.settle(id));
 if(act==='claim')return simpleReview('Claim the allocation or refund.','Claiming twice is rejected.',fact('Launch',esc(w.sale(id).symbol)),()=>w.claim(id));
 if(act==='buy'){const l=w.checkListing(id);return simpleReview('Acquire artifact #'+l.identity+'.','The declared contents are checked again. Historical authorship and release schedules are not rewritten.',fact('Rehearsal wallet pays',money(l.price,'ETH'))+fact('Current wallet balance',money(w.s.wallets[w.s.actor],'ETH'))+`<span class="ix-code">${esc(l.manifest)}</span>`,()=>w.buy(l.id,l.manifest));}
 if(act==='list-estate'){modalForm('List artifact #'+id+'.',field('Ask · ETH','price','5')+field('Listing duration · days','listing-days',7,'number'),'ix-list-form');return;}
 if(act==='presence'){modalForm('Use without spending authority.',`<p>The other rehearsal persona receives a temporary presence grant, not treasury control.</p>${field('Days','presence-days',1,'number')}`,'ix-presence-form');return;}
 if(act==='follow'||act==='block')return perform(()=>w.view(id,act),'Your personal view changed. Nobody lost World access.');
 if(act==='invite')return perform(()=>w.invite(ixRoom,id),'Invitation created. The recipient must accept it.');
 if(act==='accept-room')return perform(()=>w.accept(Number(id)),'Room invitation accepted.');
 if(act==='remove-member')return simpleReview('Remove future posting access.','Old messages remain. This does not revoke World access.',fact('Member',personLabel(id)),()=>w.remove(ixRoom,id));
 if(act==='new-room'){modalForm('A room with its own rules.',field('Room name','room-name','A conversation')+'<label class="ix-check"><input id="ix-gated" type="checkbox"> Invitation-only posting (not private reading)</label>','ix-room-form');return;}
 if(act==='room-settings'){const r=w.room(ixRoom);modalForm('Configure this room.',field('Name','room-name',r.name)+field('Topic','topic',r.topic)+field('Slow mode · seconds','slow',r.slow,'number')+field('Room accent','room-color',r.color,'color')+`<label class="ix-check"><input id="ix-gated" type="checkbox" ${r.gated?'checked':''}> Invitation-only posting</label>`,'ix-settings-form');return;}
}
async function compose(kind){const a=input('input'),b=kind==='LOCK'?a:input('output'),n=wei(input('amount'));const q=a===b?{out:n}:W().quote(a,b,n);let days=kind==='LOCK'||kind==='GIFT'?Number(input('days')):ix$('#ix-autolock').checked?Number(input('days')):0;const min=kind==='LOCK'?n:q.out*BigInt(10000-Number(input('slip')))/10000n;let r=null;if(kind==='GIFT'){const [k,v]=input('recipient').split(':');r={kind:k,id:k==='artifact'?Number(v):v};}sourceCheck();const p=ixEngine.prepare({kind,input:a,output:b,amount:n.toString(),minOut:min.toString(),days,recipient:r},anchor());if(kind==='SWAP')return memPrepareTrade(p);planReview(p);}
async function submit(form){if(form.startsWith('mem-'))return memSubmit(form);const w=W();if(form.startsWith('op-'))return opSubmit(form);
 if(form==='ix-trade-form')return compose('SWAP');if(form==='ix-give-form')return compose('GIFT');if(form==='ix-lock-form')return compose('LOCK');
 if(form==='ix-launch-form'){const terms={name:input('name'),symbol:input('symbol'),supply:wei(input('supply')),soft:wei(input('soft')),hard:wei(input('hard')),hours:Number(input('hours')),founderBps:Number(input('founder')),liquidityBps:Number(input('liquidity'))};const temp=KingdomModel.restore(w.export()),s=temp.createLaunch(terms);return simpleReview('Review '+s.symbol+' before it exists.','No allocation can be changed after creation in this model.',fact('Name',esc(s.name))+fact('Total supply',money(s.supply,s.symbol))+fact('Public allocation',format(s.public))+fact('Seed allocation',format(s.lp))+fact('Founder vesting',format(s.founder))+fact('Raise range',money(s.soft,'ETH')+' – '+money(s.hard,'ETH')),()=>w.createLaunch(terms));}
 if(form==='ix-contribute-form'||form==='ix-withdraw-form'){const n=wei(input('contribution')),sale=ixInspect;return simpleReview(form==='ix-contribute-form'?'Review contribution.':'Review withdrawal.', 'Only the rehearsal treasury changes.',fact('Amount',money(n,'ETH')),()=>form==='ix-contribute-form'?w.contribute(sale,n):w.withdrawContribution(sale,n));}
 if(form==='ix-message-form'){const body=input('message'),r=ixReceipt,reply=ixReply;return perform(()=>{w.post(ixRoom,body,reply,r);ixReceipt=0;ixReply=0;},'Public rehearsal message recorded. It is not an encrypted message.');}
 if(form==='ix-list-form'){const n=wei(input('price')),days=Number(input('listing-days')),id=w.s.selected;return simpleReview('Escrow artifact #'+id+'.','The local operating manifest includes gifts, commitments, venues and isolated laboratory positions. Listing invalidates old grants. A material change requires a new seller manifest and buyer review.',fact('Ask',money(n,'ETH'))+fact('Duration',days+' days'),()=>w.listEstate(id,n,days));}
 if(form==='ix-presence-form'){const d=Number(input('presence-days')),id=w.s.selected,p=w.s.actor==='you'?'guest':'you';return simpleReview('Grant temporary presence.','No token spending permission is granted.',fact('User',personLabel(p))+fact('Duration',d+' days'),()=>w.grantPresence(id,p,d));}
 if(form==='ix-room-form'){const name=input('room-name'),gated=ix$('#ix-gated').checked;return simpleReview('Create this conversation.','Posting rules and readable content are different permissions.',fact('Room',esc(name))+fact('Posting',gated?'Invitation + acceptance':'Public'),()=>{ixRoom=w.createRoom(name,gated).id;});}
 if(form==='ix-settings-form'){const data={name:input('room-name'),topic:input('topic'),slow:Number(input('slow')),color:input('room-color'),gated:ix$('#ix-gated').checked};return simpleReview('Review room rules.','Changing these rules cannot rewrite earlier authors.',fact('Topic',esc(data.topic))+fact('Slow mode',data.slow+' seconds'),()=>w.configureRoom(ixRoom,data));}
}
function setupInstruments(){
 ixSeed=window.__idfbi.world().state.seed;ixStore='idfbi.instruments.1.7:'+ixSeed;ixEngine=new MemoryEngine(undefined,ixSeed);
 let raw=null;try{raw=localStorage.getItem(ixStore);}catch{notice('Browser storage is unavailable. Export this rehearsal to retain it.');}
 if(raw){ixStored=raw;try{const data=JSON.parse(raw);if(data.originSeed!==ixSeed||data.schema!=='idfbi/instrument-file/1.7')throw Error('Wrong identity');ixEngine=MemoryEngine.restore(data.engine,ixSeed);if(ixEngine.mem.origin!==ixSeed)throw Error('Memory origin mismatch.');}catch{ixCorrupt=true;notice('Saved instruments could not be loaded. Their bytes were not overwritten. Import a valid export to replace them explicitly.',true);}}
 const opener=document.createElement('button');opener.id='instrument-open';opener.className='quiet';opener.textContent='USE NFT ↗';opener.setAttribute('aria-haspopup','dialog');opener.addEventListener('click',()=>{draw();ix$('#instrument-dialog').showModal();});ix$('.scene-toolbar').append(opener);
 ix$('#ix-close').addEventListener('click',()=>ix$('#instrument-dialog').close());
 ix$('#instrument-dialog').addEventListener('close',()=>{ixReview=null;memDraft=null;opener.focus();});
 ix$('#instrument-dialog').addEventListener('click',e=>{const b=e.target.closest('[data-act]');if(b&&!b.disabled)Promise.resolve().then(()=>action(b.dataset.act,b.dataset.id)).catch(e=>notice(e.message,true));});
 ix$('#instrument-dialog').addEventListener('submit',e=>{e.preventDefault();Promise.resolve().then(()=>submit(e.target.id)).catch(e=>notice(e.message,true));});
 ix$('#instrument-dialog').addEventListener('input',e=>{if(e.target.id==='ix-future'){ixFuture=Number(e.target.value);ix$('#ix-future-label').textContent='+'+ixFuture+' days';ix$('#ix-future-balances').innerHTML=futureFacts(ixView==='market'?ixInspect:W().s.selected);}else if(['ix-amount','ix-input','ix-output','ix-slip'].includes(e.target.id)&&ix$('#ix-estimate'))updateEstimate();});
 ix$('#instrument-dialog').addEventListener('change',e=>{if(e.target.id==='ix-autolock')ix$('#ix-lock-duration').hidden=!e.target.checked;else if(e.target.id==='ix-actor'){memLock();W().setActor(e.target.value);ixReview=null;draw();notice('Testing as '+personLabel(W().s.actor)+'. No wallet account changed.');}else if(e.target.id==='ix-identity'){W().select(Number(e.target.value));memFormThrough=null;ixReview=null;draw();}else if(e.target.id==='ix-room'){ixRoom=Number(e.target.value);ixReply=0;ixReceipt=0;draw();}else if(e.target.id==='ix-filter'){ixFilter=e.target.value;draw();}});
 ix$('#ix-import').addEventListener('change',async e=>{try{const f=e.target.files[0];if(!f)return;if(f.size>67108864)throw Error('Archive exceeds the 64 MiB import limit.');const data=JSON.parse(await f.text());if(!['idfbi/instrument-file/1.5','idfbi/instrument-file/1.6','idfbi/instrument-file/1.7'].includes(data.schema)||data.originSeed!==ixSeed)throw Error('This archive belongs to a different organism.');const restored=MemoryEngine.restore(data.engine,ixSeed);if(restored.mem.origin!==ixSeed)throw Error('Memory origin mismatch.');simpleReview('Replace this local instrument archive?','The original organism and its history stay unchanged. Export the current instruments first to keep them.',fact('Records',restored.world.s.events.length),()=>{ixEngine=restored;ixRoom=1;ixInspect=0;});ixReview.replaceCorrupt=true;}catch(e){notice(e.message,true);}finally{e.target.value='';}});
 window.__instruments={version:'1.7.0',memory:()=>({ready:lifeReady,form:lifeDescriptor,original:memFormOriginal,through:memFormThrough}),engine:()=>ixEngine,view:()=>ixView,anchor,open:()=>opener.click(),catalog:IX_CATALOG};
 document.body.dataset.instrumentsReady='true';
}
const ixBoot=setInterval(()=>{if(window.__idfbi&&document.body.dataset.ready==='true'){clearInterval(ixBoot);try{setupInstruments();}catch(e){console.error(e);document.body.dataset.instrumentsError=e.message;}}},30);

/* Additive operating views. Every write uses the existing review/atomic/storage boundary. */
let opLabView='granary';
const opTitles={granary:'Strategy shares',issue:'Basket issuance',strips:'Matched rights',counter:'Fixed-term credit',scrivener:'Covered calls'};
function opLibraryPage(){const w=W(),a=w.identity(),o=ixEngine.op;return `<div class="ix-grid"><section><div class="op-heading"><div><span class="ix-tag">CODEX / CONTENT ≠ AUTHORITY</span><h3>A library the artifact can use.</h3></div>${B('op-publish','Publish an edition →','','primary',a.owner!==w.s.actor)}</div><p>Describe an exact procedure. Adopt it as content. Authorize only its chosen caller, budget and lifetime. No uploaded JavaScript or arbitrary bytecode runs here.</p>${o.editions.length?o.editions.map(e=>{const installed=o.installations.find(x=>x.identity===a.id&&x.edition===e.id);return `<article class="ix-card op-edition"><header><span class="ix-tag">EDITION ${e.id} · ${esc(e.recipe.kind)}</span><small>by ${personLabel(e.author)}</small></header><h4>${esc(e.title)}</h4><div class="ix-flow"><span>${money(e.recipe.amount,e.recipe.input)}</span><b>→</b><span>${esc(e.recipe.kind)} · ${e.recipe.days} days</span></div><p class="ix-code">${esc(e.contentHash)}</p>${installed?fact('Installation',w.s.now<installed.readyAt?'Review until '+when(installed.readyAt):'Ready to request a grant'):''}<div class="ix-actions">${B('op-inspect-edition','Inspect',e.id)}${!installed?B('op-install','Adopt into library',e.id,'',a.owner!==w.s.actor):B('op-grant','Authorize a use',e.id,'primary',w.s.now<installed.readyAt||a.owner!==w.s.actor)}${B('op-collect','Create rehearsal collectible',e.id,'',a.owner!==w.s.actor)}${B('discuss','Discuss edition',e.receipt)}</div></article>`;}).join(''):`<div class="op-empty"><span>01</span><h4>One useful procedure, held permanently.</h4><p>Start with a reserve lock. The edition does not gain money permissions just because you published it.</p>${B('op-publish','Create the first edition','','primary',a.owner!==w.s.actor)}</div>`}</section><aside><h4>Current execution grants</h4>${o.grants.filter(g=>g.identity===a.id).map(g=>`<article class="ix-card"><span class="ix-tag">GRANT ${g.id} · ${esc(ixEngine.grantStatus(g))}</span><h4>${esc(ixEngine.edition(g.edition).title)}</h4>${fact('May trigger',personLabel(g.caller))}${fact('Remaining budget',money(BigInt(g.total)-BigInt(g.spent),ixEngine.edition(g.edition).recipe.input))}${fact('Calls',g.used+' / '+g.calls)}${fact('Expires',when(g.expires))}<div class="ix-actions">${B('op-run','Review execution',g.id,'primary',ixEngine.grantStatus(g)!=='active'||g.caller!==w.s.actor)}${B('op-revoke','Revoke now',g.id,'',g.revoked||a.owner!==w.s.actor)}</div></article>`).join('')||'<p class="ix-small">No active authority. Published content cannot spend.</p>'}<details open><summary>What survives a sale?</summary><p>Code, fixed obligations, and historical authorship survive. Old grants do not: listing and transfer change the custody epoch.</p><p class="ix-small">Seven-day installation review. Exact recipe. Bounded cumulative budget. Immediate revocation. Local rehearsal only.</p></details>${B('tab','Inspect all commitments →','ledger')}${B('op-applications','Application editions →')}</aside></div>`;}
function opWorkPage(){const a=W().identity();return `<div class="op-heading"><div><span class="ix-tag">PATRONAGE / EXPLICIT AGREEMENTS</span><h3>Turn a conversation into funded work.</h3></div>${B('op-commission','Fund a commission →','','primary',a.owner!==W().s.actor)}</div><p>A fixed worker, deliverable, deadline and reviewer. The reviewer is trusted to judge the work—not an AI oracle. A silent reviewer leads to the disclosed refund, not automatic payment.</p><div class="ix-cards">${ixEngine.op.commissions.map(c=>`<article class="ix-card"><header><span class="ix-tag">COMMISSION ${c.id} · ${esc(c.status)}</span><small>${money(c.amount,c.asset)}</small></header><h4>${esc(c.title)}</h4>${fact('Worker / reviewer',personLabel(c.worker)+' / '+personLabel(c.reviewer))}${fact('Submit before',when(c.deadline))}${fact('Review ends',when(c.reviewEnds))}${fact('Funding account','#'+c.identity)}${c.edition?fact('Delivered edition','#'+c.edition):''}<div class="ix-actions">${c.status==='offered'?B('op-accept-work','Accept terms',c.id,'primary',W().s.actor!==c.worker||W().s.now>=c.deadline):''}${c.status==='accepted'?B('op-submit-work','Submit your edition',c.id,'primary',W().s.actor!==c.worker||W().s.now>=c.deadline||!ixEngine.op.editions.some(e=>e.author===c.worker)):''}${c.status==='submitted'?B('op-approve-work','Accept & pay',c.id,'primary',W().s.actor!==c.reviewer||W().s.now>=c.reviewEnds)+B('op-reject-work','Reject & refund',c.id,'',W().s.actor!==c.reviewer||W().s.now>=c.reviewEnds):''}${['offered','accepted','submitted'].includes(c.status)?B('op-refund-work','Refund after timeout',c.id,'',W().s.now<(c.status==='submitted'?c.reviewEnds:c.deadline)):''}${B('discuss','Open discussion',c.receipt)}</div></article>`).join('')||`<div class="op-empty"><h4>A promise should carry its funding.</h4><p>Fund work for Guest, then switch to Guest and select artifact #2 to publish a deliverable. Nothing is posted in someone’s name automatically.</p></div>`}</div>`;}
function opLedgerPage(){const l=ixEngine.ledger(),m=l.modules;const cards=[['Committed gifts',m.gifts.filter(x=>['offered','accepted'].includes(x.status))],['Funded work',m.commissions.filter(x=>['offered','accepted','submitted'].includes(x.status))],['Operating venues',m.venues.filter(x=>x.status!=='closed')],['Laboratory cells',m.cells],['Credit obligations',m.loans.filter(x=>['offered','active'].includes(x.status))],['Covered options',m.options.filter(x=>['offered','active'].includes(x.status))]];return `<div class="ix-grid"><section><span class="ix-tag">ONE ARTIFACT / SEPARATE RIGHTS</span><h3>Know what is free. Know what is promised.</h3><p>These are native quantities, not a combined dollar valuation. Changing the owner does not change another person’s accepted deadline.</p><div class="ix-cards">${cards.map(([label,items])=>`<article class="ix-card"><h4>${label}</h4><strong class="op-count">${items.length}</strong><details><summary>Inspect records</summary><pre>${esc(JSON.stringify(items,null,2))}</pre></details></article>`).join('')}</div><h4 style="margin-top:24px">Authority is not an asset balance</h4>${l.activeGrants.map(g=>fact('Grant '+g.id,esc(g.status)+' · remaining '+format(g.remaining))).join('')||'<p>No spending grants.</p>'}</section><aside><h4>Available in the main account</h4>${balanceFacts()}<h4 style="margin-top:25px">Personal wallet · ${personLabel(W().s.actor)}</h4>${Object.entries(ixEngine.extra.personalBalances[W().s.actor]||{}).map(([k,v])=>fact(esc(k),money(v,k))).join('')||'<p class="ix-small">No personal gift or work proceeds.</p>'}<p class="ix-small">${esc(l.note)}</p>${B('op-manifest','Inspect complete module snapshot')}${B('tab','Whole-artifact market →','market')}${B('op-venues','Operate collectible shelves →')}</aside></div>`;}
function opVenuesPage(){const a=W().identity(),o=ixEngine.op;return `<div class="op-heading"><div><span class="ix-tag">BOURSE / FIXED-TERM SELL SHELVES</span><h3>The artifact can own the venue.</h3></div>${B('op-open-shelf','Open a shelf →','','primary')}</div><p>One local collectible, a fixed ETH ask, and a fixed bond date. Receipts and reserved sale proceeds follow the owning account. A bond promises neither a buyer nor a price floor.</p><div class="ix-cards">${o.venues.map(v=>`<article class="ix-card"><span class="ix-tag">SHELF ${v.id} · ${esc(v.status)}</span><h4>Collectible #${v.collectible} · edition #${opGet(o.collectibles,v.collectible).edition}</h4>${fact('Venue account','#'+v.identity)}${fact('Fixed ask',money(v.price,'ETH'))}${fact('Withdrawal date',when(v.bondUntil))}${fact('Reserved proceeds',money(