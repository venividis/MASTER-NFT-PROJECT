cord('LAB_RETURNED',a.id,{asset,amount:String(n)});});}
 sow(n,minShares=1n){return this.atomic(()=>{const c=this.labOwner('granary'),s=c.strategy;n=opQ(n);const shares=BigInt(s.shares)===0n?n:n*BigInt(s.shares)/BigInt(s.assets);if(shares<opQ(minShares)||shares===0n)throw Error('Minimum shares not met; zero-asset strategies cannot accept a deposit.');opTake(c.balances,s.asset,n);opAdd(s,'assets',n);opAdd(s,'shares',shares);this.record('STRATEGY_DEPOSIT',c.identity,{asset:s.asset,amount:String(n),shares:String(shares),cell:c.id});return shares;});}
 reap(shares,minAssets=1n){return this.atomic(()=>{const c=this.labOwner('granary',this.world.s.selected,false),s=c.strategy;shares=opQ(shares);if(shares>BigInt(s.shares))throw Error('Insufficient strategy shares.');const n=BigInt(s.assets)*shares/BigInt(s.shares);if(n<opQ(minAssets))throw Error('Minimum assets not met.');opAdd(s,'shares',-shares);opAdd(s,'assets',-n);opAdd(c.balances,s.asset,n);this.record('STRATEGY_WITHDRAW',c.identity,{asset:s.asset,amount:String(n),shares:String(shares)});return n;});}
 mintBasket(shares){return this.atomic(()=>{const c=this.labOwner('issue'),b=c.basket;shares=opQ(shares);const eth=ceilRatio(shares,wei('0.0001'),E18),aur=ceilRatio(shares,wei('10'),E18);opTake(c.balances,'ETH',eth);opTake(c.balances,'AUR',aur);opAdd(b,'ETH',eth);opAdd(b,'AUR',aur);opAdd(b,'supply',shares);this.record('BASKET_MINTED',c.identity,{shares:String(shares),ETH:String(eth),AUR:String(aur)});return {eth,aur};});}
 redeemBasket(shares){return this.atomic(()=>{const c=this.labOwner('issue',this.world.s.selected,false),b=c.basket;shares=opQ(shares);if(shares>BigInt(b.supply))throw Error('Insufficient basket shares.');const eth=shares*wei('0.0001')/E18,aur=shares*wei('10')/E18;opAdd(b,'supply',-shares);opAdd(b,'ETH',-eth);opAdd(b,'AUR',-aur);opAdd(c.balances,'ETH',eth);opAdd(c.balances,'AUR',aur);if(b.supply==='0'){opAdd(c.balances,'ETH',b.ETH);opAdd(c.balances,'AUR',b.AUR);b.ETH=b.AUR='0';}this.record('BASKET_REDEEMED',c.identity,{shares:String(shares)});return {eth,aur};});}
 strip(n,days=30){return this.atomic(()=>{const c=this.labOwner('strips');if(c.strip&&BigInt(c.strip.pairs)>0n)throw Error('Close this matched series before starting another.');n=opQ(n);opDays(days);opTake(c.balances,'AUR',n);c.strip={asset:'AUR',assets:String(n),pairs:String(n),initial:String(n),maturity:this.world.s.now+days*DAY};this.record('PAIRS_CREATED',c.identity,{amount:String(n),asset:'AUR',maturity:c.strip.maturity});});}
 unstrip(n){return this.atomic(()=>{const c=this.labOwner('strips',this.world.s.selected,false),s=c.strip;if(!s)throw Error('No matched series.');n=opQ(n);const out=matchedExit(s.assets,s.pairs,n);opAdd(s,'pairs',-n);opAdd(s,'assets',-out);opAdd(c.balances,s.asset,out);this.record('PAIRS_RECOMBINED',c.identity,{amount:String(n),received:String(out),asset:s.asset});return out;});}
 stress(module,bps){return this.atomic(()=>{const c=this.labOwner(module);if(!['granary','strips'].includes(module)||!Number.isInteger(bps)||bps<1||bps>10000)throw Error('Loss scenario must be 1–10,000 basis points.');const p=module==='granary'?c.strategy:c.strip;if(!p)throw Error('No funded position.');const n=BigInt(p.assets)*BigInt(bps)/10000n;opAdd(p,'assets',-n);opAdd(this.op.lossSink,p.asset,n);this.record('LAB_LOSS_SCENARIO',c.identity,{module,asset:p.asset,amount:String(n),note:'Explicit hypothetical loss; not market data.'});return n;});}
 requestLoan(collateral,principal,repayment,days=14){return this.atomic(()=>{const c=this.labOwner('counter');collateral=opQ(collateral);principal=opQ(principal);repayment=opQ(repayment);if(repayment<principal)throw Error('Repayment below principal.');opDays(days,365);opTake(c.balances,'AUR',collateral);const l={id:this.op.loans.length+1,borrower:c.identity,lender:0,collateral:String(collateral),principal:String(principal),repayment:String(repayment),days,offerUntil:this.world.s.now+7*DAY,due:0,status:'offered'};this.op.loans.push(l);this.record('CREDIT_REQUESTED',c.identity,{loan:l.id,amount:l.principal,asset:'ETH'});return l;});}
 fundLoan(id){return this.atomic(()=>{const c=this.labOwner('counter'),l=opGet(this.op.loans,id);if(l.status!=='offered'||c.identity===l.borrower||this.world.s.now>=l.offerUntil)throw Error('Credit offer unavailable.');opTake(c.balances,'ETH',l.principal);opAdd(this.cell(l.borrower).balances,'ETH',l.principal);l.lender=c.identity;l.due=this.world.s.now+l.days*DAY;l.status='active';this.record('CREDIT_FUNDED',c.identity,{loan:l.id,borrower:l.borrower,due:l.due});});}
 repayLoan(id){return this.atomic(()=>{const l=opGet(this.op.loans,id),c=this.labOwner('counter',l.borrower,false);if(l.status!=='active'||this.world.s.now>=l.due)throw Error('Repayment window has closed.');opTake(c.balances,'ETH',l.repayment);opAdd(this.cell(l.lender).balances,'ETH',l.repayment);opAdd(c.balances,'AUR',l.collateral);l.status='repaid';this.record('CREDIT_REPAID',c.identity,{loan:l.id});});}
 closeLoan(id){return this.atomic(()=>{const l=opGet(this.op.loans,id);if(l.status==='offered'){if(this.world.s.now<l.offerUntil)this.world._owner(l.borrower);opAdd(this.cell(l.borrower).balances,'AUR',l.collateral);l.status='cancelled';}else if(l.status==='active'&&this.world.s.now>=l.due){opAdd(this.cell(l.lender).balances,'AUR',l.collateral);l.status='defaulted';}else throw Error('No collateral release is available.');this.record('CREDIT_CLOSED',l.borrower,{loan:l.id,status:l.status});});}
 writeOption(underlying,strike,premium,days=14){return this.atomic(()=>{const c=this.labOwner('scrivener');opDays(days,365);underlying=opQ(underlying);strike=opQ(strike);premium=opQ(premium);opTake(c.balances,'AUR',underlying);const o={id:this.op.options.length+1,writer:c.identity,buyer:0,underlying:String(underlying),strike:String(strike),premium:String(premium),expiry:this.world.s.now+days*DAY,status:'offered'};this.op.options.push(o);this.record('OPTION_WRITTEN',c.identity,{option:o.id,expiry:o.expiry,asset:'AUR',amount:o.underlying});return o;});}
 takeOption(id){return this.atomic(()=>{const c=this.labOwner('scrivener'),o=opGet(this.op.options,id);if(o.status!=='offered'||c.identity===o.writer||this.world.s.now>=o.expiry)throw Error('Option not available.');opTake(c.balances,'ETH',o.premium);opAdd(this.cell(o.writer).balances,'ETH',o.premium);o.buyer=c.identity;o.status='active';this.record('OPTION_BOUGHT',c.identity,{option:o.id});});}
 exercise(id){return this.atomic(()=>{const o=opGet(this.op.options,id),c=this.labOwner('scrivener',o.buyer,false);if(o.status!=='active'||this.world.s.now>=o.expiry)throw Error('Exercise window closed.');opTake(c.balances,'ETH',o.strike);opAdd(this.cell(o.writer).balances,'ETH',o.strike);opAdd(c.balances,'AUR',o.underlying);o.status='exercised';this.record('OPTION_EXERCISED',c.identity,{option:o.id});});}
 closeOption(id){return this.atomic(()=>{const o=opGet(this.op.options,id);if(!['offered','active'].includes(o.status))throw Error('Option already closed.');if(this.world.s.now<o.expiry){if(o.status!=='offered')throw Error('Accepted cover remains locked until expiry.');this.world._owner(o.writer);}opAdd(this.cell(o.writer).balances,'AUR',o.underlying);o.status='closed';this.record('OPTION_CLOSED',o.writer,{option:o.id});});}
 registerApplication(title,hash,bytes){const a=this.world._owner(this.world.s.selected);if(!/^0x[0-9a-f]{64}$/.test(hash)||!Number.isInteger(bytes)||bytes<1||bytes>4000000)throw Error('Invalid application manifest.');const x={id:this.op.applications.length+1,identity:a.id,title:opText(title,96),hash,bytes,time:this.world.s.now};this.op.applications.push(x);this.record('APPLICATION_COMMITTED',a.id,{application:x.id,hash,bytes});return x;}
 moduleSnapshot(id){id=Number(id);return {version:'1.6',gifts:this.extra.gifts.filter(g=>g.donor===id||g.recipient.kind==='artifact'&&g.recipient.id===id),installations:this.op.installations.filter(x=>x.identity===id),grants:this.op.grants.filter(x=>x.identity===id),commissions:this.op.commissions.filter(x=>x.identity===id),collectibles:this.op.collectibles.filter(x=>x.holder===id),venues:this.op.venues.filter(x=>x.identity===id),cells:this.op.cells.filter(x=>x.identity===id),loans:this.op.loans.filter(x=>x.borrower===id||x.lender===id),options:this.op.options.filter(x=>x.writer===id||x.buyer===id),applications:this.op.applications.filter(x=>x.identity===id)};}
 _bindListing(l){const moduleRoot=fingerprint(this.moduleSnapshot(l.identity));const base=fingerprint({domain:'LOCAL_ESTATE_COVENANT_1_4',id:l.id,identity:l.identity,seller:l.seller,price:l.price,expires:l.expires,status:'listed',inventory:l.inventory});const manifest=fingerprint({domain:'IDFBI_OPERATING_COVENANT_1_6',base,moduleRoot});this.op.covenants[l.id]={moduleRoot,manifest,base};l.manifest=manifest;this.record('MANIFEST_BOUND',l.identity,{listing:l.id,moduleRoot,manifest},l.seller);}
 refreshListing(id){return this.atomic(()=>{const l=opGet(this.world.s.listings,id);if(l.status!=='listed'||l.seller!==this.world.s.actor||this.world.identity(l.identity).owner!=='escrow')throw Error('Only the listing seller may refresh declared contents.');l.inventory=this.world._inventorySnapshot(l.identity);this._bindListing(l);});}
 ledger(id=this.world.s.selected){const a=this.world.identity(id);return {identity:a.id,owner:a.owner,epoch:a.epoch,free:structuredClone(a.balances),projected:this.project(a.id,this.world.s.now),modules:structuredClone(this.moduleSnapshot(a.id)),activeGrants:this.op.grants.filter(g=>g.identity===a.id).map(g=>({id:g.id,status:this.grantStatus(g),remaining:String(BigInt(g.total)-BigInt(g.spent))})),note:'No aggregate valuation. Each asset has its own units. Laboratory collateral and committed funds are not free balances.'};}
 export(){const b={schema:'idfbi/operating/1.6',instruments:super.export(),operating:structuredClone(this.op)};return {...b,checksum:fingerprint(b)};}
 static restore(x){if(x?.schema==='idfbi/instruments/1.5'){const e=InstrumentEngine.restore(x);Object.setPrototypeOf(e,OperatingEngine.prototype);e.op=opFresh();e._attach();return e;}if(!x||x.schema!=='idfbi/operating/1.6')throw Error('Unsupported operating archive.');const {checksum,...b}=x;if(Object.keys(x).sort().join(',')!=='checksum,instruments,operating,schema'||fingerprint(b)!==checksum)throw Error('Operating archive checksum failed.');const e=InstrumentEngine.restore(x.instruments);Object.setPrototypeOf(e,OperatingEngine.prototype);e.op=structuredClone(x.operating);validateOperating(e);e._attach();return e;}
}
function validateOperating(e){const o=e.op,w=e.world,fail=()=>{throw Error('Unsafe or inconsistent operating archive.');};if(!o||o.schema!=='idfbi/operating-state/1.6')fail();const expected=Object.keys(opFresh()).sort().join(',');if(Object.keys(o).sort().join(',')!==expected)fail();
 const arrs=['editions','installations','grants','commissions','collectibles','venues','cells','loans','options','applications'];for(const k of arrs){if(!Array.isArray(o[k])||o[k].length>512)fail();for(let i=0;i<o[k].length;i++)if(o[k][i].id!==i+1)fail();}
 const person=v=>{if(!['you','guest','archivist','weaver'].includes(v))fail();};const identity=v=>{w.identity(v);};const time=v=>{if(!Number.isSafeInteger(v)||v<0)fail();};const asset=v=>{if(!/^[A-Z][A-Z0-9]{1,11}$/.test(v))fail();};
 const quantities=b=>{if(!b||typeof b!=='object'||Array.isArray(b)||Object.keys(b).length>512)fail();for(const[k,v]of Object.entries(b)){asset(k);opN(v);}};
 for(const x of o.editions){identity(x.identity);person(x.author);time(x.time);time(x.epoch);opText(x.title,96);if(x.parent>=x.id||x.parent<0)fail();const recipe=e.normalize(x.recipe);if(fingerprint(recipe)!==fingerprint(x.recipe)||x.contentHash!==fingerprint({schema:'idfbi/typed-edition/1.6',recipe}))fail();const{editionHash,receipt,contentHash,...body}=x;if(editionHash!==fingerprint({...body,contentHash}))fail();const ev=w.s.events.find(z=>z.seq===receipt);if(ev?.kind!=='EDITION_PUBLISHED'||ev.data.edition!==x.id||ev.data.contentHash!==contentHash)fail();}
 for(const x of o.installations){identity(x.identity);if(e.edition(x.edition).contentHash!==x.contentHash)fail();time(x.readyAt);}
 for(const x of o.grants){identity(x.identity);person(x.caller);time(x.epoch);time(x.expires);if(e.edition(x.edition).editionHash!==x.editionHash||typeof x.revoked!=='boolean')fail();opQ(x.perCall);opQ(x.total);opN(x.spent);if(BigInt(x.spent)>BigInt(x.total)||BigInt(x.perCall)>BigInt(x.total)||!Number.isInteger(x.calls)||x.calls<1||x.calls>100||!Number.isInteger(x.used)||x.used<0||x.used>x.calls)fail();if(BigInt(x.spent)!==BigInt(e.edition(x.edition).recipe.amount)*BigInt(x.used))fail();}
 for(const x of o.commissions){identity(x.identity);person(x.sponsor);person(x.worker);person(x.reviewer);asset(x.asset);opQ(x.amount);opText(x.title);time(x.deadline);time(x.reviewEnds);if(x.reviewEnds!==x.deadline+3*DAY||!['offered','accepted','submitted','paid','refunded'].includes(x.status))fail();w.room(x.room);if(['submitted','paid'].includes(x.status)&&e.edition(x.edition).author!==x.worker)fail();}
 for(const c of o.cells){identity(c.identity);time(c.enabledEpoch);quantities(c.balances);if(!Array.isArray(c.enabled)||c.enabled.some(k=>!LAB_MODULES.includes(k))||new Set(c.enabled).size!==c.enabled.length)fail();if(c.strategy.asset!=='AUR')fail();opN(c.strategy.assets);opN(c.strategy.shares);for(const k of ['supply','ETH','AUR'])opN(c.basket[k]);if(BigInt(c.basket.ETH)<ceilRatio(c.basket.supply,wei('0.0001'),E18)||BigInt(c.basket.AUR)<ceilRatio(c.basket.supply,wei('10'),E18))fail();if(c.strip){for(const k of ['assets','pairs','initial'])opN(c.strip[k]);if(c.strip.asset!=='AUR'||BigInt(c.strip.assets)>BigInt(c.strip.initial)||BigInt(c.strip.pairs)>BigInt(c.strip.initial))fail();time(c.strip.maturity);}}
 if(new Set(o.cells.map(c=>c.identity)).size!==o.cells.length)fail();
 for(const x of o.collectibles){identity(x.holder);e.edition(x.edition);if(!Number.isInteger(x.venue)||x.venue<0||x.venue>o.venues.length)fail();}
 for(const x of o.venues){identity(x.identity);opQ(x.price);opN(x.reserve);time(x.bondUntil);opGet(o.collectibles,x.collectible);if(!['open','sold','closed'].includes(x.status))fail();}
 for(const x of o.loans){identity(x.borrower);if(x.lender)identity(x.lender);for(const k of ['collateral','principal','repayment'])opQ(x[k]);if(BigInt(x.repayment)<BigInt(x.principal)||!['offered','active','cancelled','defaulted','repaid'].includes(x.status))fail();opDays(x.days,365);time(x.offerUntil);time(x.due);if(['active','defaulted','repaid'].includes(x.status)&&(!x.lender||x.lender===x.borrower||x.due===0))fail();e.cell(x.borrower);if(x.lender)e.cell(x.lender);}
 for(const x of o.options){identity(x.writer);if(x.buyer)identity(x.buyer);for(const k of ['underlying','strike','premium'])opQ(x[k]);time(x.expiry);if(!['offered','active','exercised','closed'].includes(x.status)||['active','exercised'].includes(x.status)&&(!x.buyer||x.buyer===x.writer))fail();e.cell(x.writer);if(x.buyer)e.cell(x.buyer);}
 for(const x of o.applications){identity(x.identity);opText(x.title,96);if(!/^0x[0-9a-f]{64}$/.test(x.hash)||!Number.isInteger(x.bytes)||x.bytes<1||x.bytes>4000000)fail();time(x.time);}
 for(const [id,c]of Object.entries(o.covenants)){const l=opGet(w.s.listings,id);if(!/^0x[0-9a-f]{64}$/.test(c.moduleRoot)||c.manifest!==fingerprint({domain:'IDFBI_OPERATING_COVENANT_1_6',base:c.base,moduleRoot:c.moduleRoot})||c.manifest!==l.manifest)fail();}quantities(o.lossSink);
}


/** Native authenticated encryption only. No homemade cipher or plaintext fallback.
 * Passphrases and decrypted bodies never belong in a MemoryEngine export. */
const MEMORY_KDF_ROUNDS=600000;
const memUTF8=new TextEncoder();
const memHex=b=>Array.from(b,x=>x.toString(16).padStart(2,'0')).join('');
const memBytes=h=>{if(typeof h!=='string'||!/^([0-9a-f]{2})*$/.test(h))throw Error('Malformed encoded memory.');return Uint8Array.from(h.match(/../g)||[],x=>parseInt(x,16));};
function memNative(){if(!globalThis.crypto?.subtle||!crypto.getRandomValues)throw Error('Encrypted memory needs native Web Crypto in a secure browser context. Nothing was saved as plaintext.');return crypto.subtle;}
function memPass(pass){if(typeof pass!=='string'||pass.length<12||memUTF8.encode(pass).length>1024)throw Error('Use a unique memory passphrase of at least 12 characters (maximum 1024 UTF-8 bytes). It is not your wallet seed phrase.');}
function memoryBody(raw){
 const limits={title:160,thesis:3000,setup:512,invalidation:800,exitPlan:800,horizon:256,risk:256,tags:256,feeling:256,lesson:1500};
 if(!raw||typeof raw!=='object'||Array.isArray(raw)||Object.keys(raw).some(k=>!(k in limits)))throw Error('Unsupported journal field.');
 const body={};for(const[k,max]of Object.entries(limits)){const v=raw[k]??'';if(typeof v!=='string'||memUTF8.encode(v).length>max)throw Error(k+' exceeds its UTF-8 limit.');body[k]=v.trim();}
 if(!body.thesis&&!body.lesson)throw Error('Write a reason, a memory, or a reflection first.');
 return body;
}
function memPack(body){const bytes=memUTF8.encode(stable(memoryBody(body)));if(bytes.length>12000)throw Error('Memory body too large.');const padded=new Uint8Array(Math.ceil((bytes.length+4)/1024)*1024);new DataView(padded.buffer).setUint32(0,bytes.length);padded.set(bytes,4);return padded;}
function memUnpack(bytes){if(bytes.length<4)throw Error('Invalid private memory.');const len=new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength).getUint32(0);if(len>12000||len+4>bytes.length||bytes.slice(len+4).some(x=>x!==0))throw Error('Invalid private memory padding.');return memoryBody(JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(bytes.slice(4,4+len))));}
async function memKey(pass,salt,usage){memPass(pass);const s=memNative(),key=await s.importKey('raw',memUTF8.encode(pass),'PBKDF2',false,['deriveKey']);return s.deriveKey({name:'PBKDF2',salt,iterations:MEMORY_KDF_ROUNDS,hash:'SHA-256'},key,{name:'AES-GCM',length:256},false,usage);}
async function encryptMemory(header,body,pass){memPass(pass);memNative();const salt=crypto.getRandomValues(new Uint8Array(16)),iv=crypto.getRandomValues(new Uint8Array(12));const key=await memKey(pass,salt,['encrypt']);const bytes=await crypto.subtle.encrypt({name:'AES-GCM',iv,additionalData:memUTF8.encode(stable(header)),tagLength:128},key,memPack(body));return {mode:'encrypted',cipher:'AES-256-GCM',kdf:'PBKDF2-SHA256',rounds:MEMORY_KDF_ROUNDS,salt:memHex(salt),iv:memHex(iv),data:memHex(new Uint8Array(bytes))};}
function validateMemoryPayload(payload){
 if(payload?.mode==='public'){if(Object.keys(payload).sort().join(',')!=='body,mode')throw Error('Invalid public memory.');if(stable(memoryBody(payload.body))!==stable(payload.body))throw Error('Noncanonical public memory.');return;}
 if(!payload||Object.keys(payload).sort().join(',')!=='cipher,data,iv,kdf,mode,rounds,salt'||payload.mode!=='encrypted'||payload.cipher!=='AES-256-GCM'||payload.kdf!=='PBKDF2-SHA256'||payload.rounds!==MEMORY_KDF_ROUNDS||memBytes(payload.salt).length!==16||memBytes(payload.iv).length!==12)throw Error('Unsupported encrypted memory.');
 if(typeof payload.data!=='string'||payload.data.length>26656)throw Error('Ciphertext exceeds the memory limit.');const n=memBytes(payload.data).length;if(n<1040||n>13328||(n-16)%1024)throw Error('Invalid ciphertext length.');
}
async function decryptMemory(header,payload,pass){validateMemoryPayload(payload);if(payload.mode==='public')return structuredClone(payload.body);try{const key=await memKey(pass,memBytes(payload.salt),['decrypt']);const data=await crypto.subtle.decrypt({name:'AES-GCM',iv:memBytes(payload.iv),additionalData:memUTF8.encode(stable(header)),tagLength:128},key,memBytes(payload.data));return memUnpack(new Uint8Array(data));}catch{throw Error('Cannot open this memory: wrong passphrase, changed header, or damaged ciphertext. Nothing was modified.');}}
function memorySeal(header,payload){validateMemoryPayload(payload);return {header:structuredClone(header),payload:structuredClone(payload),digest:fingerprint({domain:'IDFBI_MEMORY_ENVELOPE_1_7',header,payload})};}




const MEM_ZERO='0x'+'00'.repeat(32);
const memHash=v=>typeof v==='string'&&/^0x[0-9a-f]{64}$/.test(v);
const memInt=n=>Number.isSafeInteger(n)&&n>=0;
const memFresh=(seq,origin)=>({schema:'idfbi/memory-state/1.7',origin,start:seq,entries:[],bindings:[]});
/** Append-only, unsigned LOCAL journal. Public metadata and ciphertext are not signatures.
 * Historical custody stays attributed. The NFT never acquires an author's decryption key. */
class MemoryEngine extends OperatingEngine {
 constructor(now,origin=MEM_ZERO){super(now);if(!memHash(origin))throw Error('Invalid origin.');this.mem=memFresh(this.world.s.seq,origin);}
 atomic(fn){const saved=this.mem?structuredClone(this.mem):null;try{return super.atomic(fn);}catch(e){if(saved)this.mem=saved;throw e;}}
 memoryHeader({phase='memory',parent=0,plan=MEM_ZERO,receipt=0,form=true}={}){
  const w=this.world,a=w.identity();if(!['memory','before','reflection'].includes(phase)||!memInt(parent)||!memInt(receipt)||!memHash(plan)||typeof form!=='boolean')throw Error('Invalid memory context.');
  if(phase==='reflection'){const p=this.entry(parent);if(p.header.author!==w.s.actor)throw Error('Only the original author can add a reflection.');if(p.header.identity!==a.id)throw Error('Select the original artifact for this reflection.');}
  else{w._owner(a.id);if(parent)throw Error('Only reflections have parents.');}
  if(phase==='before'&&plan===MEM_ZERO)throw Error('A before-trade inscription must bind a reviewed plan.');
