 personal wallet':'Artifact #'+g.recipient.id+' · current owner '+personLabel(W().identity(g.recipient.id).owner);}
function nav(view){ixView=view;ixReview=null;ixInspect=0;notice('');draw();}
function draw(){
 const w=W(),a=w.identity();
 ix$('#ix-actor').value=w.s.actor;
 ix$('#ix-identity').innerHTML=w.s.identities.map(x=>`<option value="${x.id}" ${x.id===a.id?'selected':''}>#${String(x.id).padStart(4,'0')} · ${personLabel(x.owner)}</option>`).join('');
 ix$('.ix-tabs').innerHTML=IX_TABS.map(([id,label])=>`<button type="button" role="tab" aria-selected="${ixView===id}" data-act="tab" data-id="${id}">${label}</button>`).join('');
 const pages={journal:memPage,'memory-write':memWritePage,form:memFormPage,trade:tradePage,launch:launchPage,vault:vaultPage,give:givePage,market:marketPage,world:worldPage,receipts:receiptPage,capabilities:capabilityPage,clock:clockPage,library:opLibraryPage,work:opWorkPage,ledger:opLedgerPage,lab:opLabPage,venues:opVenuesPage,applications:opApplicationPage};
 ix$('#ix-content').innerHTML=ixReview?reviewPage():(pages[ixView]||tradePage)();
 if(!ixReview&&ixView==='market')ix$('#ix-content').insertAdjacentHTML('afterbegin',`<div class="ix-actions" style="margin-bottom:20px">${B('op-venues','Operating shelves →')}${B('tab','Commitment ledger →','ledger')}${W().s.listings.filter(l=>l.status==='listed'&&l.seller===W().s.actor).map(l=>B('op-refresh-listing','Refresh manifest #'+l.id,l.id)).join('')}</div>`);
 if(!ixReview&&['trade','give'].includes(ixView))updateEstimate();
 memAfterDraw();
}
function balanceFacts(){return Object.entries(W().identity().balances).map(([k,v])=>fact(esc(k),format(v,6))).join('');}
function tradePage(){return `<div class="ix-grid"><div class="ix-main"><h3>A swap, or a future.</h3><p>Receive an asset now—or route the output straight into a time lock.</p><form id="ix-trade-form">${amountBox()}<div class="ix-row"><div><label for="ix-output">Receive</label><select id="ix-output" name="output">${assets('AUR')}</select></div><div><label for="ix-slip">Maximum slippage</label><select id="ix-slip" name="slip"><option value="50">0.5%</option><option value="100">1%</option><option value="300">3%</option></select></div></div><div id="ix-estimate" class="ix-estimate"></div><label class="ix-check"><input id="ix-autolock" type="checkbox" name="autolock"> Lock the received asset in the same operation</label><div id="ix-lock-duration" hidden>${field('Lock for days','days',30,'number')}</div><button class="ix-button primary" type="submit">Review the outcome →</button></form></div><aside class="ix-side"><h4>Inside this artifact</h4>${balanceFacts()}<p class="ix-small" style="margin-top:16px">Fictional balances. Quote math is an integer reserve approximation, not a v4 tick simulation or live market price.</p><details><summary>What the contract source does</summary><p>Exact-input v4 execution, deadline and minimum output, then optional vault deposit. Every PoolManager delta must settle. The hook publishes its fee ramp and locks only the seed adapter’s principal.</p><p class="ix-small">Source exists. Compilation and real PoolManager tests remain required.</p></details></aside></div>`;}
function givePage(){const gs=ixEngine.extra.gifts;return `<div class="ix-grid"><div><h3>Give someone a future.</h3><p>Offer a chosen asset with a fixed release date. They accept the terms; then the gift cannot be recalled.</p><form id="ix-give-form">${amountBox()}<div class="ix-row"><div><label for="ix-output">They receive</label><select id="ix-output">${assets('AUR')}</select></div><div><label for="ix-slip">Maximum slippage</label><select id="ix-slip"><option value="50">0.5%</option><option value="100">1%</option></select></div></div><div class="ix-field"><label for="ix-recipient">Who receives it?</label><select id="ix-recipient"><option value="person:guest">Guest’s personal wallet</option><option value="person:you">Your personal wallet</option>${W().s.identities.filter(x=>x.id!==W().s.selected).map(x=>`<option value="artifact:${x.id}">Artifact #${x.id} account (follows its ownership)</option>`).join('')}</select></div>${field('Release in days · at least 2','days',30,'number')}<div id="ix-estimate" class="ix-estimate"></div><button class="ix-button primary" type="submit">Review this gift →</button></form></div><aside class="ix-side"><h4>Two decisions. One promise.</h4><div class="ix-flow"><span>OFFER</span><b>→</b><span>ACCEPT</span><b>→</b><span>RELEASE</span></div>${fact('Before acceptance','You can recall it')}${fact('After acceptance','No early release or recall')}${fact('No response','Return to donor after expiry')}${fact('Messages and membership','Never attached automatically')}<p class="ix-small" style="margin-top:16px">A personal-wallet gift stays with that wallet. An artifact-account gift follows the artifact if it is sold. These are different rights.</p></aside></div><hr class="ix-divider"><div class="ix-inline"><h4>Offers & accepted gifts</h4><span class="ix-small">Change “Act as” above to test recipient consent.</span></div><div class="ix-stack">${gs.length?gs.map(giftCard).join(''):'<p>No gifts yet. Nothing has been sent to a real wallet.</p>'}</div><details><summary>Personal rehearsal balances</summary>${Object.entries(ixEngine.extra.personalBalances).map(([p,bs])=>`<h4>${personLabel(p)}</h4>${Object.entries(bs).map(([k,v])=>fact(esc(k),format(v,6))).join('')||'<p class="ix-small">No released gifts.</p>'}`).join('')}</details>`;}
function giftCard(g){const pending=g.status==='offered',accepted=g.status==='accepted',actor=W().s.actor;return `<article class="ix-card"><h4>Gift ${g.id} <span class="ix-tag">${g.status.toUpperCase()}</span></h4>${fact('Amount',money(g.amount,g.asset))}${fact('Recipient',esc(recipient(g)))}${fact('Fixed release',when(g.releaseAt))}${pending?fact('Accept before',when(g.acceptBy)):''}<div class="ix-actions">${pending?B('accept-gift','Accept',g.id,'',ixEngine.recipientActor(g)!==actor||W().s.now>=g.acceptBy)+B('return-gift','Return to donor',g.id,'',W().identity(g.donor).owner!==actor&&W().s.now<g.acceptBy):''}${accepted?B('release-gift','Release to beneficiary',g.id,'',W().s.now<g.releaseAt):''}${B('trace','Follow its receipts',g.receipt)}</div></article>`;}
function updateEstimate(){try{const n=wei(input('amount')),a=input('input'),b=input('output'),q=a===b?{out:n,hops:[]}:W().quote(a,b,n);if(n<=0n)throw Error('Enter an amount.');const min=q.out*BigInt(10000-Number(input('slip')))/10000n;ix$('#ix-estimate').innerHTML=`≈ ${money(q.out,b)}<small>Minimum ${money(min,b)} · ${q.hops.length?q.hops.length+' model route hop'+(q.hops.length>1?'s':''):'no swap'}<br>Illustrative rehearsal only. No live quote.</small>`;}catch(e){ix$('#ix-estimate').textContent=e.message;}}
function vaultPage(){const w=W(),id=w.s.selected,ls=w.s.locks.filter(l=>l.identity===id),gs=ixEngine.extra.gifts.filter(g=>g.recipient.kind==='artifact'&&g.recipient.id===id&&['accepted','released'].includes(g.status));return `<div class="ix-grid"><div><h3>Make time part of the promise.</h3><p>No yield claim. Just an explicit beneficiary and a release schedule.</p><form id="ix-lock-form">${amountBox('ETH','0.1')}${field('Lock for days','days',30,'number')}<button class="ix-button primary" type="submit">Review lock →</button></form></div><aside class="ix-side"><h4>A lens, not a time machine.</h4><label for="ix-future">Inspect scheduled availability: <b id="ix-future-label">+${ixFuture} days</b></label><input id="ix-future" type="range" min="0" max="365" value="${ixFuture}"><div id="ix-future-balances">${futureFacts(id)}</div><p class="ix-small" style="margin-top:13px">Projection never moves the real rehearsal clock, unlocks funds, or predicts a token’s price.</p></aside></div><hr class="ix-divider"><h4>Existing schedules</h4><div class="ix-stack">${ls.map(l=>lockCard(l)).join('')}${gs.map(giftCard).join('')}${!ls.length&&!gs.length?'<p>No schedules for this artifact.</p>':''}</div>`;}
function futureFacts(id){const p=ixEngine.project(id,W().s.now+ixFuture*DAY);return Object.entries(p.balances).map(([k,v])=>fact(esc(k),format(v,5))).join('');}
function lockCard(l){const available=releasable(l,W().s.now),progress=Math.max(0,Math.min(100,100*(W().s.now-l.start)/(l.end-l.start)));return `<article class="ix-card"><h4>Lock ${l.id} <span class="ix-tag">${l.linear?'LINEAR VESTING':'TIME LOCK'}</span></h4>${fact('Committed',money(l.amount,l.asset))}${fact('Release schedule',when(l.end))}<div class="ix-progress"><span style="width:${progress.toFixed(2)}%"></span></div>${fact('Releasable now',money(available,l.asset))}<div class="ix-actions">${B('release-lock','Release to this account',l.id,'',available===0n)}</div></article>`;}
function launchPage(){return `<div class="ix-grid"><div><h3>A launch with terms that stay put.</h3><p>Token, allocations, sale, future pool, and conversation—declared before contributions.</p><form id="ix-launch-form"><div class="ix-row">${field('Token name','name','A new beginning')}${field('Ticker','symbol','BEGIN')}</div><div class="ix-row">${field('Fixed supply','supply','1000000')}${field('Sale window · hours','hours',24,'number')}</div><div class="ix-row">${field('Minimum raise · ETH','soft','1')}${field('Maximum raise · ETH','hard','20')}</div><details><summary>Allocations & pool rules</summary><div class="ix-row" style="margin-top:14px">${field('Founder share · basis points','founder',1000,'number')}${field('Raised ETH to seed · basis points','liquidity',8000,'number')}</div><p>Founder tokens vest over 180 days with a 30-day cliff. Unseeded treasury ETH locks for 180 days. Seed principal is non-withdrawable through the supplied v4 adapter. LP fees may be harvested to the creator account.</p><p class="ix-small">The hook starts at a 1.00% LP fee and reaches 0.30% after 24 hours. Other LPs retain their withdrawal rights. This is not bot immunity.</p></details><button class="ix-button primary" type="submit">Review immutable terms →</button></form></div><aside class="ix-side"><h4>Not every launch is the same game.</h4>${fact('This rehearsal','Time-boxed, pro-rata batch')}${fact('Before closing','Contribution withdrawal')}${fact('Below minimum','Refund path')}${fact('After successful settlement','Market + locked allocations')}${fact('CCA integration','Researched, not implemented')}<p class="ix-small" style="margin-top:15px">The hard cap can favor earlier contributors. A v4 hook alone does not turn a batch sale into a continuous clearing auction.</p></aside></div><hr class="ix-divider"><h4>Launches</h4><div class="ix-stack">${W().s.sales.map(saleCard).join('')||'<p>Your first launch will appear here.</p>'}</div>`;}
function saleCard(s){return `<article class="ix-card"><h4>${esc(s.name)} · ${esc(s.symbol)} <span class="ix-tag">${s.status.toUpperCase()}</span></h4>${fact('Raised',money(s.raised,'ETH'))}${fact('Closes',when(s.closes))}<div class="ix-actions">${s.status==='open'?(W().s.now<s.closes?B('contribute','Contribute',s.id)+B('withdraw-contribution','Withdraw',s.id)+B('close-sale-clock','Advance test clock to close',s.id):B('settle','Settle',s.id)):B('claim',s.status==='refund'?'Claim refund':'Claim allocation',s.id)}${B('open-room','Open commons',s.room)}</div></article>`;}
function marketPage(){if(ixInspect){const a=W().identity(ixInspect),l=W().s.listings.find(l=>l.identity===a.id&&l.status==='listed');return `<h3>What moves with #${String(a.id).padStart(4,'0')}?</h3><p>You acquire control of declared possessions and account-held rights—not authorship of old messages or ownership of the people in its rooms.</p><div class="ix-grid"><div>${Object.entries(a.balances).map(([k,v])=>fact('Spendable '+esc(k),format(v,6))).join('')}${W().s.locks.filter(x=>x.identity===a.id).map(x=>fact('Lock '+x.id,money(x.amount,x.asset)+'<br>'+when(x.end))).join('')}${fact('Current custody',personLabel(a.owner))}${fact('Authority epoch',a.epoch)}${opMarketFacts(a.id)}<div class="ix-actions">${l?B('buy','Review acquisition',l.id):''}${B('market-back','Back to market')}</div></div><aside class="ix-side"><label for="ix-future">Scheduled future · <b id="ix-future-label">+${ixFuture} days</b></label><input id="ix-future" type="range" min="0" max="365" value="${ixFuture}"><div id="ix-future-balances">${futureFacts(a.id)}</div><p class="ix-small" style="margin-top:14px">Declared inventory is not a universal balance-sheet proof. Known gifts, work, instruments, shelves and laboratory records are committed here. Unknown external approvals or liabilities are not automatically discovered.</p>${l?`<span class="ix-code">Manifest ${esc(l.manifest)}</span>`:''}</aside></div>`;}
 return `<h3>Buy the artifact. Understand the contents.</h3><p>Inspect present balances, future claims, custody, and the exact manifest before a purchase.</p><div class="ix-cards">${W().s.listings.filter(l=>l.status==='listed').map(l=>{const a=W().identity(l.identity);return `<article class="ix-card"><span class="ix-eyebrow">DECLARED-CONTENT OFFER</span><h3 style="margin-top:15px">#${String(a.id).padStart(4,'0')}</h3>${fact('Ask',money(l.price,'ETH'))}${fact('Contents',Object.keys(a.balances).length+' asset types')}${fact('Time commitments',W().s.locks.filter(x=>x.identity===a.id).length)}<div class="ix-actions">${B('inspect-estate','Unfold the contents →',a.id)}${l.seller===W().s.actor||W().s.now>l.expires?B('cancel-listing','Cancel listing',l.id):''}</div></article>`;}).join('')||'<p>No open rehearsal listings.</p>'}</div><hr class="ix-divider"><h4>Selected artifact #${W().s.selected}</h4><p class="ix-small">Only its current owner can list it. Escrow revokes their spending. The buyer receives control, not an early-unlock exception.</p>${B('list-estate','Prepare a listing',W().s.selected,'',W().identity().owner!==W().s.actor)}<details><summary>Ownership vs temporary use</summary><p>A presence grant allows use without treasury control. Active grants block this marketplace’s listing path.</p>${B('presence','Grant temporary presence',W().s.selected,'',W().identity().owner!==W().s.actor)}</details>`;}
function worldPage(){const w=W(),r=w.room(ixRoom),v=w.s.views[w.s.actor]||{block:[],follow:[]};let posts=w.s.messages.filter(m=>m.room===r.id&&!v.block.includes(m.actor));if(ixFilter==='follow')posts=posts.filter(m=>m.actor===w.s.actor||v.follow.includes(m.actor));const activity=w.s.events.filter(e=>['LAUNCHED', 'SETTLED', 'SWAPPED', 'LOCKED', 'ACQUIRED', 'OFFERED', 'ACCEPTED', 'GIFT_RELEASED', 'EDITION_PUBLISHED', 'EDITION_ADOPTED', 'GRANT_CREATED', 'GRANT_REVOKED', 'EDITION_EXECUTED', 'COMMISSION_FUNDED', 'COMMISSION_ACCEPTED', 'WORK_SUBMITTED', 'WORK_PAID', 'WORK_REJECTED', 'COMMISSION_REFUNDED', 'VENUE_OPENED', 'SHELF_PURCHASED', 'VENUE_CLOSED', 'EDITION_COLLECTED', 'LAB_ALLOCATED', 'LAB_WITHDRAWN', 'CREDIT_REQUESTED', 'CREDIT_FUNDED', 'CREDIT_REPAID', 'CREDIT_CLOSED', 'OPTION_WRITTEN', 'OPTION_BOUGHT', 'OPTION_EXERCISED', 'OPTION_CLOSED', 'APPLICATION_COMMITTED'].includes(e.kind)&&!v.block.includes(e.actor)&&(ixFilter!=='follow'||e.actor===w.s.actor||v.follow.includes(e.actor))).filter(e=>r.id===1||e.data.room===r.id||w.s.sales.find(s=>s.room===r.id)?.id===e.data.sale);const feed=[...posts.map(m=>({t:m.time,order:m.id,html:postCard(m)})),...activity.map(e=>({t:e.time,order:e.seq,html:eventCard(e)}))].sort((a,b)=>b.t-a.t||b.order-a.order).slice(0,60);return `<div class="ix-inline" style="margin-top:0"><div><h3>The conversation continues.</h3><p style="margin-bottom:0">Conversations and actions. Each keeps its own author.</p></div>${B('new-room','Create a room')}</div><div class="ix-row"><div><label for="ix-room">Conversation</label><select id="ix-room">${w.s.rooms.map(x=>`<option value="${x.id}" ${x.id===r.id?'selected':''}>${esc(x.name)}</option>`).join('')}</select></div><div><label for="ix-filter">Your view</label><select id="ix-filter"><option value="all" ${ixFilter==='all'?'selected':''}>Everyone</option><option value="follow" ${ixFilter==='follow'?'selected':''}>Following + you</option></select></div></div><p class="ix-small">${esc(r.topic)} · ${r.gated?'Members may post. Content remains public.':'Public posting.'}</p>${r.members[w.s.actor]&&!r.members[w.s.actor].accepted?B('accept-room','Accept room invitation',r.id):''}<div class="ix-feed">${feed.map(x=>x.html).join('')||'<p>This view has no messages yet.</p>'}</div>${ixReceipt?`<div class="ix-inline"><span class="ix-small">Discussing receipt ${ixReceipt}. This text cannot manufacture an action.</span>${B('clear-reply','Clear reference')}</div>`:''}${ixReply?`<p class="ix-small">Replying to message ${ixReply}.</p>`:''}<form id="ix-message-form" class="ix-composer"><textarea id="ix-message" rows="2" maxlength="1024" placeholder="Say something worth keeping…" aria-label="Public message"></textarea><button type="submit" class="ix-button" ${w._canPost(r,w.s.actor)?'':'disabled'}>${w._canPost(r,w.s.actor)?'Post locally':'Posting not permitted'}</button></form><details><summary>People & room controls</summary>${['guest','archivist','weaver','you'].filter(p=>p!==w.s.actor).map(p=>`<div class="ix-person"><span>${personLabel(p)}</span>${B('follow',v.follow.includes(p)?'Unfollow':'Follow',p)}${B('block',v.block.includes(p)?'Unmute':'Mute in my view',p)}${r.identity&&w._mod(r)?B('invite','Invite to room',p)+B('remove-member','Remove from room',p):''}</div>`).join('')}<p class="ix-small" style="margin-top:14px">Muted people retain their World access. Removing a room member revokes future posting, not their old messages. Invitations require acceptance.</p>${w._admin(r)?B('room-settings','Room settings',r.id):''}</details>`;}
function postCard(m){return `<article class="ix-post"><header><span>${personLabel(m.actor)}${m.identity?' · artifact #'+m.identity:''}</span><span>MESSAGE ${m.id}</span></header><p>${esc(m.body)}</p><small>Authored as ${personLabel(m.custodian)} · epoch ${m.epoch}${m.receipt?' · receipt '+m.receipt:''}</small><div class="ix-actions">${B('reply','Reply',m.id)}${B('react','♡ '+(m.reactions['♡']?.length||0),m.id)}${m.receipt?B('trace','Inspect referenced action',m.receipt):''}</div></article>`;}
function eventCard(e){const labels={EDITION_PUBLISHED:'published an instrument',EDITION_ADOPTED:'adopted an edition',EDITION_EXECUTED:'executed a bounded instrument',COMMISSION_FUNDED:'funded a commission',WORK_SUBMITTED:'delivered an edition',WORK_PAID:'paid for accepted work',VENUE_OPENED:'opened a collectible shelf',SHELF_PURCHASED:'bought a collectible',LAB_ALLOCATED:'allocated laboratory capital',CREDIT_FUNDED:'funded fixed-term credit',OPTION_BOUGHT:'accepted a covered option',LAUNCHED:'launched a token',SETTLED:'settled a launch',SWAPPED:'swapped assets',LOCKED:'created a time lock',ACQUIRED:'acquired an artifact',OFFERED:'offered a gift',ACCEPTED:'accepted a gift',GIFT_RELEASED:'released a gift'};let description=e.data.symbol?esc(e.data.symbol):e.data.gift?'Gift '+esc(e.data.gift):e.data.amount?money(e.data.amount,e.data.asset||e.data.input||'ETH'):'Artifact #'+e.identity;if(e.kind==='SWAPPED')description=money(e.data.amount,e.data.input)+' → '+money(e.data.received,e.data.output)+(e.data.lock?' · output locked':'');if(['OFFERED','GIFT_RELEASED'].includes(e.kind))description=money(e.data.amount,e.data.asset)+' → '+esc(e.data.recipient.kind==='person'?personLabel(e.data.recipient.id)+'’s personal wallet':'artifact #'+e.data.recipient.id);return `<article class="ix-post activity"><header><span>${personLabel(e.actor)} ${esc(labels[e.kind]||e.kind)}</span><span>LOCAL RECEIPT ${e.seq}</span></header><p>${description}</p><small>Protocol-model activity, not a user-written claim or a blockchain receipt.</small><div class="ix-actions">${B('trace','Trace this action',e.seq)}${B('discuss','Discuss',e.seq)}</div></article>`;}
function receiptPage(){const trace=ixInspect?ixEngine.trace(ixInspect):null;return `<h3>${trace?'A receipt is a beginning, not a dead end.':'Follow what actually led here.'}</h3><p>Inspect causes, then the discussions attached to them. These local records check consistency—not authorship or blockchain execution.</p>${trace?`<div class="ix-timeline">${trace.map(({event:e,causes,discussions})=>`<article><h4>${e.seq} / ${esc(e.kind)}</h4><p>${personLabel(e.actor)} acting with artifact ${e.identity||'none'} · custody ${personLabel(e.custodian)} · epoch ${e.epoch}</p><span class="ix-code">${esc(e.digest)}</span><p class="ix-small">${causes.length?'Caused by '+causes.join(', '):'No earlier causal reference in this local record.'}</p><details><summary>Exact record</summary><pre>${esc(JSON.stringify(e,null,2))}</pre></details>${discussions.map(m=>`<p>“${esc(m.body)}” — ${personLabel(m.actor)}</p>`).join('')}${B('discuss','Discuss this receipt',e.seq)}</article>`).join('')}</div>${B('receipts','All receipts')}`:`<div class="ix-stack">${W().s.events.slice().reverse().map(e=>`<article class="ix-card"><h4>${e.seq} / ${esc(e.kind)} <span class="ix-small">${personLabel(e.actor)}</span></h4><span class="ix-code">${esc(short(e.digest))}</span>${B('trace','Inspect causes & conversation',e.seq)}</article>`).join('')}</div>`}`;}
function capabilityPage(){return `<h3>Potential is not permission.</h3><p>The full roadmap stays visible. A feature’s readiness, spending authority, and availability are separate questions.</p><div class="ix-stack">${IX_CATALOG.modules.map(m=>`<article class="ix-card"><h4>${esc(m.label)} <span class="ix-tag">${m.state==='LOCAL_AND_UNCOMPILED_SOURCE'?'REHEARSAL + UNCOMPILED SOURCE':m.state==='LOCAL_ONLY'?'LOCAL INTERACTION ONLY':m.state==='SPECIFICATION_ONLY'?'SPECIFICATION · NO EXECUTOR':'RESEARCH · NOT IMPLEMENTED'}</span></h4><p>${esc(m.authority||m.economics||m.privacy||'Not implemented or enabled.')}</p><details><summary>Dependencies & activation boundary</summary><p>${esc(m.dependencies.join(' · '))}</p>${m.exit?`<p>Exit: ${esc(m.exit)}</p>`:''}${m.limitations?`<p>Boundary: ${esc(m.limitations)}</p>`:''}</details></article>`).join('')}</div><p class="ix-small" style="margin-top:20px">No deployed module addresses. No mainnet enable switch. A disabled interface is not an onchain access rule. Research entries are not completed features waiting behind a lock icon.</p>`;}
function clockPage(){return `<h3>The test clock is not the future lens.</h3><p>This changes the actual local model time and can expire offers, finish a sale, or make locks releasable. It never changes a blockchain’s timestamp.</p>${fact('Current rehearsal time',when(W().s.now))}<div class="ix-actions">${B('advance','+1 minute',60)}${B('advance','+1 day',DAY)}${B('advance','+7 days',7*DAY)}${B('advance','+30 days',30*DAY)}${B('advance','+180 days',180*DAY)}</div><hr class="ix-divider"><p class="ix-small">Export before advancing to keep a separate copy. The ordinary time lens remains read-only.</p>`;}
function reviewPage(){const r=ixReview;return `<h3>${esc(r.title)}</h3><p>${esc(r.description)}</p>${r.html}<span class="ix-code">Original audit anchor ${esc(short(r.a