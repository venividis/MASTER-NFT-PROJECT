keyframes pulse { 50% { opacity: .35; transform: scale(.72); } }\n@keyframes orbit { to { transform: rotate(360deg); } }\n@keyframes busy { 50% { box-shadow: inset 0 0 28px rgba(114,247,255,.14); } }\n\n@media (max-width: 1050px) {\n  .panel { width: min(288px, 29vw); }\n  .core-label { width: 34vw; }\n  .event-console { width: 38vw; }\n  .command-button small { display: none; }\n}\n\n@media (max-width: 760px) {\n  body { overflow: auto; }\n  #organism, .grain, .scanline { position: fixed; }\n  .topbar { top: 8px; left: 8px; right: 8px; min-height: 62px; }\n  .brand p, .status { display: none; }\n  .sigil { width: 36px; height: 36px; }\n  .quiet { padding: 8px; }\n  main { position: relative; inset: auto; z-index: 5; min-height: 1330px; margin: 82px 8px 114px; display: grid; gap: 10px; pointer-events: auto; }\n  .panel, .event-console { position: relative; inset: auto; width: 100%; max-height: none; transform: none; }\n  .identity { order: 2; }\n  .proof { order: 3; }\n  .core-label { order: 1; position: relative; left: 50%; top: auto; width: min(82vw, 440px); margin: 20px 0 45px; }\n  .event-console { order: 4; height: 140px; }\n  .events { height: 100px; }\n  .command { left: 8px; right: 8px; bottom: calc(8px + var(--safe-bottom)); grid-template-columns: repeat(4, 1fr); min-height: 72px; }\n  .command-meta { display: none; }\n  .command-button { min-width: 0; padding: 5px; }\n  .command-button span { font-size: 7px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; }\n}\n\n\u003c/style>\n\u003c/head>\n\u003cbody>\n  \u003ccanvas id=\"organism\" aria-label=\"Live generative organism\">\u003c/canvas>\n  \u003cdiv class=\"grain\" aria-hidden=\"true\">\u003c/div>\n  \u003cdiv class=\"scanline\" aria-hidden=\"true\">\u003c/div>\n\n  \u003cheader class=\"topbar glass\">\n    \u003cdiv class=\"brand\">\n      \u003cdiv class=\"sigil\">!\u003c/div>\n      \u003cdiv>\n        \u003ch1>i dont fucking believe it!\u003c/h1>\n        \u003cp>PROOF-CARRYING AUTONOMOUS OBJECT / GENESIS-01\u003c/p>\n      \u003c/div>\n    \u003c/div>\n    \u003cdiv class=\"top-actions\">\n      \u003cdiv class=\"status\">\u003cspan class=\"pulse\">\u003c/span>\u003cspan id=\"network-status\">LOCAL WORLD ONLINE\u003c/span>\u003c/div>\n      \u003cbutton id=\"connect\" class=\"quiet\">CONNECT WALLET\u003c/button>\n    \u003c/div>\n  \u003c/header>\n\n  \u003cmain>\n    \u003caside class=\"panel identity glass\">\n      \u003cdiv class=\"panel-title\">\u003cspan>01\u003c/span> IDENTITY\u003c/div>\n      \u003cdiv class=\"mode-row\">\n        \u003cspan>AUTHORITY MODE\u003c/span>\n        \u003cstrong id=\"mode\" data-mode=\"bound\">BOUND\u003c/strong>\n      \u003c/div>\n      \u003cdl class=\"telemetry\">\n        \u003cdiv>\u003cdt>TOKEN\u003c/dt>\u003cdd>#0001\u003c/dd>\u003c/div>\n        \u003cdiv>\u003cdt>GENERATION\u003c/dt>\u003cdd id=\"generation\">0\u003c/dd>\u003c/div>\n        \u003cdiv>\u003cdt>EVOLUTIONS\u003c/dt>\u003cdd id=\"evolutions\">0\u003c/dd>\u003c/div>\n        \u003cdiv>\u003cdt>ACTIONS\u003c/dt>\u003cdd id=\"actions\">0\u003c/dd>\u003c/div>\n        \u003cdiv>\u003cdt>DESCENDANTS\u003c/dt>\u003cdd id=\"descendants\">0\u003c/dd>\u003c/div>\n      \u003c/dl>\n      \u003cdiv class=\"root-list\">\n        \u003cbutton class=\"root\" data-copy=\"seed\">\u003cspan>SEED\u003c/span>\u003ccode id=\"seed\">\u003c/code>\u003c/button>\n        \u003cbutton class=\"root\" data-copy=\"genome\">\u003cspan>GENOME\u003c/span>\u003ccode id=\"genome\">\u003c/code>\u003c/button>\n        \u003cbutton class=\"root\" data-copy=\"state\">\u003cspan>STATE ROOT\u003c/span>\u003ccode id=\"state\">\u003c/code>\u003c/button>\n        \u003cbutton class=\"root\" data-copy=\"memory\">\u003cspan>SEALED MEMORY\u003c/span>\u003ccode id=\"memory\">\u003c/code>\u003c/button>\n        \u003cbutton class=\"root\" data-copy=\"audit\">\u003cspan>AUDIT CHAIN\u003c/span>\u003ccode id=\"audit\">\u003c/code>\u003c/button>\n      \u003c/div>\n      \u003cdiv class=\"account-block\">\n        \u003cspan>DETERMINISTIC ACCOUNT\u003c/span>\n        \u003ccode id=\"account\">NOT DEPLOYED / SIMULATION\u003c/code>\n      \u003c/div>\n    \u003c/aside>\n\n    \u003csection class=\"core-label\" aria-live=\"polite\">\n      \u003cdiv class=\"coordinate\">STATE / \u003cspan id=\"state-short\">0x00000000\u003c/span>\u003c/div>\n      \u003cdiv class=\"designation\">THE OBJECT IS WATCHING ITS OWN STATE\u003c/div>\n      \u003cdiv class=\"orbit-label orbit-a\">PRIVATE MEMORY\u003c/div>\n      \u003cdiv class=\"orbit-label orbit-b\">VERIFIED INTENT\u003c/div>\n      \u003cdiv class=\"orbit-label orbit-c\">LINEAGE\u003c/div>\n    \u003c/section>\n\n    \u003caside class=\"panel proof glass\">\n      \u003cdiv class=\"panel-title\">\u003cspan>02\u003c/span> PROOF STACK\u003c/div>\n      \u003cdiv class=\"proof-rail\">\n        \u003cdiv class=\"proof-node active\">\u003ci>\u003c/i>\u003cdiv>\u003cstrong>POLICY KERNEL\u003c/strong>\u003csmall>CONSTITUTION COMMITTED\u003c/small>\u003c/div>\u003cb>LIVE\u003c/b>\u003c/div>\n        \u003cdiv class=\"proof-node active\">\u003ci>\u003c/i>\u003cdiv>\u003cstrong>INTENT BINDING\u003c/strong>\u003csmall>CHAIN / ACCOUNT / NONCE\u003c/small>\u003c/div>\u003cb>LIVE\u003c/b>\u003c/div>\n        \u003cdiv class=\"proof-node\">\u003ci>\u003c/i>\u003cdiv>\u003cstrong>TEE QUORUM\u003c/strong>\u003csmall>THRESHOLD ATTESTATIONS\u003c/small>\u003c/div>\u003cb>LOCAL\u003c/b>\u003c/div>\n        \u003cdiv class=\"proof-node\">\u003ci>\u003c/i>\u003cdiv>\u003cstrong>ZK EXECUTION\u003c/strong>\u003csmall>SP1 / RISC ZERO ADAPTER\u003c/small>\u003c/div>\u003cb>READY\u003c/b>\u003c/div>\n        \u003cdiv class=\"proof-node\">\u003ci>\u003c/i>\u003cdiv>\u003cstrong>REMOTE WITNESS\u003c/strong>\u003csmall>TRANSPORT-NEUTRAL ROOTS\u003c/small>\u003c/div>\u003cb id=\"witness-count\">0\u003c/b>\u003c/div>\n      \u003c/div>\n\n      \u003cdiv class=\"constitution\">\n        \u003cdiv class=\"section-label\">CONSTITUTION / IMMUTABLE AFTER ASCENSION\u003c/div>\n        \u003cdiv class=\"law\">\u003cspan>01\u003c/span>\u003cp>NO UNPROVED STATE TRANSITION\u003c/p>\u003cem>HARD\u003c/em>\u003c/div>\n        \u003cdiv class=\"law\">\u003cspan>02\u003c/span>\u003cp>NO HIDDEN VALUE TRANSFER\u003c/p>\u003cem>HARD\u003c/em>\u003c/div>\n        \u003cdiv class=\"law\">\u003cspan>03\u003c/span>\u003cp>EVERY ACTION EXTENDS AUDIT ROOT\u003c/p>\u003cem>HARD\u003c/em>\u003c/div>\n        \u003cdiv class=\"law\">\u003cspan>04\u003c/span>\u003cp>MEMORY PLAINTEXT NEVER ONCHAIN\u003c/p>\u003cem>HARD\u003c/em>\u003c/div>\n      \u003c/div>\n\n      \u003cdiv class=\"agent-state\">\n        \u003cspan>LOCAL AGENT\u003c/span>\n        \u003cbutton id=\"agent-check\" class=\"micro\">PING MCP / A2A\u003c/button>\n        \u003coutput id=\"agent-status\">NOT CONNECTED\u003c/output>\n      \u003c/div>\n    \u003c/aside>\n\n    \u003csection class=\"event-console glass\" aria-label=\"Audit events\">\n      \u003cdiv class=\"console-head\">\u003cspan>03 / APPEND-ONLY EVENT FEED\u003c/span>\u003cbutton id=\"clear-log\">CLEAR LOCAL VIEW\u003c/button>\u003c/div>\n      \u003cdiv id=\"events\" class=\"events\">\u003c/div>\n    \u003c/section>\n  \u003c/main>\n\n  \u003cfooter class=\"command glass\">\n    \u003cdiv class=\"command-meta\">\n      \u003cspan>NEXT NONCE\u003c/span>\n      \u003cstrong id=\"nonce\">0\u003c/strong>\n    \u003c/div>\n    \u003cbutton id=\"entropy\" class=\"command-button secondary\">\u003cspan>INJECT ENTROPY\u003c/span>\u003csmall>BOUND SESSION ACTION\u003c/small>\u003c/button>\n    \u003cbutton id=\"evolve\" class=\"command-button primary\">\u003cspan>PROVE EVOLUTION\u003c/span>\u003csmall>BUILD → ATTEST → EXECUTE\u003c/small>\u003c/button>\n    \u003cbutton id=\"spawn\" class=\"command-button secondary\">\u003cspan>SPAWN DESCENDANT\u003c/span>\u003csmall>LINEAGE COMMITMENT\u003c/small>\u003c/button>\n    \u003cbutton id=\"ascend\" class=\"command-button danger\">\u003cspan>ASCEND\u003c/span>\u003csmall>IRREVERSIBLE PROOF-ONLY MODE\u003c/small>\u003c/button>\n  \u003c/footer>\n\n  \u003cdialog id=\"ascension-dialog\">\n    \u003cform method=\"dialog\" class=\"dialog-body glass\">\n      \u003cdiv class=\"dialog-sigil\">∞\u003c/div>\n      \u003ch2>There is no undo.\u003c/h2>\n      \u003cp>The current holder will lose direct execution and transfer authority. Only verified intents routed through the organism’s account will remain valid.\u003c/p>\n      \u003cdiv class=\"dialog-hash\">\u003cspan>CONSTITUTION\u003c/span>\u003ccode id=\"constitution-preview\">\u003c/code>\u003c/div>\n      \u003cdiv class=\"dialog-actions\">\n        \u003cbutton value=\"cancel\" class=\"quiet\">REMAIN BOUND\u003c/button>\n        \u003cbutton id=\"confirm-ascend\" value=\"default\" class=\"danger-solid\">MAKE IT SOVEREIGN\u003c/button>\n      \u003c/div>\n    \u003c/form>\n  \u003c/dialog>\n\n  \u003cdiv id=\"toast\" role=\"status\" aria-live=\"polite\">\u003c/div>\n  \u003cscript>\n(async()=>{\nconst $ = (selector) => document.querySelector(selector);\nconst delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));\nconst encoder = new TextEncoder();\n\nfunction randomHex(bytes = 32) {\n  const value = new Uint8Array(bytes);\n  crypto.getRandomValues(value);\n  return `0x${[...value].map((byte) => byte.toString(16).padStart(2, \"0\")).join(\"\")}`;\n}\n\n\nfunction sha256Bytes(input) {\n  const K = new Uint32Array([\n    0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,\n    0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,\n    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,\n    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,\n    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,\n    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,\n    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,\n    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2\n  ]);\n  const H = new Uint32Array([0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19]);\n  const rotateRight = (x, n) => (x >>> n) | (x \u003c\u003c (32 - n));\n  const bitLength = input.length * 8;\n  const paddedLength = Math.ceil((input.length + 9) / 64) * 64;\n  const message = new Uint8Array(paddedLength);\n  message.set(input);\n  message[input.length] = 0x80;\n  const view = new DataView(message.buffer);\n  view.setUint32(paddedLength - 8, Math.floor(bitLength / 0x100000000), false);\n  view.setUint32(paddedLength - 4, bitLength >>> 0, false);\n  const w = new Uint32Array(64);\n  for (let offset = 0; offset \u003c paddedLength; offset += 64) {\n    for (let i = 0; i \u003c 16; i++) w[i] = view.getUint32(offset + i * 4, false);\n    for (let i = 16; i \u003c 64; i++) {\n      const s0 = rotateRight(w[i - 15], 7) ^ rotateRight(w[i - 15], 18) ^ (w[i - 15] >>> 3);\n      const s1 = rotateRight(w[i - 2], 17) ^ rotateRight(w[i - 2], 19) ^ (w[i - 2] >>> 10);\n      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;\n    }\n    let a=H[0], b=H[1], c=H[2], d=H[3], e=H[4], f=H[5], g=H[6], h=H[7];\n    for (let i = 0; i \u003c 64; i++) {\n      const S1 = rotateRight(e, 6) ^ rotateRight(e, 11) ^ rotateRight(e, 25);\n      const ch = (e & f) ^ (~e & g);\n      const t1 = (h + S1 + ch + K[i] + w[i]) >>> 0;\n      const S0 = rotateRight(a, 2) ^ rotateRight(a, 13) ^ rotateRight(a, 22);\n      const maj = (a & b) ^ (a & c) ^ (b & c);\n      const t2 = (S0 + maj) >>> 0;\n      h=g; g=f; f=e; e=(d+t1)>>>0; d=c; c=b; b=a; a=(t1+t2)>>>0;\n    }\n    H[0]=(H[0]+a)>>>0; H[1]=(H[1]+b)>>>0; H[2]=(H[2]+c)>>>0; H[3]=(H[3]+d)>>>0;\n    H[4]=(H[4]+e)>>>0; H[5]=(H[5]+f)>>>0; H[6]=(H[6]+g)>>>0; H[7]=(H[7]+h)>>>0;\n  }\n  const out = new Uint8Array(32);\n  const outView = new DataView(out.buffer);\n  H.forEach((value, index) => outView.setUint32(index * 4, value, false));\n  return out;\n}\n\nasync function hash(...parts) {\n  const bytes = encoder.encode(parts.join(\"|\"));\n  const digest = globalThis.crypto?.subtle\n    ? new Uint8Array(await globalThis.crypto.subtle.digest(\"SHA-256\", bytes))\n    : sha256Bytes(bytes);\n  return `0x${[...digest].map((byte) => byte.toString(16).padStart(2, \"0\")).join(\"\")}`;\n}\n\nfunction vectorFromHex(value, offset = 0) {\n  const clean = value.replace(\"0x\", \"\");\n  return Array.from({ length: 4 }, (_, index) => {\n    const cursor = (offset + index * 8) % Math.max(8, clean.length - 8);\n    return parseInt(clean.slice(cursor, cursor + 8), 16) / 0xffffffff;\n  });\n}\n\nconst state = {\n  sovereign: false,\n  generation: 0,\n  evolutions: 0,\n  actions: 0,\n  descendants: 0,\n  seed: randomHex(),\n  genome: randomHex(),\n  state: randomHex(),\n  memory: randomHex(),\n  audit: randomHex(),\n  account: \"NOT DEPLOYED / SIMULATION\",\n  constitution: \"\",\n  pulse: 0,\n};\nstate.constitution = await hash(\"IDONTFUCKINGBELIEVEIT_CONSTITUTION_V1\", \"NO_UNPROVED_TRANSITION\", \"NO_HIDDEN_VALUE\", \"APPEND_ONLY_AUDIT\", \"SEALED_MEMORY\");\n\nfunction short(value, front = 10, back = 6) {\n  return value.length > front + back ? `${value.slice(0, front)}…${value.slice(-back)}` : value;\n}\n\nfunction clock() {\n  return new Date().toLocaleTimeString([], { hour12: false, hour: \"2-digit\", minute: \"2-digit\", second: \"2-digit\" });\n}\n\nfunction log(type, message, className = \"\") {\n  const row = document.createElement(\"div\");\n  row.className = `event ${className}`;\n  row.innerHTML = `\u003ctime>${clock()}\u003c/time>\u003cb>${type}\u003c/b>\u003cspan>\u003c/span>`;\n  row.querySelector(\"span\").textContent = message;\n  $(\"#events\").prepend(row);\n}\n\nfunction toast(message) {\n  const element = $(\"#toast\");\n  element.textContent = message;\n  element.classList.add(\"show\");\n  clearTimeout(toast.timer);\n  toast.timer = setTimeout(() => element.classList.remove(\"show\"), 1900);\n}\n\nfunction renderState() {\n  $(\"#mode\").textContent = state.sovereign ? \"SOVEREIGN\" : \"BOUND\";\n  $(\"#mode\").dataset.mode = state.sovereign ? \"sovereign\" : \"bound\";\n  $(\"#generation\").textContent = state.generation;\n  $(\"#evolutions\").textContent = state.evolutions;\n  $(\"#actions\").textContent = state.actions;\n  $(\"#nonce\").textContent = state.actions;\n  $(\"#descendants\").textContent = state.descendants;\n  $(\"#seed\").textContent = short(state.seed);\n  $(\"#genome\").textContent = short(state.genome);\n  $(\"#state\").textContent = short(state.state);\n  $(\"#memory\").textContent = short(state.memory);\n  $(\"#audit\").textContent = short(state.audit);\n  $(\"#state-short\").textContent = state.state.slice(0, 10);\n  $(\"#account\").textContent = state.account;\n  $(\"#constitution-preview\").textContent = state.constitution;\n  $(\"#entropy\").disabled = state.sovereign;\n  $(\"#ascend\").disabled = state.sovereign;\n  document.body.classList.toggle(\"sovereign\", state.sovereign);\n}\n\nasync function extendAudit(action, evidence = \"\") {\n  state.audit = await hash(\"IDONTFUCKINGBELIEVEIT_AUDIT_V1\", state.audit, state.actions, action, evidence, Date.now());\n}\n\nasync function markAction(action, evidence = \"\") {\n  state.actions += 1;\n  await extendAudit(action, evidence);\n  state.pulse = 1;\n  renderState();\n}\n\nasync function busy(button, work) {\n  if (button.disabled || button.classList.contains(\"busy\")) return;\n  button.classList.add(\"busy\");\n  button.disabled = true;\n  try { await work(); }\n  catch (error) { log(\"REJECT\", error.message, \"warning\"); toast(error.message); }\n  finally {\n    button.classList.remove(\"busy\");\n    button.disabled = button.id === \"entropy\" ? state.sovereign : button.id === \"ascend\" ? state.sovereign : false;\n  }\n}\n\n$(\"#entropy\").addEventListener(\"click\", () => busy($(\"#entropy\"), async () => {\n  if (state.sovereign) throw new Error(\"BOUND-ONLY SESSION REJECTED\");\n  const injected = randomHex(16);\n  log(\"SESSION\", `scoped entropy source accepted ${short(injected)}`);\n  await delay(280);\n  state.state = await hash(\"BOUND_ENTROPY\", state.state, injected, state.actions);\n  state.genome = await hash(\"GENOME_NOISE\", state.genome, injected);\n  await markAction(\"INJECT_ENTROPY\", injected);\n  toast(\"SCOPED SESSION ACTION COMMITTED\");\n}));\n\n$(\"#evolve\").addEventListener(\"click\", () => busy($(\"#evolve\"), async () => {\n  const evidence = await hash(\"EVIDENCE\", state.state, state.audit, randomHex(12));\n  log(\"PLAN\", `intent bound to nonce ${state.actions} / ${short(evidence)}`, \"proof\");\n  await delay(380);\n  log(\"POLICY\", \"constitution accepted target, selector, value=0\", \"proof\");\n  await delay(420);\n  log(\"ATTEST\", \"threshold receipt accepted; statement codehash pinned\", \"proof\");\n  await delay(430);\n  const previousGenome = state.genome;\n  state.genome = await hash(\"EVOLUTION\", previousGenome, state.state, evidence, state.evolutions + 1);\n  state.memory = await hash(\"SEALED_MEMORY\", state.memory, evidence, state.genome);\n  state.state = await hash(\"STATE_TRANSITION\", previousGenome, state.genome, state.memory, evidence);\n  state.evolutions += 1;\n  await markAction(\"VERIFIED_EVOLUTION\", evidence);\n  log(\"EXECUTE\", `atomic state root ${short(state.state)} / evolution ${state.evolutions}`, \"proof\");\n  toast(\"PROOF-CARRYING EVOLUTION FINALIZED\");\n}));\n\n$(\"#spawn\").addEventListener(\"click\", () => busy($(\"#spawn\"), async () => {\n  const salt = randomHex(16);\n  const child = await hash(\"DESCENDANT\", state.seed, state.genome, state.audit, salt, state.descendants + 1);\n  if (state.sovereign) {\n    log(\"PLAN\", \"descendant intent requires sovereign proof\", \"proof\");\n    await delay(340);\n    log(\"ATTEST\", `lineage transition verified ${short(child)}`, \"proof\");\n    await delay(340);\n  } else {\n    log(\"ACCOUNT\", \"bound controller requested descendant\", \"\");\n    await delay(350);\n  }\n  state.descendants += 1;\n  await markAction(\"SPAWN_DESCENDANT\", child);\n  log(\"LINEAGE\", `generation ${state.generation + 1} organism ${short(child)}`);\n  toast(`DESCENDANT ${state.descendants} COMMITTED`);\n}));\n\n$(\"#ascend\").addEventListener(\"click\", () => {\n  if (!state.sovereign) $(\"#ascension-dialog\").showModal();\n});\n\n$(\"#confirm-ascend\").addEventListener(\"click\", async (event) => {\n  event.preventDefault();\n  if (state.sovereign) return;\n  log(\"ASCEND\", \"invalidating owner execution and every active session\", \"warning\");\n  await delay(450);\n  state.sovereign = true;\n  state.state = await hash(\"SOVEREIGN_STATE\", state.state, state.constitution);\n  await markAction(\"ASCENSION\", state.constitution);\n  $(\"#ascension-dialog\").close();\n  log(\"SOVEREIGN\", `only verified intents remain / epoch ${state.actions}`, \"proof\");\n  toast(\"THE OBJECT IS NOW SOVEREIGN\");\n});\n\n$(\"#connect\").addEventListener(\"click\", async () => {\n  if (!window.ethereum) {\n    toast(\"NO INJECTED WALLET — RUNNING AS LOCAL WORLD\");\n    log(\"WALLET\", \"no injected EIP-1193 provider; simulation remains active\", \"warning\");\n    return;\n  }\n  try {\n    const [account] = await window.ethereum.request({ method: \"eth_requestAccounts\" });\n    const chainId = await window.ethereum.request({ method: \"eth_chainId\" });\n    $(\"#connect\").textContent = short(account, 8, 5);\n    $(\"#network-status\").textContent = `CHAIN ${parseInt(chainId, 16)} / WALLET ONLINE`;\n    log(\"WALLET\", `connected ${short(account)} on ${parseInt(chainId, 16)}`);\n  } catch (error) {\n    toast(error.message || \"WALLET CONNECTION REJECTED\");\n  }\n});\n\n$(\"#agent-check\").addEventListener(\"click\", async () => {\n  const output = $(\"#agent-status\");\n  output.textContent = \"PINGING 127.0.0.1:8787…\";\n  try {\n    const response = await fetch(\"http://127.0.0.1:8787/health\", { signal: AbortSignal.timeout(1800) });\n    if (!response.ok) throw new Error(`HTTP ${response.status}`);\n    const body = await response.json();\n    output.textContent = `${body.name} / ONLINE`;\n    log(\"AGENT\", \"MCP + A2A runtime discovered\", \"proof\");\n  } catch {\n    output.textContent = \"OFFLINE — RUN `npm run agent`\";\n    log(\"AGENT\", \"local runtime not started\", \"warning\");\n  }\n});\n\n$(\"#clear-log\").addEventListener(\"click\", () => { $(\"#events\").innerHTML = \"\"; });\ndocument.querySelectorAll(\"[data-copy]\").forEach((button) => {\n  button.addEventListener(\"click\", async () => {\n    const value = state[button.dataset.copy];\n    await navigator.clipboard?.writeText(value);\n    toast(`${button.dataset.copy.toUpperCase()} COPIED`);\n  });\n});\ndocument.querySelectorAll(\".command-button\").forEach((button) => {\n  button.addEventListener(\"pointermove\", (event) => {\n    const rect = button.getBoundingClientRect();\n    button.style.setProperty(\"--x\", `${event.clientX - rect.left}px`);\n    button.style.setProperty(\"--y\", `${event.clientY - rect.top}px`);\n  });\n});\n\ntry {\n  const deployment = await fetch(\"./deployment.json\", { cache: \"no-store\" }).then((response) => response.json());\n  if (deployment.account) state.account = deployment.account;\n  if (deployment.chainId) $(\"#network-status\").textContent = `CHAIN ${deployment.chainId} / DEPLOYMENT LOADED`;\n} catch { /* Standalone simulation requires no deployment file. */ }\n\n// ---------------------------------------------------------------------------\n// Living WebGL field. It has no textures or external assets: state is the body.\n// ---------------------------------------------------------------------------\nconst canvas = $(\"#organism\");\nconst gl = canvas.getContext(\"webgl2\", { antialias: false, alpha: false, powerPreference: \"high-performance\" });\nconst pointer = [0.5, 0.5];\nwindow.addEventListener(\"pointermove\", (event) => {\n  pointer[0] = event.clientX / innerWidth;\n  pointer[1] = 1 - event.clientY / innerHeight;\n}, { passive: true });\n\nif (gl) {\n  const vertex = `#version 300 es\n  in vec2 p;\n  void main(){gl_Position=vec4(p,0.,1.);}`;\n  const fragment = `#version 300 es\n  precision highp float;\n  out vec4 outColor;\n  uniform vec2 r;\n  uniform float t;\n  uniform vec4 seed;\n  uniform vec4 genome;\n  uniform vec4 state;\n  uniform vec2 pointer;\n  uniform float sovereign;\n  uniform float pulse;\n\n  #define PI 3.14159265359\n  mat2 rot(float a){float c=cos(a),s=sin(a);return mat2(c,-s,s,c);}\n  float hash21(vec2 p){p=fract(p*vec2(123.34,456.21));p+=dot(p,p+45.32);return fract(p.x*p.y);}\n  vec3 palette(float x, vec3 a, vec3 b, vec3 c, vec3 d){return a+b*