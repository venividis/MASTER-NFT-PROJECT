t!important;width:100%;font-size:12px;line-height:1.6}.mem-editor .ix-small{margin:10px 0}#life-badge{position:fixed;z-index:7;top:calc(16% + 22px);left:50%;transform:translateX(-50%);font:7px var(--mono);letter-spacing:1.1px;color:#aec7d9;background:#080c1455;border:1px solid #b8d9e722;border-radius:20px;padding:7px 10px;cursor:pointer;max-width:70vw;white-space:nowrap}#life-badge:focus-visible{outline:2px solid var(--cyan)}@media(max-width:700px){.mem-stats{grid-template-columns:1fr}.mem-editor .ix-row{grid-template-columns:1fr}.mem-heading h3{font-size:26px}#life-badge{top:127px;font-size:6px}.mem-trade{padding:12px}.mem-note .ix-inline{flex-wrap:wrap}}
</style>
<dialog id="instrument-dialog" class="ix-dialog" aria-labelledby="ix-title">
 <header class="ix-header"><div><span class="ix-eyebrow">INSTRUMENTS / 1.7</span><h2 id="ix-title">One artifact. More possibilities.</h2></div><button type="button" id="ix-close" class="ix-close" aria-label="Return to organism">×</button></header>
 <div class="ix-context"><span class="ix-status">LOCAL REHEARSAL</span><label>Act as <select id="ix-actor" aria-label="Rehearsal persona"><option value="you">You</option><option value="guest">Guest</option></select></label><label>Artifact <select id="ix-identity" aria-label="Selected rehearsal artifact"></select></label></div>
 <nav class="ix-tabs" aria-label="NFT instruments"></nav>
 <section id="ix-content" class="ix-content"></section>
 <div id="ix-notice" role="status" aria-live="polite"></div>
 <footer class="ix-footer"><span>No real balances or transactions.</span><div><button data-act="receipts">Receipts</button><button data-act="capabilities">Capabilities</button><button data-act="export">Export</button><button data-act="import">Import</button><button data-act="clock">Test clock</button></div></footer>
</dialog>
<input id="ix-import" type="file" accept="application/json,.json" hidden>

<script id="instrument-runtime">(()=>{
"use strict";
/** Small, dependency-free Ethereum codec and explicit testnet transaction client.
 * No private keys, RPC endpoints, automatic accounts requests, or signing shortcuts.
 */
const MASK64=(1n<<64n)-1n;
const RC=[0x1n,0x8082n,0x800000000000808an,0x8000000080008000n,0x808bn,0x80000001n,0x8000000080008081n,0x8000000000008009n,0x8an,0x88n,0x80008009n,0x8000000an,0x8000808bn,0x800000000000008bn,0x8000000000008089n,0x8000000000008003n,0x8000000000008002n,0x8000000000000080n,0x800an,0x800000008000000an,0x8000000080008081n,0x8000000000008080n,0x80000001n,0x8000000080008008n];
const ROT=[0,1,62,28,27,36,44,6,55,20,3,10,43,25,39,41,45,15,21,8,18,2,61,56,14];
const rol=(n,r)=>r?((n<<BigInt(r))|(n>>BigInt(64-r)))&MASK64:n;
function bytesOf(hex){if(typeof hex!=='string'||!/^0x(?:[0-9a-fA-F]{2})*$/.test(hex))throw Error('Invalid hex bytes.');return Uint8Array.from(hex.slice(2).match(/../g)||[],x=>parseInt(x,16));}
function hexOf(bytes){return '0x'+Array.from(bytes,x=>x.toString(16).padStart(2,'0')).join('');}
function keccak256(input){const data=typeof input==='string'?new TextEncoder().encode(input):input;if(!(data instanceof Uint8Array))throw Error('Expected UTF-8 text or bytes.');const rate=136,pad=new Uint8Array(Math.ceil((data.length+1)/rate)*rate);pad.set(data);pad[data.length]=1;pad[pad.length-1]|=128;const a=Array(25).fill(0n);for(let off=0;off<pad.length;off+=rate){for(let i=0;i<rate;i++)a[i>>3]^=BigInt(pad[off+i])<<BigInt((i%8)*8);for(const rc of RC){const c=Array.from({length:5},(_,x)=>a[x]^a[x+5]^a[x+10]^a[x+15]^a[x+20]),d=c.map((_,x)=>c[(x+4)%5]^rol(c[(x+1)%5],1));for(let y=0;y<5;y++)for(let x=0;x<5;x++)a[x+y*5]^=d[x];const b=Array(25).fill(0n);for(let y=0;y<5;y++)for(let x=0;x<5;x++)b[y+((2*x+3*y)%5)*5]=rol(a[x+y*5],ROT[x+y*5]);for(let y=0;y<5;y++)for(let x=0;x<5;x++)a[x+y*5]=b[x+y*5]^((~b[(x+1)%5+y*5])&b[(x+2)%5+y*5]);a[0]^=rc;}}
 const out=new Uint8Array(32);for(let i=0;i<32;i++)out[i]=Number((a[i>>3]>>BigInt((i%8)*8))&255n);return hexOf(out);}
function address(value){if(typeof value!=='string'||!/^0x[0-9a-fA-F]{40}$/.test(value)||/^0x0{40}$/i.test(value))throw Error('Enter a nonzero 20-byte address.');return value.toLowerCase();}
function quantity(value){const n=BigInt(value);if(n<0n)throw Error('Negative quantity.');return '0x'+n.toString(16);}
const word=n=>{n=BigInt(n);if(n<0n||n>=1n<<256n)throw Error('ABI integer out of range.');return n.toString(16).padStart(64,'0');};
function fixed(type,value){if(Array.isArray(type)){if(!Array.isArray(value)||type.length!==value.length)throw Error('Tuple shape mismatch.');return type.map((t,i)=>fixed(t,value[i])).join('');}if(type==='address')return address(value).slice(2).padStart(64,'0');if(type==='bool'){if(typeof value!=='boolean')throw Error('Expected boolean.');return word(value?1:0);}if(/^uint(?:[0-9]+)?$/.test(type)){const bits=Number(type.slice(4)||256);if(bits<8||bits>256||bits%8)throw Error('Unsupported integer width.');const n=BigInt(value);if(n<0n||n>=(1n<<BigInt(bits)))throw Error('ABI integer out of range.');return word(n);}if(/^bytes\d+$/.test(type)){const size=Number(type.slice(5)),b=bytesOf(value);if(size<1||size>32||b.length!==size)throw Error('ABI fixed bytes size mismatch.');return value.slice(2).padEnd(64,'0');}throw Error('Unsupported static ABI type: '+type);}
function abiEncode(types,values){if(types.length!==values.length)throw Error('ABI arity mismatch.');const dynamic=t=>t==='bytes'||t==='string';let offset=types.reduce((n,t)=>n+(Array.isArray(t)?t.length:1)*32,0);const head=[],tail=[];types.forEach((t,i)=>{if(dynamic(t)){const b=t==='bytes'?bytesOf(values[i]):new TextEncoder().encode(values[i]);const body=word(b.length)+hexOf(b).slice(2).padEnd(Math.ceil(b.length/32)*64,'0');head.push(word(offset));tail.push(body);offset+=body.length/2;}else head.push(fixed(t,values[i]));});return '0x'+head.join('')+tail.join('');}
function callData(signature,types,values){return keccak256(signature).slice(0,10)+abiEncode(types,values).slice(2);}
function words(data,count){bytesOf(data);if(data.length!==2+count*64)throw Error('Unexpected contract response length.');return Array.from({length:count},(_,i)=>'0x'+data.slice(2+i*64,66+i*64));}
function safeNumber(v){const n=BigInt(v);if(n>BigInt(Number.MAX_SAFE_INTEGER))throw Error('Value exceeds the client safe-integer range.');return Number(n);}
const TEST_CHAINS=new Map([[31337,'LOCAL EVM'],[11155111,'SEPOLIA'],[84532,'BASE SEPOLIA']]);
const INTENT_TYPES=['address','uint256','bytes32','uint256','uint48','uint48','bytes32','bytes32','bytes32','bytes32','bytes32','uint32'];
const INTENT_FIELDS=['target','value','dataHash','nonce','validAfter','validUntil','priorStateRoot','nextStateRoot','nextMemoryRoot','policyHash','evidenceHash','verifierId'];
const intentValues=i=>INTENT_FIELDS.map(k=>i[k]);
const VERIFIED_SIG='executeVerified((address,uint256,bytes32,uint256,uint48,uint48,bytes32,bytes32,bytes32,bytes32,bytes32,uint32),bytes,bytes)';
function encodeVerified(intent,data,proof){if(keccak256(bytesOf(data))!==intent.dataHash.toLowerCase())throw Error('Intent does not bind this calldata.');return callData(VERIFIED_SIG,[INTENT_TYPES,'bytes','bytes'],[intentValues(intent),data,proof]);}
class TestnetClient {
 constructor(provider,onChange=()=>{}){if(!provider?.request)throw Error('No injected Ethereum wallet found. Open in a wallet-enabled browser.');this.provider=provider;this.onChange=onChange;this.revision=0;this.pending=false;this.connected=false;this.handle=()=>{this.revision++;this.connected=false;this.onChange('Wallet account or network changed. Reconnect before continuing.');};provider.on?.('accountsChanged',this.handle);provider.on?.('chainChanged',this.handle);provider.on?.('disconnect',this.handle);}
 async connect(collection,requestAccounts=true){this.collection=address(collection);const rev=this.revision;this.chainId=Number(BigInt(await this.provider.request({method:'eth_chainId'})));if(!TEST_CHAINS.has(this.chainId))throw Error('Mainnet and unknown chains are blocked. Select Sepolia, Base Sepolia, or local chain 31337.');const accounts=await this.provider.request({method:requestAccounts?'eth_requestAccounts':'eth_accounts'});if(!accounts?.length)throw Error('Wallet did not provide an account.');this.owner=address(accounts[0]);const code=await this.provider.request({method:'eth_getCode',params:[this.collection,'latest']});if(!code||code==='0x')throw Error('No collection contract exists at that address on this chain.');if(rev!==this.revision)throw Error('Wallet changed while connecting.');this.connected=true;return this;}
 async assertContext(){if(!this.connected)throw Error('Reconnect the wallet.');const [chain,accounts]=await Promise.all([this.provider.request({method:'eth_chainId'}),this.provider.request({method:'eth_accounts'})]);if(Number(BigInt(chain))!==this.chainId||!accounts?.length||address(accounts[0])!==this.owner){this.handle();throw Error('Wallet context changed. Nothing was sent.');}}
 async read(to,data,block='latest'){return this.provider.request({method:'eth_call',params:[{to:address(to),data},block]});}
 async snapshot(tokenId){await this.assertContext();const id=BigInt(tokenId);if(id<1n)throw Error('Token ID must be positive.');const rev=this.revision;const block=await this.provider.request({method:'eth_blockNumber'});const r=words(await this.read(this.collection,callData('renderSnapshot(uint256)',['uint256'],[id]),block),17);if(rev!==this.revision)throw Error('Wallet changed during the read.');if(BigInt(r[0])!==id)throw Error('Token ID response mismatch.');const meta=await this.provider.request({method:'eth_getBlockByNumber',params:[block,false]});if(!meta?.hash)throw Error('Block identity unavailable.');const bool=BigInt(r[14]);if(bool!==0n&&bool!==1n)throw Error('Invalid authority mode.');this.tokenId=id.toString();this.account=address('0x'+r[15].slice(-40));const s={tokenId:id.toString(),seed:r[1],genome:r[2],root:r[3],memory:r[4],lineage:r[5],audit:r[6],policy:r[7],createdAt:safeNumber(r[8])*1000,updatedAt:safeNumber(r[9])*1000,generation:safeNumber(r[10]),evolutions:safeNumber(r[11]),parentId:BigInt(r[12]).toString(),nonce:safeNumber(r[13]),sovereign:bool===1n,account:this.account,owner:address('0x'+r[16].slice(-40)),children:[],epoch:0,chainId:this.chainId,blockNumber:BigInt(block).toString(),blockHash:meta.hash};this.state=s;return s;}
 async prepare(label,to,data,{note='',onReceipt=null}={}){await this.assertContext();const revision=this.revision,tx={from:this.owner,to:address(to),data,value:'0x0',chainId:quantity(this.chainId)};bytesOf(data);await this.provider.request({method:'eth_call',params:[tx,'latest']});const estimate=BigInt(await this.provider.request({method:'eth_estimateGas',params:[tx]}));if(estimate<=0n||estimate>15000000n)throw Error('Gas estimate outside client safety bounds.');const gas=(estimate*120n+99n)/100n;const gasPrice=await this.provider.request({method:'eth_gasPrice'});return {label,tx:{...tx,gas:quantity(gas)},chainId:this.chainId,revision,note,estimatedGas:estimate.toString(),maxEstimatedFeeWei:(gas*BigInt(gasPrice)).toString(),onReceipt};}
 async send(plan,progress=()=>{},timeoutMs=180000){if(this.pending)throw Error('A transaction is already pending.');await this.assertContext();if(plan.revision!==this.revision||plan.chainId!==this.chainId||plan.tx.from!==this.owner)throw Error('Stale transaction review. Prepare it again.');this.pending=true;try{await this.provider.request({method:'eth_call',params:[plan.tx,'latest']});await this.assertContext();if(plan.revision!==this.revision)throw Error('Wallet changed during simulation. Nothing was sent.');const hash=await this.provider.request({method:'eth_sendTransaction',params:[plan.tx]});if(!/^0x[0-9a-fA-F]{64}$/.test(hash))throw Error('Wallet returned an invalid transaction hash.');progress('SUBMITTED',hash);const started=Date.now();while(Date.now()-started<timeoutMs){await this.assertContext();const r=await this.provider.request({method:'eth_getTransactionReceipt',params:[hash]});if(r){if(BigInt(r.status)!==1n)throw Error('Transaction reverted. Local identity was not advanced. Hash: '+hash);if(!r.blockHash||!r.blockNumber)throw Error('Receipt is not included in a block.');const block=await this.provider.request({method:'eth_getBlockByNumber',params:[r.blockNumber,false]});if(block?.hash?.toLowerCase()!==r.blockHash.toLowerCase())throw Error('Receipt block changed. Refresh chain state; do not assume finality.');progress('INCLUDED',hash);await plan.onReceipt?.(r);return r;}await new Promise(resolve=>setTimeout(resolve,900));}throw Error('Still pending. Do not send again blindly. Transaction hash: '+hash);}finally{this.pending=false;}}
 async evolution(salt,verifierId=1){const s=await this.snapshot(this.tokenId);const newGenome=keccak256(bytesOf(abiEncode(['bytes32','bytes32'],[s.genome,salt]))),newMemory=keccak256(bytesOf(abiEncode(['bytes32','bytes32'],[s.memory,newGenome]))),evidence=keccak256(bytesOf(abiEncode(['bytes32','bytes32'],[s.root,salt])));if(!s.sovereign)return this.prepare('EVOLVE',s.account,callData('evolveBound(uint256,bytes32,bytes32,bytes32)',['uint256','bytes32','bytes32','bytes32'],[s.nonce,newGenome,newMemory,evidence]),{note:'Requires the v1.2 account implementation. Genome and roots advance atomically; ETH value is zero.'});const data=callData('commitEvolution(uint256,bytes32,bytes32,bytes32)',['uint256','bytes32','bytes32','bytes32'],[this.tokenId,newGenome,newMemory,evidence]);const nextStateRoot=words(await this.read(this.collection,callData('deriveEvolutionStateRoot(uint256,bytes32,bytes32,bytes32)',['uint256','bytes32','bytes32','bytes32'],[this.tokenId,newGenome,newMemory,evidence])),1)[0];const latest=await this.provider.request({method:'eth_getBlockByNumber',params:['latest',false]}),now=safeNumber(latest.timestamp);const intent={target:this.collection,value:'0',dataHash:keccak256(bytesOf(data)),nonce:String(s.nonce),validAfter:now,validUntil:now+1800,priorStateRoot:s.root,nextStateRoot,nextMemoryRoot:newMemory,policyHash:s.policy,evidenceHash:evidence,verifierId};const statement=words(await this.read(s.account,callData('intentStatement((address,uint256,bytes32,uint256,uint48,uint48,bytes32,bytes32,bytes32,bytes32,bytes32,uint32))',[INTENT_TYPES],[intentValues(intent)])),1)[0];return {schema:'idfbi/sovereign-evolution/1',chainId:this.chainId,collection:this.collection,account:s.account,tokenId:this.tokenId,intent,data,statement,proofRequired:true};}
 async verifiedEvolution(request,proof){await this.assertContext();if(request.chainId!==this.chainId||address(request.account)!==this.account||address(request.collection)!==this.collection)throw Error('Proof request belongs to a different deployment.');if(typeof proof!=='string'||bytesOf(proof).length===0||proof.length>262146)throw Error('A nonempty verifier proof is required (maximum 128 KiB).');return this.prepare('PROOF-AUTHORIZED EVOLUTION',this.account,encodeVerified(request.intent,request.data,proof),{note:'eth_call must accept this proof against the deployed verifier. This client does not generate ZK or TEE proofs.'});}
 async spawn(salt){await this.snapshot(this.tokenId);if(this.state.sovereign)throw Error('Sovereign descendants require a proof-authorized intent. Use the account SDK; the preview does not manufacture a proof.');const inner=callData('spawnFromAccount(uint256,address,bytes32)',['uint256','address','bytes32'],[this.tokenId,this.owner,salt]);return this.prepare('SPAWN DESCENDANT',this.account,callData('execute(address,uint256,bytes)',['address','uint256','bytes'],[this.collection,0,inner]),{note:'A real descendant NFT is minted to the connected wallet. No endowment is sent.'});}
 async seal(commitment){await this.snapshot(this.tokenId);if(this.state.sovereign)throw Error('Sovereign metadata writes require a valid proof. No owner bypass is available.');return this.prepare('SEAL MEMORY DIGEST',this.collection,callData('setMetadata(uint256,string,bytes)',['uint256','string','bytes'],[this.tokenId,'memory.commitment',commitment]),{note:'Stores a digest under memory.commitment; it does not change the account memory root or preserve the thought.'});}
 async ascend(policy){await this.snapshot(this.tokenId);return this.prepare('IRREVERSIBLE ASCENSION',this.collection,callData('ascend(uint256,bytes32,uint96,uint32)',['uint256','bytes32','uint96','uint32'],[this.tokenId,policy,0,0]),{note:'PERMANENT: direct owner execution and transfer stop. ETH action limit becomes zero. Without working proof infrastructure this NFT may become unusable. Testnet only.'});}
 close(){this.provider.removeListener?.('accountsChanged',this.handle);this.provider.removeListener?.('chainChanged',this.handle);this.provider.removeListener?.('disconnect',this.handle);this.connected=false;this.revision++;}
}


/** Deterministic, unsigned local rehearsal. Not an EVM emulator, price feed or wallet. */
const E18=10n**18n;
const HOOK_FLAGS=(1<<13)|(1<<9)|(1<<7)|(1<<6);
const MAX112=(1n<<112n)-1n;
function wei(text){if(!/^\d+(\.\d{1,18})?$/.test(String(text)))throw Error('Use a positive decimal with at most 18 places.');const [a,b='']=String(text).split('.');const n=BigInt(a)*E18+BigInt(b.padEnd(18,'0'));if(n>MAX112)throw Error('Amount is outside the supported range.');return n;}
function format(n,places=4){n=BigInt(n);const negative=n<0n;if(negative)n=-n;const whole=n/E18,tail=(n%E18).toString().padStart(18,'0').slice(0,places).replace(/0+$/,'');return(negative?'-':'')+whole.toLocaleString('en-US')+(tail?'.'+tail:'');}
function stable(v){if(Array.isArray(v))return '['+v.map(stable).join(',')+']';if(v&&typeof v==='object')return '{'+Object.keys(v).sort().map(k=>JSON.stringify(k)+':'+stable(v[k])).join(',')+'}';return JSON.stringify(v);}
function fingerprint(v){return keccak256(stable(v));}
function feeAt(born,now){if(now<=born)return 10000;if(now>=born+86400)return 3000;return 10000-Math.floor(7000*(now-born)/86400);}
function releasable(lock,now){if(now<lock.cliff)return 0n;const total=BigInt(lock.amount),vested=now>=lock.end?total:lock.linear?total*BigInt(now-lock.start)/BigInt(lock.end-lock.start):0n;return vested-BigInt(lock.released);}
function amount(n){n=BigInt(n);if(n<=0n||n>MAX112)throw Error('Amount must be positive and within the supported range.');return n;}
function text(s,max){s=String(s).trim();if(!s||new TextEncoder().encode(s).length>max)throw Error('Text must contain 1–'+max+' UTF-8 bytes.');return s;}
function take(balances,asset,n){n=amount(n);const b=BigInt(balances[asset]||0);if(b<n)throw Error('Insufficient rehearsal '+asset+' balance.');balances[asset]=(b-n).toString();}
function give(balances,asset,n){balances[asset]=(BigInt(balances[asset]||0)+BigInt(n)).toString();}
class KingdomModel {
 constructor(now=Math.floor(Date.now()/1000)){
  this.s={schema:'idfbi/kingdom-rehearsal/1.4',now,actor:'you',selected:1,next:4,seq:0,head:'0x'+'00'.repeat(32),wallets:{you:wei('25').toString(),guest:wei('12').toString(),archivist:wei('2').toString(),weaver:wei('2').toString()},identities:[
   {id:1,name:'The Phoenix Sanctum',owner:'you',epoch:1,nonce:0,seed:17,color:0,balances:{ETH:wei('8').toString(),AUR:wei('12000').toString()},lease:null},
   {id:204,name:'The Lumen Archive',owner:'archivist',epoch:1,nonce:0,seed:71,color:1,balances:{ETH:wei('1.25').toString(),AUR:wei('3600').toString()},lease:null},
   {id:317,name:'The Vesper Atelier',owner:'weaver',epoch:1,nonce:0,seed:123,color:2,balances:{ETH:wei('0.6').toString(),AUR:wei('1400').toString()},lease:null}],
   pools:[{asset:'AUR',name:'Aurora / rehearsal market',native:wei('100').toString(),tokens:wei('1000000').toString(),born:now-172800,creator:1}],sales:[],locks:[
    {id:1,identity:1,asset:'AUR',amount:wei('25000').toString(),released:'0',start:now-86400,cliff:now+29*86400,end:now+179*86400,linear:true},
    {id:2,identity:204,asset:'AUR',amount:wei('50000').toString(),released:'0',start:now,cliff:now+90*86400,end:now+90*86400,linear:false}],listings:[],
   rooms:[{id:1,name:'World',topic:'One shared sky. Public text; your own filters.',identity:0,gated:false,slow:3,color:'#a6e6e8',members:{},bans:[],moderators:{}},
    {id:2,name:'Sanctum Council',topic:'The room follows the artifact. The people do not.',identity:1,gated:true,slow:3,color:'#cfb9f6',members:{you:{accepted:true,epoch:1}},bans:[],moderators:{}}],messages:[],events:[],views:{you:{follow:['archivist'],block:[]},guest:{follow:[],block:[]}},settings:{motion:true,sound:false,accent:'#b5eeea'}};
  this._event('AWAKEN',1,{note:'Three fictional estates. All balances and people in this rehearsal are examples.'});
  this._post('archivist',1,0,'An artifact can carry its history without pretending the next owner wrote it.',0,0);
  this._post('weaver',1,0,'Open an estate. Move its time lens. The locked allocation becomes visible before it becomes spendable.',0,0);
  this._list(204,'archivist',wei('6.8'),now+7*86400);
  this._list(317,'weaver',wei('3.4'),now+7*86400);
 }
 identity(id=this.s.selected){const a=this.s.identities.find(x=>x.id===Number(id));if(!a)throw Error('Unknown artifact.');return a;}
 room(id){const r=this.s.rooms.find(x=>x.id===Number(id));if(!r)throw Error('Unknown room.');return r;}
 _owner(id){const a=this.identity(id);if(a.owner!==this.s.actor)throw Error('Only the current owner can spend or change this artifact.');return a;}
 _tx(fn){const before=structuredClone(this.s);try{return fn();}catch(e){this.s=before;throw e;}}
 _event(kind,id,data={},actor=this.s.actor){const a=id?this.identity(id):null;const e={seq:++this.s.seq,kind,identity:id,actor,custodian:a?.owner||actor,epoch:a?.epoch||0,time:this.s.now,data,provenance:'UNSIGNED LOCAL REHEARSAL',prior:this.s.head};e.digest=fingerprint(e);this.s.head=e.digest;this.s.events.push(e);return e;}
 setActor(actor){if(!['you','guest'].includes(actor))throw Error('Choose a rehearsal persona.');this.s.actor=actor;}
 select(id){this.identity(id);this.s.selected=Number(id);}
 advance(seconds){if(!Number.isSafeInteger(seconds)||seconds<=0||seconds>3650*86400)throw Error('Invalid rehearsal time step.');this.s.now+=seconds;this._event('TIME',0,{seconds});}
 createLaunch({name,symbol,supply=wei('1000000'),soft=wei('1'),hard=wei('20'),hours=24,founderBps=1000,liquidityBps=8000}){
  return this._tx(()=>{const a=this._owner(this.s.selected);name=text(name,48);symbol=text(symbol.toUpperCase(),12);if(!/^[A-Z][A-Z0-9]{1,11}$/.test(symbol)||symbol==='ETH'||this.s.pools.some(x=>x.asset===symbol)||this.s.sales.some(x=>x.symbol===symbol))throw Error('Choose a unique 2–12-character ticker.');
   supply=amount(supply);soft=amount(soft);hard=amount(hard);if(supply<E18||soft>hard||hours<1||hours>720||!Number.isInteger(hours)||founderBps<0||founderBps>2000||!Number.isInteger(founderBps)||liquidityBps<5000||liquidityBps>10000||!Number.isInteger(liquidityBps))throw Error('Invalid immutable launch terms.');
   const founder=supply*BigInt(founderBps)/10000n,pub=(supply-founder)*10000n/BigInt(10000+liquidityBps),lp=supply-founder-pub,id=this.s.sales.length+1;
   const sale={id,name,symbol,creator:a.id,supply: