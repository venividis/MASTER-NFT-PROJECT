"};
const IX_CATALOG={"schema":"idfbi/capability-catalog/1.7","deployment":null,"mainnetEnabled":false,"warning":"Readiness is not permission. No enabled live-chain modules in this release. Research entries are not implemented features hidden by switches.","modules":[{"id":"launch","label":"Launch + token commons","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["collection","account","ledger","vault","v4-market","hook"],"authority":"account owner in Bound mode; no new sovereign bypass","privacy":"public","exit":"withdraw before close; failure refund","economics":"batch/pro-rata; not CCA"},{"id":"swap","label":"Swap + optional output lock","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["market","vault"],"authority":"exact reviewed input and minimum output","privacy":"public","exit":"atomic revert; no post-swap undo","economics":"local reserve approximation; separate v4 source"},{"id":"gift","label":"Consent-based future gift","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["sealed ledger","market","vault"],"authority":"donor funds; recipient accepts; fixed beneficiary","privacy":"public","exit":"donor recall until acceptance; permissionless expiry return; no early exit after acceptance"},{"id":"marketplace","label":"Declared-content artifact sale","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["account","exchange","vault","immutable commitment index","edition and account revision","known root and cell obligations"],"authority":"escrow and two inventory checks","privacy":"public","exit":"cancel listing; no reversal of completed purchase","limitations":"Bounded declared module universe, not discovery of all external liabilities. Local exact hashes differ from contract predicates."},{"id":"world","label":"Rooms, invitations, historical authorship","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["ledger"],"authority":"personal filters separate from room administration","privacy":"public text, including member-gated rooms","exit":"leave/mute without deleting others' history"},{"id":"cca","label":"Continuous clearing launch","state":"RESEARCH_NOT_IMPLEMENTED","dependencies":["pinned CCA deployment","liquidity strategy","v4 market compatibility"],"exit":"mechanism-specific withdrawal/refund conditions"},{"id":"private-agent","label":"Private agent memory transfer","state":"RESEARCH_NOT_IMPLEMENTED","dependencies":["ERC-7857 prover/verifier","encrypted data availability","key handover","compute payment"],"privacy":"requires actual cryptographic implementation"},{"id":"agent-execution","label":"Scoped agent operations","state":"RESEARCH_NOT_IMPLEMENTED","dependencies":["runtime","bounded grants","revocation","tool verification"],"authority":"a model's proposal is not spending permission"},{"id":"omnichain","label":"Authenticated remote portals","state":"RESEARCH_NOT_IMPLEMENTED","dependencies":["authenticated transport","finality policy","replay domains","custody epochs"],"authority":"one authoritative home; remote view does not duplicate spend authority"},{"id":"private-chat","label":"Encrypted rooms","state":"RESEARCH_NOT_IMPLEMENTED","dependencies":["MLS implementation","key packages","membership epochs","backup policy"],"privacy":"old members can retain old plaintext"},{"id":"public-goods","label":"Matching pools and patronage","state":"RESEARCH_NOT_IMPLEMENTED","dependencies":["matching budget","Sybil policy","collusion review","credible exit"]},{"id":"sponsored-actions","label":"Sponsored and delegated interactions","state":"RESEARCH_NOT_IMPLEMENTED","dependencies":["account abstraction adapter","paymaster budget","spam limits","revocation"]},{"id":"library","label":"Publish, adopt and grant an instrument","tier":"core","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["edition registry","custody epoch","finite router"],"authority":"Public code is not permission. Seven-day adoption; exact caller, calldata, target, per-call/lifetime ceiling and expiry.","exit":"Immediate revocation; custody change invalidates grant.","limitations":"Local recipes include the existing action vocabulary. Dedicated onchain router implements swap/direct lock; no arbitrary bytecode or AI executor."},{"id":"commission","label":"Prefunded work and acceptance","tier":"core","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["commission escrow","fixed reviewer","deliverable hash"],"authority":"Worker accepts a fixed personal reviewer and deadline/refund policy. Selling the NFT does not change either person.","exit":"Payment on acceptance or refund after rejection/timeout.","limitations":"Human judgment is not verified task correctness. No appeals or automatic compensation. Source stores a deliverable digest; local model additionally binds its edition author."},{"id":"shelves","label":"Artifact-owned bonded sell shelves","tier":"core","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["item custody","fixed ask","fixed bond"],"authority":"Item and proceeds held separately; market operating rights follow the artifact.","exit":"After fixed bond, return unsold item or withdraw proceeds.","limitations":"One fixed-price sell shelf; not a buy wall, two-sided AMM or a whole-artifact exchange. Rehearsal collectibles are fictional."},{"id":"commitments","label":"Commitment-aware artifact exchange","tier":"core","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["module adapters","cell factory","pre/post transfer checks"],"authority":"Listing commits to known gifts, grants, work, cells, venues and schedules.","exit":"Seller refreshes a changed manifest; old buyer review cannot execute.","limitations":"New deployments and explicit configuration required. Old immutable accounts and exchanges are unchanged."},{"id":"granary","label":"Strategy-share conversion","tier":"experimental","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["isolated cell","reviewed ERC-4626 vault","minimum outputs"],"authority":"Only explicitly funded cell assets; recipient pinned to that cell.","exit":"Redeem subject to the underlying strategy; no promise of liquidity.","limitations":"Local model is not a live strategy and promises no yield. External vault solvency remains separate."},{"id":"issue","label":"Fixed basket issuance","tier":"experimental","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["isolated cell","two supported assets","ceil/floor accounting"],"authority":"Round deposits up and redemptions down; measure exact receipts.","exit":"Redeem shares against specified backing.","limitations":"Not the original underfunded Issue implementation. Simplified two-asset basket; source dust has a fixed beneficiary."},{"id":"strips","label":"Matched principal / income study","tier":"experimental","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["isolated cell","matched share accounting"],"authority":"Proportional recombination of matched pairs including losses.","exit":"Return proportional remaining backing; no nominal-principal priority.","limitations":"Not separately tradable principal/yield tokens or a live yield market."},{"id":"counter","label":"Negotiated collateralized credit","tier":"experimental","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["isolated cell","escrow collateral","fixed dates"],"authority":"Named parties, collateral and exact repayment; no oracle or root-NFT pawn authority.","exit":"Repay before due; collateral to lender at/after default deadline.","limitations":"Not flash liquidity, dynamic liquidation, unrestricted lending or a safety endorsement."},{"id":"scrivener","label":"Physically covered calls","tier":"experimental","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["isolated cell","escrow cover","fixed strike/premium"],"authority":"Full cover at creation; only named holder exercises before expiry.","exit":"Writer cancellation before sale; unsatisfied expiry returns cover.","limitations":"No naked options, oracle pricing or promised fair premium."},{"id":"site-editions","label":"Application-edition commitments","tier":"core","state":"LOCAL_ONLY","dependencies":["content hash","byte count","prepared immutable archive"],"authority":"Records identify a version; no uploaded program is evaluated.","exit":"Read-only version history.","limitations":"A hash is not stored application bytes. Release HTML archive chunks are prepared locally, not deployed."},{"id":"house","label":"Leveraged markets","tier":"experimental-specification","state":"SPECIFICATION_ONLY","dependencies":["robust valuation","loss waterfall","economic tests"],"authority":"No callable financial executor or activation switch in this release.","limitations":"Dave source counterexamples remain unresolved for integration; architecture slot is not a completed module."},{"id":"wager","label":"Outcome markets","tier":"experimental-specification","state":"SPECIFICATION_ONLY","dependencies":["question commitment","resolution authority","dispute and expiry policy"],"authority":"No callable financial executor or activation switch in this release.","limitations":"Dave source counterexamples remain unresolved for integration; architecture slot is not a completed module."},{"id":"wake","label":"Exclusive keeper windows","tier":"experimental-specification","state":"SPECIFICATION_ONLY","dependencies":["pull proceeds","fractional rent","liveness design"],"authority":"No callable financial executor or activation switch in this release.","limitations":"Dave source counterexamples remain unresolved for integration; architecture slot is not a completed module."},{"id":"memory","label":"Decision journal and general memories","tier":"core","state":"LOCAL_AND_UNCOMPILED_SOURCE","dependencies":["append-only envelope","exact-plan binding","actual successful fill","original authorship"],"authority":"Writing does not authorize a trade. Reflections belong to the original author; NFT sale does not transfer a decryption key.","privacy":"Explicit public body or client-encrypted AES-GCM body. Headers and timing are not confidential.","exit":"Export a complete archive; keep the passphrase separately. No recovery from the discarded original Seal Memory.","limitations":"Browser-tested public local flow and fail-closed crypto availability. Encryption roundtrip tested with native Node Web Crypto; secure-browser encrypted E2E still required. No blockchain deployment."},{"id":"lived-form","label":"Activity-shaped optical form","tier":"presentation","state":"LOCAL_ONLY","dependencies":["admitted local receipts","versioned bounded reducer","shared GLSL/Wasm field"],"authority":"A view projection, not account authority, rarity, reputation or financial value.","privacy":"No interpretation or display of private words. Optional memory imprint can be omitted; action metadata remain visible.","exit":"Compare original or inspect an earlier activity layer without undoing actions.","limitations":"History uses the current base genome. Finite visual parameters are not collision-resistant identity. Full protocol-wide onchain event admission, reorg handling and metadata linkage are not implemented."},{"id":"journal-swap-source","label":"Atomic onchain journaled-swap source","tier":"protocol","state":"UNCOMPILED_SOURCE_ONLY","dependencies":["MemoryLedger","JournalSwapRouter","existing v4 market","NFT account execution","reviewed client crypto envelope"],"authority":"Exact nonce, input, minimum output, deadline, temporary allowance and caller-account recipient.","privacy":"Contract stores full public bytes or supplied ciphertext; it receives no decryption key and cannot certify encryption.","limitations":"No deployed route or wallet adapter. Narrow source returns output to the account, without the local UI optional output lock. Custodian-at-time is not falsely labeled the human author of an account-triggered operation."}]};
/* This controller is an additive, isolated layer. It never edits ASSETS, OpticalField,
 * the original receipt book, original identity or wallet integration. A separate versioned bridge projects activity into optics. */
const IX_TABS=[['trade','Trade'],['journal','Memory'],['launch','Launch'],['vault','Lock'],['give','Give'],['market','Market'],['world','World'],['library','Library'],['work','Work'],['ledger','Commitments'],['lab','Lab']];
const ix$=s=>document.querySelector(s);
const esc=v=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const when=t=>new Date(t*1000).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'});
const money=(n,asset)=>format(n,6)+' '+esc(asset);
const short=v=>String(v).slice(0,12)+'…'+String(v).slice(-8);
const B=(act,label,id='',cls='',disabled=false)=>`<button type="button" class="ix-button ${cls}" data-act="${act}" data-id="${esc(id)}" ${disabled?'disabled':''}>${label}</button>`;
const fact=(k,v)=>`<div class="ix-fact"><span>${k}</span><strong>${v}</strong></div>`;
const field=(label,name,value,type='text')=>`<div class="ix-field"><label for="ix-${name}">${label}</label><input id="ix-${name}" name="${name}" type="${type}" value="${esc(value)}" ${type==='number'?'step="1"':''}></div>`;
const personLabel=p=>p==='you'?'You':p==='guest'?'Guest':p==='archivist'?'Example collector A':p==='weaver'?'Example collector B':'Listing escrow';
let ixEngine,ixView='trade',ixRoom=1,ixReceipt=0,ixReply=0,ixInspect=0,ixFuture=0,ixFilter='all',ixReview=null,ixStored=null,ixStore,ixSeed,ixBusy=false,ixCorrupt=false;
const W=()=>ixEngine.world;
const anchor=()=>window.__idfbi.world().state.audit;
const input=id=>ix$('#ix-'+id)?.value;
function sourceCheck(){const s=window.__idfbi;if(s.chain())throw Error('The instruments have no live-chain adapter. Disconnect the original testnet client to rehearse.');if(s.state().root!==s.world().state.root)throw Error('History and descendants are read-only. Return the organism to its present first.');if(s.state().sovereign)throw Error('Sovereign utility execution requires a valid proof adapter. This rehearsal does not bypass that policy.');if(s.world().state.seed!==ixSeed)throw Error('The original identity changed. Reload to open its separate instruments.');}
function notice(text,error=false){const n=ix$('#ix-notice');n.textContent=text;n.dataset.error=String(error);}
function savedCheck(){if(ixStored===null)return;let current;try{current=localStorage.getItem(ixStore);}catch{return;}if(current!==ixStored)throw Error('Another tab changed this instrument archive. Export your open state before reloading.');}
function persist(){const data=JSON.stringify({schema:'idfbi/instrument-file/1.7',originSeed:ixSeed,originAudit:anchor(),engine:ixEngine.export()});try{localStorage.setItem(ixStore,data);ixStored=data;}catch{ixStored=null;notice('Browser storage is unavailable. Export this rehearsal to retain it.');}}
function saveFile(data,name){const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),10000);}
async function perform(fn,message='Applied in the local rehearsal.',replaceCorrupt=false){
 if(ixBusy)return;ixBusy=true;
 try{const job=()=>{sourceCheck();savedCheck();if(ixCorrupt&&!replaceCorrupt)throw Error('The saved archive is corrupt and has been preserved. Import a valid export to replace it explicitly.');const old=ixEngine;old.atomic(()=>{fn();savedCheck();});ixCorrupt=false;persist();};
  if(navigator.locks?.request)await navigator.locks.request(ixStore,job);else job();
  ixReview=null;draw();notice(message); // No visual success is converted into an onchain receipt.
 }catch(e){notice(e.message,true);}finally{ixBusy=false;}
}
function assets(selected='ETH'){return ['ETH',...W().s.pools.map(p=>p.asset)].map(a=>`<option value="${esc(a)}" ${a===selected?'selected':''}>${esc(a)}</option>`).join('');}
function amountBox(asset='ETH',amount='0.1'){return `<label for="ix-amount">You provide</label><div class="ix-asset"><input id="ix-amount" name="amount" value="${amount}" inputmode="decimal" aria-label="Input amount"><select id="ix-input" name="input" aria-label="Input asset">${assets(asset)}</select></div>`;}
function recipient(g){return g.recipient.kind==='person'?personLabel(g.recipient.id)+' ·