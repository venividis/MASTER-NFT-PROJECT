  .anima-modules .am-tabs button{font-size:14px;min-height:50px}
  .anima-modules .am-example{min-height:142px;padding-left:145px}
  .anima-modules .am-example-art{width:125px}
  .anima-modules .am-continuity .am-section-heading{align-items:flex-start}
}
