<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#04091a"><meta name="description" content="Recoverable tools, memories and small worlds for the ANIMA NFT you already own."><title>ANIMA · Prism Cathedral — Module Workbench</title><style>/* Prism Cathedral II — a quiet instrument around a living, procedural loom. */
.am-standalone{margin:0;background:#070b1b;color:#f4f0ff;color-scheme:dark}
.am-standalone noscript{display:block;padding:24px;font:16px/1.6 system-ui,sans-serif}
.anima-modules{
  --am-bg:#070b1b;--am-panel:#10142a;--am-line:#536397;--am-ink:#f4f0ff;
  --am-muted:#b7bdda;--am-blue:#477cff;--am-cyan:#7ceaff;--am-violet:#b09bff;
  --am-rose:#f2a9da;--am-mono:ui-monospace,SFMono-Regular,Consolas,"Liberation Mono",monospace;
  position:relative;isolation:isolate;container-type:inline-size;box-sizing:border-box;min-height:100%;padding:0 clamp(16px,3vw,56px);
  overflow:hidden;background:var(--am-bg);color:var(--am-ink);color-scheme:dark;
  font:15px/1.6 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased;
}
.anima-modules *{box-sizing:border-box}
.anima-modules [hidden]{display:none!important}
.anima-modules button,.anima-modules input,.anima-modules textarea,.anima-modules select{font:inherit}
.anima-modules button{cursor:pointer;touch-action:manipulation}
.anima-modules button:disabled{cursor:not-allowed;opacity:.48}
.anima-modules :focus-visible{outline:3px solid var(--am-cyan);outline-offset:4px}
.anima-modules ::selection{background:#477cff66;color:#fff}
.anima-modules h1,.anima-modules h2,.anima-modules h3,.anima-modules p{margin:0}
.anima-modules h2{font-size:clamp(20px,1.65vw,27px);font-weight:450;line-height:1.3;letter-spacing:-.02em}
.anima-modules h3{font-size:21px;font-weight:500;line-height:1.35;letter-spacing:-.015em}
.anima-modules code{font:14px/1.65 var(--am-mono);overflow-wrap:anywhere}
.anima-modules .am-backdrop{
  pointer-events:none;position:absolute;z-index:-1;inset:0;
  background:radial-gradient(ellipse at 0% 16%,#2649b022,transparent 35%),radial-gradient(ellipse at 100% 27%,#60418a1b,transparent 36%),radial-gradient(ellipse at 35% 80%,#295d8a0e,transparent 40%);
}
.anima-modules .am-backdrop:before{
  content:"";position:absolute;inset:0;opacity:.4;
  background-image:radial-gradient(circle,#b09bff 0 .55px,transparent .9px),radial-gradient(circle,#7ceaff 0 .55px,transparent .9px);
  background-size:149px 193px,211px 137px;background-position:31px 47px,103px 89px;
  mask-image:linear-gradient(#000,transparent 80%);
}
.anima-modules .am-top,.anima-modules .am-intro,.anima-modules .am-identity,.anima-modules .am-notice,.anima-modules .am-layout,.anima-modules .am-continuity,.anima-modules .am-runtime,.anima-modules .am-footer{max-width:1640px;margin-inline:auto}
.anima-modules .am-top{position:relative;min-height:92px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid #b09bff65}
.anima-modules .am-top:after{content:"";position:absolute;inset:auto 0 -1px;height:1px;background:linear-gradient(90deg,#7ceaff,transparent 30%,#b09bff 70%,#f2a9da);box-shadow:0 0 12px #7c9aff4d;pointer-events:none}
.anima-modules .am-brand{display:flex;align-items:center;text-decoration:none;color:var(--am-ink);letter-spacing:.32em;font-size:28px;font-weight:350;line-height:1.1;min-height:48px}
.anima-modules .am-brand small{display:block;font:10px/1.8 var(--am-mono);letter-spacing:.17em;color:var(--am-violet);margin-top:7px}
.anima-modules .am-edition{font:14px/1.5 var(--am-mono);letter-spacing:.17em;color:#d8d2ef;white-space:nowrap}
.anima-modules .am-edition span{color:var(--am-violet)}
.anima-modules .am-top-right{display:flex;align-items:center;gap:18px}
.anima-modules .am-status-pill{font:14px/1.6 var(--am-mono);color:var(--am-muted);border:1px solid #8177b982;border-radius:4px;padding:8px 12px;max-width:260px;overflow-wrap:anywhere}
.anima-modules .am-status-pill:before{content:"";display:inline-block;width:6px;height:6px;margin-right:9px;border:1px solid var(--am-muted);border-radius:50%}
.anima-modules .am-intro{display:flex;justify-content:space-between;align-items:center;padding:34px 0 30px;gap:36px}
.anima-modules .am-eyebrow{display:block;font:10px/1.6 var(--am-mono);letter-spacing:.15em;color:var(--am-violet);margin-bottom:10px}
.anima-modules h1{font-weight:350;letter-spacing:-.045em;line-height:1.08;font-size:clamp(36px,3.7vw,58px)}
.anima-modules .am-intro p{max-width:485px;color:var(--am-muted);font-size:14px;line-height:1.8}
.anima-modules .am-card{background:linear-gradient(135deg,#11172df5,#0a1021f5);border:1px solid #6776ad70;border-radius:7px;box-shadow:inset 0 1px 0 #d7d3ff0a,0 16px 45px #02040c24}
.anima-modules .am-identity{padding:20px 24px}
.anima-modules .am-section-heading{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:18px;min-width:0}
.anima-modules .am-section-heading .am-eyebrow{margin-bottom:5px}
.anima-modules .am-identity h2{font-size:19px}
.anima-modules .am-identity-form{display:grid;grid-template-columns:minmax(80px,.65fr) minmax(180px,1.9fr) minmax(70px,.65fr) minmax(180px,1.9fr) auto;gap:14px;align-items:end}
.anima-modules label{display:grid;gap:7px;font-size:14px;letter-spacing:.015em;color:#d0d2e9;min-width:0}
.anima-modules input,.anima-modules textarea,.anima-modules select{width:100%;min-width:0;min-height:46px;display:block;padding:11px 12px;border:1px solid #717ba772;border-radius:4px;background:#070d20;color:var(--am-ink);font-size:16px;outline-offset:3px}
.anima-modules input:hover,.anima-modules textarea:hover,.anima-modules select:hover{border-color:#999bd1b3}
.anima-modules input::placeholder,.anima-modules textarea::placeholder{color:#969fbc;opacity:1}
.anima-modules textarea{resize:vertical;line-height:1.7}
.anima-modules select option{color:var(--am-ink);background:var(--am-bg)}
.anima-modules .am-primary,.anima-modules .am-secondary{min-height:46px;border:1px solid #8a8ec382;border-radius:4px;padding:11px 16px;font-size:14px;line-height:1.55;font-weight:550;letter-spacing:.01em;white-space:normal;transition:background .16s,border-color .16s,box-shadow .16s}
.anima-modules .am-primary{color:#fbf9ff;background:linear-gradient(115deg,#203980,#372965);border-color:#afa8f5;box-shadow:inset 0 0 14px #6681e42b,0 0 14px #6983ff1c}
.anima-modules .am-primary:hover:not(:disabled){background:linear-gradient(115deg,#2c4c9a,#503986);border-color:#ddd6ff;box-shadow:0 0 20px #847cff3b}
.anima-modules .am-secondary{background:#131c35;color:#e6e3fc}
.anima-modules .am-secondary:hover:not(:disabled){background:#202b4b;border-color:#b5b6df}
.anima-modules .am-text-button{min-height:44px;padding:10px 3px;font-size:14px;line-height:1.5;color:#c4caf0;background:transparent;border:0;font-weight:500;text-underline-offset:5px}
.anima-modules .am-text-button:hover:not(:disabled){color:var(--am-cyan);text-decoration:underline}
.anima-modules .am-top-right .am-text-button{border:1px solid #a8a0da8c;border-radius:4px;padding:10px 16px}
.anima-modules .am-muted{font-size:14px;line-height:1.75;color:var(--am-muted);overflow-wrap:anywhere}
.anima-modules .am-identity>.am-muted{margin-top:13px}
.anima-modules .am-notice{margin-block:15px 22px;padding:12px 16px;min-height:46px;font-size:14px;color:#c7d5ef;border-left:2px solid #7ceaff8c;background:#18254445;border-radius:0 4px 4px 0}
.anima-modules .am-notice.am-error{color:#ffd0dc;border-left-color:#ffa9bc;background:#44203459}
.anima-modules .am-layout{display:grid;grid-template-columns:minmax(220px,.87fr) minmax(320px,1.35fr) minmax(275px,1fr);gap:22px;align-items:start}
.anima-modules .am-main{min-width:0}
.anima-modules .am-main>.am-section-heading{min-height:48px;margin-bottom:16px}
.anima-modules .am-main>.am-section-heading h2{font-size:19px}
.anima-modules .am-loom-panel{position:relative;overflow:hidden;border-color:#969ce78c;box-shadow:inset 0 0 36px #477cff12,0 0 24px #477cff0c;background:radial-gradient(ellipse at 45% 35%,#173e7130,transparent 65%),#080e1e}
.anima-modules .am-loom-heading{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;gap:10px;padding:19px 17px 0;flex-wrap:wrap}
.anima-modules .am-loom-heading .am-eyebrow{margin:0}
.anima-modules .am-loom-heading .am-small-badge{font-size:8px;padding:3px 5px}
.anima-modules .am-loom-stage{position:relative;aspect-ratio:1/1.2;min-height:300px}
.anima-modules .am-loom-canvas{display:block;position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.anima-modules .am-loom-axis{pointer-events:none;position:absolute;inset:10% 9%;border-top:1px solid #af9cff33;border-bottom:1px solid #af9cff33}
.anima-modules .am-loom-axis:before,.anima-modules .am-loom-axis:after{content:"";position:absolute;left:50%;width:1px;height:12px;background:#c8b9f180}
.anima-modules .am-loom-axis:before{top:-6px}.anima-modules .am-loom-axis:after{bottom:-6px}
.anima-modules .am-loom-caption{padding:0 22px 17px;position:relative}
.anima-modules .am-loom-caption h2{font-size:26px;line-height:1.35;letter-spacing:.015em;font-weight:350}
.anima-modules .am-loom-caption p{margin-top:14px;color:var(--am-muted);font-size:14px;line-height:1.8}
.anima-modules .am-loom-caption button{margin-top:8px;color:var(--am-cyan)}
.anima-modules .am-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2px;border:1px solid #8b88c787;border-radius:4px;padding:3px;margin-bottom:17px;background:#0a1023}
.anima-modules .am-tabs button{display:flex;gap:8px;align-items:center;justify-content:center;min-height:48px;background:transparent;border:1px solid transparent;border-radius:2px;color:#b5bedb;padding:10px 5px;font:14px/1.5 var(--am-mono);position:relative}
.anima-modules .am-tabs svg{width:18px;height:18px;flex:none}
.anima-modules .am-tabs button[aria-selected=true]{color:#fff;border-color:#c2b5ff;background:linear-gradient(120deg,#26387c99,#45367799);box-shadow:inset 0 0 12px #7d8ee329,0 0 13px #b49cff38}
.anima-modules .am-tabs button:hover:not([aria-selected=true]){background:#1a2444;color:#e8e5ff}
.anima-modules [role=tabpanel]{min-width:0;scroll-margin-top:20px}
.anima-modules .am-list{display:grid;gap:11px}
.anima-modules .am-empty{padding:22px 18px;border:1px dashed #7787bb65;border-radius:5px;font-size:14px;line-height:1.8;color:#bac2df;background:#0b1122}
.anima-modules .am-release{display:flex;gap:14px;align-items:center;width:100%;padding:18px;text-align:left;color:var(--am-ink);border:1px solid #677cb080;border-radius:5px;background:linear-gradient(120deg,#141e35,#0c1428);min-width:0}
.anima-modules .am-release>span:nth-child(2){min-width:0}
.anima-modules .am-release:hover,.anima-modules .am-release[aria-pressed=true]{border-color:#c2b5ff;background:#1a2141;box-shadow:inset 0 0 18px #6e78c418}
.anima-modules .am-release strong{display:block;font-size:15px;font-weight:550;overflow-wrap:anywhere}
.anima-modules .am-release small{display:block;font-size:14px;line-height:1.6;color:var(--am-muted);margin-top:5px;overflow-wrap:anywhere}
.anima-modules .am-release-icon{width:46px;height:52px;border-radius:4px;flex:none;display:grid;place-items:center;font-size:26px;color:#c8c0ff;background:radial-gradient(ellipse,#536ed73b,transparent 72%)}
.anima-modules .am-release-arrow{margin-left:auto;color:var(--am-cyan);font-size:20px}
.anima-modules .am-history-item{background:#101a31;border:1px solid #7186b76b;border-radius:4px;display:grid;grid-template-columns:auto minmax(0,1fr);gap:7px 16px;padding:16px;text-align:left;color:#d0d8f2;font-size:14px;min-width:0}
.anima-modules .am-history-item:hover,.anima-modules .am-history-item[aria-pressed=true]{border-color:#c2b5ff}
.anima-modules .am-history-item small{color:var(--am-muted);font-size:11px;overflow-wrap:anywhere}
.anima-modules .am-history-item strong{justify-self:end;font-size:14px}
.anima-modules .am-history-item code{text-align:right}
.anima-modules .am-example-section{margin-top:25px}
.anima-modules .am-example-section h3{font-size:18px}
.anima-modules .am-small-badge{display:inline-block;font:9px/1.5 var(--am-mono);letter-spacing:.055em;padding:5px 8px;border:1px solid #878ac278;border-radius:3px;color:#c5c8e5;overflow-wrap:anywhere}
.anima-modules .am-examples{display:grid;gap:12px}
.anima-modules .am-example{position:relative;padding:18px 18px 17px 126px;min-height:157px;border:1px solid #7988be75;border-radius:5px;overflow:hidden;display:flex;flex-direction:column;align-items:flex-start;text-align:left;color:var(--am-ink);background:linear-gradient(110deg,#17234480,#10162cf2 42%);transition:border-color .16s,box-shadow .16s}
.anima-modules .am-example:hover,.anima-modules .am-example[aria-pressed=true]{border-color:#b9b1f1;box-shadow:0 0 18px #9d87ff1a,inset 0 0 20px #727dec0a}
.anima-modules .am-example-art{position:absolute;left:9px;top:0;width:108px;height:100%;display:grid;place-items:center;pointer-events:none;background:radial-gradient(ellipse,#497ed02b,transparent 70%)}
.anima-modules .am-example-art svg{width:100%;height:auto;filter:drop-shadow(0 0 7px #6583e02b)}
.anima-modules .am-example-1 .am-example-art{background:radial-gradient(ellipse,#7d5bbc2b,transparent 70%)}
.anima-modules .am-example-2 .am-example-art{background:radial-gradient(ellipse,#a1519c24,transparent 70%)}
.anima-modules .am-example small{font:10px/1.6 var(--am-mono);color:#b8b8e5;margin-bottom:6px}
.anima-modules .am-example strong{font-size:17px;font-weight:500;letter-spacing:.005em}
.anima-modules .am-example>span:not(.am-example-art){font-size:14px;line-height:1.7;color:var(--am-muted);margin-top:8px}
.anima-modules .am-example b{margin-top:13px;font-size:14px;font-weight:500;color:#d3cbfa}
.anima-modules .am-example b span{margin-left:8px;color:var(--am-cyan)}
.anima-modules .am-example-section>.am-muted{margin-top:15px}
.anima-modules .am-inspector{padding:23px 20px;min-width:0;border-color:#aaa1db91;scroll-margin-top:20px}
.anima-modules .am-inspector h2{font-size:25px;margin-bottom:23px}
.anima-modules .am-form{display:grid;gap:16px}
.anima-modules .am-package{margin-top:23px;min-width:0}
.anima-modules .am-package .am-empty{padding:20px 14px;font-size:14px}
.anima-modules .am-package h3{margin-top:18px;overflow-wrap:anywhere}
.anima-modules dl{display:grid;grid-template-columns:82px minmax(0,1fr);gap:0;margin:20px 0;font-size:14px}
.anima-modules dt,.anima-modules dd{padding:10px 0;border-bottom:1px solid #8197c22b}
.anima-modules dt{color:#b5bcdb}
.anima-modules dd{margin:0;color:#e0dff5;overflow-wrap:anywhere;padding-left:10px}
.anima-modules .am-capabilities{display:flex;flex-wrap:wrap;gap:7px}
.anima-modules .am-capabilities span{font:12px/1.6 var(--am-mono);padding:5px 7px;border-radius:3px;border:1px solid #677cc663;background:#1a2543;color:#ced9fc;overflow-wrap:anywhere}
.anima-modules details{font-size:14px;color:var(--am-muted);margin-top:20px}
.anima-modules summary{cursor:pointer;color:#e0dbfb;font-size:14px;min-height:44px;line-height:1.65;padding-block:11px;touch-action:manipulation}
.anima-modules details ul{padding-left:18px;line-height:1.85}
.anima-modules .am-actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:18px}
.anima-modules .am-inspector>.am-actions{display:grid;gap:9px}
.anima-modules .am-inspector>.am-actions .am-text-button{text-align:left}
.anima-modules .am-state{padding-top:14px;border-top:1px solid #8294c85e}
.anima-modules .am-state>*:not(summary){margin-top:16px}
.anima-modules .am-check{display:flex;align-items:flex-start;gap:12px;line-height:1.75;letter-spacing:0;min-height:44px;padding-block:7px}
.anima-modules .am-check input{width:20px;height:20px;min-height:20px;flex:none;margin:1px 0 0;accent-color:#a99af2}
.anima-modules .am-file{font-size:14px}
.anima-modules .am-file input{padding:8px;font-size:14px}
.anima-modules input::file-selector-button{padding:8px 10px;background:#202c4e;border:1px solid #8794c3;border-radius:3px;color:var(--am-ink);margin-right:9px;font:inherit;cursor:pointer}
.anima-modules pre{max-height:350px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;text-align:left;font:14px/1.75 var(--am-mono);color:#d2def7;background:#070d1f;padding:15px;border:1px solid #8294c65e;border-radius:4px;tab-size:2}
.anima-modules .am-continuity{margin-top:26px;padding:23px 25px}
.anima-modules .am-continuity h2{font-size:22px}
.anima-modules .am-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;list-style:none;padding:0;margin:24px 0 0}
.anima-modules .am-steps li{display:flex;align-items:flex-start;gap:13px;position:relative}
.anima-modules .am-steps li>span{display:grid;place-items:center;flex:none;width:30px;height:30px;border:1px solid #a9a1e699;border-radius:50%;color:var(--am-cyan);font:10px var(--am-mono);box-shadow:0 0 13px #648dfa15}
.anima-modules .am-steps strong{font:14px/1.65 var(--am-mono);color:#e1dafa}
.anima-modules .am-steps p{margin-top:5px;font-size:14px;line-height:1.7;color:var(--am-muted)}
.anima-modules .am-runtime{margin-top:30px;padding:25px}
.anima-modules .am-runtime h2{font-size:25px}
.anima-modules .am-frame{margin-top:20px;min-height:520px}
.anima-modules .am-frame iframe{display:block;width:100%;height:650px;max-height:80vh;border:1px solid #8392c1;border-radius:5px;background:#071221}
.anima-modules .am-footer{margin-top:34px;padding:25px 0;display:flex;justify-content:space-between;gap:20px;border-top:1px solid #9494c957;font:10px/1.8 var(--am-mono);letter-spacing:.035em;color:#aab5d3}
.anima-modules .am-footer>span:first-child{color:#c5bbf4}
.anima-modules .am-review{width:min(800px,calc(100% - 32px));max-height:90vh;max-height:90dvh;overflow:auto;background:#0d1429;color:var(--am-ink);border:1px solid #a49bd6;border-radius:7px;padding:0;box-shadow:0 24px 120px #000c,0 0 30px #557ee124}
.anima-modules .am-review::backdrop{background:#030713dd;backdrop-filter:blur(7px)}
.anima-modules .am-review-body{padding:30px}
.anima-modules .am-review h2{margin-bottom:18px}
.anima-modules .am-review [data-node=review-summary]{font-size:14px;color:#c7d0e9;line-height:1.8}
.anima-modules .am-review pre{max-height:42vh;margin-top:22px}
.anima-modules .am-review .am-muted{margin-top:20px}
.anima-modules [data-panel=journal]>.am-card{padding:24px}
.anima-modules .am-journal-recovery>.am-form{margin-top:18px}
.anima-modules[aria-busy=true]{cursor:progress}
@media(min-width:1600px){.anima-modules .am-example{padding-left:144px}.anima-modules .am-example-art{width:125px}}
@media(max-width:1200px){
  .anima-modules .am-layout{grid-template-columns:minmax(0,1.4fr) minmax(290px,1fr)}
  .anima-modules .am-loom-panel{grid-column:1/-1;display:grid;grid-template-columns:1fr 260px 1fr;align-items:center;min-height:230px}
  .anima-modules .am-loom-heading{align-self:start;padding:24px;display:block}
  .anima-modules .am-loom-heading .am-small-badge{margin-top:13px}
  .anima-modules .am-loom-stage{min-height:220px;aspect-ratio:auto;height:240px}
  .anima-modules .am-loom-caption{padding:24px}
  .anima-modules .am-identity-form{grid-template-columns:minmax(70px,.6fr) minmax(170px,1.5fr) minmax(70px,.6fr) minmax(170px,1.5fr)}
  .anima-modules .am-identity-form .am-primary{grid-column:1/-1;justify-self:end;min-width:150px}
  .anima-modules .am-edition{font-size:10px;letter-spacing:.1em}
  .anima-modules .am-steps{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:820px){
  .anima-modules{padding:0 20px}
  .anima-modules .am-top{gap:15px;min-height:88px}
  .anima-modules .am-edition{display:none}
  .anima-modules .am-top-right{gap:10px}
  .anima-modules .am-brand{font-size:25px}
  .anima-modules .am-intro{align-items:flex-start;flex-direction:column;gap:18px;padding-block:28px}
  .anima-modules .am-intro p{max-width:600px}
  .anima-modules .am-layout{grid-template-columns:1fr;gap:23px}
  .anima-modules .am-loom-panel{grid-template-columns:1fr 1fr;min-height:245px}
  .anima-modules .am-loom-heading{position:absolute;top:0;left:0;right:0;display:flex;padding:17px}
  .anima-modules .am-loom-heading .am-small-badge{margin:0}
  .anima-modules .am-loom-stage{margin-top:35px;height:245px}
