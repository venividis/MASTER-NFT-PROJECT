ize:24px}
  .anima-modules .am-continuity{padding:21px 17px}
  .anima-modules .am-continuity .am-section-heading{display:grid;gap:16px}
  .anima-modules .am-steps{grid-template-columns:1fr;gap:19px;margin-top:22px}
  .anima-modules .am-steps li>span{width:32px;height:32px}
  .anima-modules .am-history-item{grid-template-columns:1fr;gap:7px}
  .anima-modules .am-history-item strong{justify-self:start}
  .anima-modules .am-history-item code{text-align:left}
  .anima-modules .am-runtime{padding:20px 14px}
  .anima-modules .am-runtime h2{font-size:21px}
  .anima-modules .am-frame iframe{height:640px}
  .anima-modules .am-footer{flex-direction:column;gap:8px;margin-top:27px}
  .anima-modules .am-review-body{padding:23px 18px}
  .anima-modules .am-review .am-actions{display:grid}
  .anima-modules [data-panel=journal]>.am-card{padding:21px 16px}
}
@media(prefers-reduced-motion:reduce){.anima-modules *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
@media(forced-colors:active){
  .anima-modules .am-tabs button[aria-selected=true]{border:2px solid Highlight}
  .anima-modules .am-card,.anima-modules .am-release,.anima-modules .am-example,.anima-modules .am-primary,.anima-modules .am-secondary{border:1px solid CanvasText}
  .anima-modules :focus-visible{outline:3px solid Highlight}
  .anima-modules .am-backdrop,.anima-modules .am-loom-axis{display:none}
}

/* Embedded workbenches size themselves to their host, even on wide browser windows. */
@container (max-width:1120px){
  .anima-modules .am-layout{grid-template-columns:minmax(0,1.35fr) minmax(275px,1fr)}
  .anima-modules .am-loom-panel{grid-column:1/-1;display:grid;grid-template-columns:1fr 250px 1fr;align-items:center}
  .anima-modules .am-loom-heading{position:static;display:block;align-self:start;padding:22px}
  .anima-modules .am-loom-heading .am-small-badge{margin-top:12px}
  .anima-modules .am-loom-stage{height:240px;aspect-ratio:auto;min-height:220px;margin-top:0}
  .anima-modules .am-loom-caption{padding:24px}
  .anima-modules .am-identity-form{grid-template-columns:minmax(70px,.65fr) minmax(130px,1.5fr) minmax(70px,.65fr) minmax(130px,1.5fr)}
  .anima-modules .am-identity-form .am-primary{grid-column:1/-1;justify-self:end;min-width:160px}
  .anima-modules .am-steps{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@container (max-width:760px){
  .anima-modules .am-layout{grid-template-columns:1fr}
  .anima-modules .am-loom-panel{grid-template-columns:1fr 1fr;position:relative}
  .anima-modules .am-loom-heading{position:absolute;top:0;left:0;right:0;display:flex;padding:17px}
  .anima-modules .am-loom-heading .am-small-badge{margin:0}
  .anima-modules .am-loom-stage{margin-top:35px;height:245px}
  .anima-modules .am-loom-caption{padding:50px 20px 16px 10px}
  .anima-modules .am-identity-form{grid-template-columns:1fr 1fr}
  .anima-modules .am-identity-form label:nth-child(2),.anima-modules .am-identity-form label:nth-child(4){grid-column:1/-1}
  .anima-modules .am-identity-form label:nth-child(3){grid-column:2;grid-row:1}
  .anima-modules .am-identity-form .am-primary{justify-self:stretch}
  .anima-modules .am-edition{display:none}
  .anima-modules .am-intro{flex-direction:column;align-items:flex-start;gap:18px}
}
@container (max-width:420px){
  .anima-modules .am-loom-panel{display:block}
  .anima-modules .am-loom-stage{height:265px}
  .anima-modules .am-loom-caption{padding:0 20px 14px}
  .anima-modules .am-steps{grid-template-columns:1fr}
  .anima-modules .am-continuity .am-section-heading{display:grid;gap:16px}
  .anima-modules .am-tabs button{flex-direction:column;gap:5px;font-size:12px;min-height:64px;padding:8px 2px}
  .anima-modules .am-tabs svg{width:17px;height:17px}
  .anima-modules .am-example{padding:16px 15px 16px 101px}
  .anima-modules .am-example-art{left:5px;width:88px}
}
/* Status, permission and navigation text are reading surfaces, not decorative microtype. */
.anima-modules .am-status-pill,.anima-modules .am-small-badge,
.anima-modules .am-capabilities span,.anima-modules .am-example small,
.anima-modules .am-history-item small,.anima-modules .am-history-item strong,
.anima-modules .am-tabs button,.anima-modules .am-example-section .am-small-badge{font-size:14px;letter-spacing:0}
.anima-modules .am-loom-heading .am-small-badge{font-size:11px}
@media(max-width:480px){
  .anima-modules .am-status-pill{padding:5px 7px}
  .anima-modules .am-example-section .am-section-heading{align-items:flex-start;flex-wrap:wrap}
}
