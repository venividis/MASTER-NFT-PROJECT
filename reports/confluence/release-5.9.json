  "scope": "Section 17 source implementations, browser integration, configured local services, unsigned deployment preparation and local verification; no public deployment.",
  "section17": {
    "count": 17,
    "features": [
      {
        "id": "F01",
        "capability": "Continuous clearing auction",
        "implemented": "Fund a streamed sale, leave a standing bid, advance uniform-price clearing, cancel and claim tokens or refunds.",
        "scope": "Independent bounded ANIMA mechanism, 64 orders; no Uniswap CCA compliance or automatic pool migration.",
        "guide": "docs/genesis/extensions/MARKETS.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F02",
        "capability": "Private agent-memory transfer",
        "implemented": "Publish encrypted memory, encrypt a handover for a recipient, let them decrypt and verify before atomic NFT acceptance, and recover accepted memory later.",
        "scope": "Back up encryption keys. Recipient-confirmed content, not ERC-7857/ZK handover; sender can retain old content.",
        "guide": "docs/genesis/extensions/PRIVACY.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F03",
        "capability": "Continuous live agent",
        "implemented": "Run a persistent operator against exact owner-approved calls, native budgets, call counts, waiting times and expiry. Revoke it or invalidate it by transferring custody.",
        "scope": "A scoped Bound-account operator; unrestricted adaptive decision-making and Sovereign-mode proof generation are outside this implementation.",
        "guide": "docs/genesis/extensions/AGENTS.md",
        "status": "implemented bounded scope; broader goal remains partial"
      },
      {
        "id": "F04",
        "capability": "Authenticated omnichain portal",
        "implemented": "Seal explicit LayerZero libraries/DVNs/executor, queue a custody-bound observation, quote delivery and dispatch it to the pinned peer.",
        "scope": "Requires real endpoints, both deployed peers and transport funding. Local tests use endpoint doubles. Remote witnesses grant no spending power.",
        "guide": "docs/genesis/extensions/PRIVACY.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F05",
        "capability": "Encrypted group chat",
        "implemented": "Invite and accept members, rotate complete encrypted epoch packages, send/decrypt ciphertext messages, remove members and restore backed-up identities.",
        "scope": "Custom WebCrypto protocol, not MLS or forward-secret. Membership/timing are public; old key holders retain old messages.",
        "guide": "docs/genesis/extensions/PRIVACY.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F06",
        "capability": "Public-goods matching",
        "implemented": "Fund a matching pot, attest bounded participant identities, contribute/withdraw, finalize quadratic matching and pay projects or recover unused funds.",
        "scope": "Frozen registrar and identity policy are explicit trust assumptions; Sybil identities/collusion are not cryptographically eliminated.",
        "guide": "docs/genesis/extensions/MARKETS.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F07",
        "capability": "Sponsored transactions",
        "implemented": "Grant a scoped relay session, exchange exact owner/sponsor signatures, submit as relayer and claim bounded gas reimbursement from a deposit.",
        "scope": "Native session relay, not ERC-4337. Failed authorized calls consume vouchers; fixed overhead and a signed cap can leave relayer costs uncovered.",
        "guide": "docs/genesis/extensions/ACCESS.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F08",
        "capability": "House",
        "implemented": "Open/fund real leveraged spot positions, sell and settle lender-first proceeds, repay debt, cancel unfilled offers or exit in kind after maturity plus grace.",
        "scope": "Test-network gate, real oracle/venue/liquidity required. Isolated spot leverage replaces the original pooled synthetic proposal.",
        "guide": "docs/genesis/extensions/EXPERIMENTAL.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F09",
        "capability": "Wager",
        "implemented": "Fund binary outcomes, sell or transfer funded sides, propose/challenge answers, arbitrate, finalize and refund missed-deadline markets.",
        "scope": "Named resolver/arbiter, immutable question/source/bonds/deadlines; fully funded claims and perpetual withdrawals.",
        "guide": "docs/genesis/extensions/EXPERIMENTAL.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F10",
        "capability": "Wake",
        "implemented": "Prepay a keeper lease, compensate takeover, settle fractional rent, run bounded tasks and use public fallback after a stall or expiry.",
        "scope": "Fixed task adapter and explicit test-network activation. Underlying permissionless exits remain public.",
        "guide": "docs/genesis/extensions/EXPERIMENTAL.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F11",
        "capability": "x402 / ERC-8183",
        "implemented": "Review and pay an exact supported HTTP x402 service; separately create/fund provider jobs, judge deliverables, pay or refund.",
        "scope": "Official x402 v2 exact EIP-3009 SDK path; separate non-hooked ERC-8183 draft kernel. Requires supported token, funded service wallet and configured provider.",
        "guide": "docs/genesis/extensions/AGENTS.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F12",
        "capability": "Provider discovery / reputation",
        "implemented": "Browse signed provider registrations, inspect metadata and compare job-attributed feedback; sign your own registration.",
        "scope": "ANIMA-native discovery, not an ERC-8004 registry. A signature authenticates a wallet, not a human or service-quality claim.",
        "guide": "docs/genesis/extensions/AGENTS.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F13",
        "capability": "Arbitrary generated instruments",
        "implemented": "Export a commission request, fund real escrow, inspect the provider’s exact HTML/JS and manifest, approve/reject, acquire frozen onchain code and run it in isolation.",
        "scope": "Hashing and human review do not certify safety. No default wallet bridge; exact proposals need a separate grant and transaction review.",
        "guide": "docs/genesis/extensions/WORLDS.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F14",
        "capability": "Cryptographically proved rehearsal",
        "implemented": "Generate a real Groth16 proof of one-hop NativeMarket fee/rounding/minimum/reserve math; check account/nonce/custody/current state before reviewing a swap.",
        "scope": "Development trusted setup only. Full EVM execution, token behavior, transfer success, gas and future state are not proved.",
        "guide": "docs/genesis/extensions/PROOF.md",
        "status": "implemented bounded scope; broader goal remains partial"
      },
      {
        "id": "F15",
        "capability": "Shared world / civilization",
        "implemented": "Join a persistent multiplayer server, explore, gather, craft, fight, found towns and trade with other clients; NFT transfer invalidates old sessions.",
        "scope": "Working civilization slice, not a finished mature MMORPG. Operator-authoritative game state; game coins have no onchain withdrawal.",
        "guide": "docs/genesis/extensions/WORLDS.md",
        "status": "implemented bounded scope; broader goal remains partial"
      },
      {
        "id": "F16",
        "capability": "ENS / domain mint entry",
        "implemented": "Create a personal mint slot, save its secret, commit an endowment, mint-and-name atomically, recover expired commitments and resolve a name into its NFT account.",
        "scope": "Requires a delegated ENS parent; deterministic anima-TOKEN_ID subname. Domain purchases/renewals and ancestor trust are separate.",
        "guide": "docs/genesis/extensions/ACCESS.md",
        "status": "implemented within stated scope"
      },
      {
        "id": "F17",
        "capability": "Whole-NFT fractional shares",
        "implemented": "Deposit an unused Bound NFT, transfer shares, make/vote on funded buyouts, withdraw proceeds or reunite all shares for whole-NFT redemption.",
        "scope": "Account execution freezes in custody. Private keys, previously granted external rights and universal offchain claims are not share backing.",
        "guide": "docs/genesis/extensions/MARKETS.md",
        "status": "implemented within stated scope"
      }
    ],
    "broaderGoalsStillPartial": [
      "F03",
      "F14",
      "F15"
    ],
    "deploymentGuide": "docs/genesis/extensions/DEPLOYMENT.md"
  },
