      "devdoc": {
        "details": "Deploy each leaf as an OnchainApp: its constructor verifies the leaf's full bytes.      SHA-256 leaf digests cannot establish the concatenated digest. This directory      pins that expected digest; readers MUST verify the complete recovered bytes      before execution. Supplied leaf implementations can deny retrieval, but cannot      make substituted content pass the pinned full digest. No mutable URL or owner.",
        "kind": "dev",
        "methods": {},
        "version": 1
      },
      "userdoc": {
        "kind": "user",
        "methods": {
          "readChunk(uint256)": {
            "notice": "Reads one <=23,000-byte part at the original flat archive index."
          }
        },
        "notice": "Immutable bounded directory retaining the original OnchainApp chunk-reader ABI.",
        "version": 1
      }
